+				e.customType = kSondeTouchEndMark;
+			_system->getEventManager()->pushEvent(e);
+			if (c == "ttap") {
+				Common::Event t;
+				t.mouse = Common::Point(x, y);
+				t.type = Common::EVENT_LBUTTONDOWN;
+				_system->getEventManager()->pushEvent(t);
+				t.type = Common::EVENT_LBUTTONUP;
+				_system->getEventManager()->pushEvent(t);
+			}
+			_remoteWait = 2;
+		} else if (c == "clickall") {
+			// Sonde Album : « clickall NOM » clique chaque élément NOM visible à sa position du moment (billes des cloportes)
+			Structural *roots[2] = {_runtime->getActiveMainScene().get(), _runtime->getActiveSharedScene().get()};
+			Common::Array<VisualElement *> cands;
+			for (Structural *root : roots)
+				if (root)
+					sondeCollectNamed(root, Common::String(arg), cands);
+			uint n = 0;
+			for (VisualElement *v : cands) {
+				Common::Point h(-1, -1);
+				sondeFindHitIn(v, h, _runtime.get());
+				if (h.x < 0 || h.y > 415)
+					continue;
+				_remoteQueue.insert_at(0, Common::String::format("click %d %d", h.x, h.y));
+				n++;
+			}
+			debug("remote: clickall %s -> %u", arg, n);
+		} else if (c == "waitx") {
+			// Sonde Album : « waitx NOM X [TOL] » bloque la file jusqu'à ce que le centre horizontal de NOM soit à X ± TOL
+			// (synchronisation sur l'état du jeu : supports qui défilent sur la mare) ; abandon après 6000 images
+			char nameBuf[128] = {0};
+			int tx = 0, tol = 3;
+			sscanf(arg, "%127s %d %d", nameBuf, &tx, &tol);
+			Structural *roots[2] = {_runtime->getActiveMainScene().get(), _runtime->getActiveSharedScene().get()};
+			Common::Array<VisualElement *> cands;
+			for (Structural *root : roots)
+				if (root)
+					sondeCollectNamed(root, Common::String(nameBuf), cands);
+			int cxv = -9999;
+			if (!cands.empty()) {
+				const Common::Rect &r = cands[0]->getRelativeRect();
+				cxv = cands[0]->getCachedAbsoluteOrigin().x + r.width() / 2;
+			}
+			if ((cxv - tx <= tol && tx - cxv <= tol) || ++_remoteWaitxFrames > 6000) {
+				debug("remote: waitx %s -> x=%d après %d images", arg, cxv, _remoteWaitxFrames);
+				_remoteWaitxFrames = 0;
+			} else {
+				_remoteQueue.insert_at(0, line);
+				break;
+			}
+		} else if (c == "clickon" || c == "moveon" || c == "grab") {
+			// Sonde Album : vise un pixel réellement dessiné de l'élément NOM (scène principale d'abord) au moment même
+			// « clickon NOM [X Y] » : avec X Y, l'homonyme dont le centre est le plus proche de (X,Y)
+			char nameBuf[128] = {0};
+			int rx = -1, ry = -1;
+			sscanf(arg, "%127s %d %d", nameBuf, &rx, &ry);
+			Common::String target(nameBuf);
+			Structural *roots[2] = {_runtime->getActiveMainScene().get(), _runtime->getActiveSharedScene().get()};
+			Common::Point hit(-1, -1);
+			if (rx >= 0) {
+				Common::Array<VisualElement *> cands;
+				for (Structural *root : roots)
+					if (root)
+						sondeCollectNamed(root, target, cands);
+				int64 best = INT64_MAX;
+				for (VisualElement *v : cands) {
+					Common::Point h(-1, -1);
+					sondeFindHitIn(v, h, _runtime.get());
+					if (h.x < 0)
+						continue;
+					int64 d = (int64)(h.x - rx) * (h.x - rx) + (int64)(h.y - ry) * (h.y - ry);
+					if (d < best) {
+						best = d;
+						hit = h;
+					}
+				}
+			} else {
+				Common::Array<VisualElement *> cands;
+				for (Structural *root : roots)
+					if (root)
+						sondeCollectNamed(root, target, cands);
+				for (VisualElement *v : cands)
+					if (hit.x < 0)
+						sondeFindHitIn(v, hit, _runtime.get());
+			}
+			debug("remote: %s %s -> (%d,%d)", cmd, arg, hit.x, hit.y);
+			if (hit.x >= 0) {
+				sondeWarpMouse(_system, hit.x, hit.y);
+				_runtime->onMouseMove(hit.x, hit.y);
+				if (c == "clickon" || c == "grab") {
+					_runtime->onMouseDown(hit.x, hit.y, MTropolis::Actions::kMouseButtonLeft);
+					if (c == "clickon")
+						_remoteQueue.insert_at(0, Common::String::format("up %d %d", hit.x, hit.y));
+					_remoteWait = 3;
+				}
+			}
+		} else if (c == "ilist") {
+			// Sonde Album : éléments visibles et interactifs des scènes actives, avec rectangle écran
+			Common::DumpFile f;
+			if (f.open(Common::FSNode(Common::Path(arg)))) {
+				Structural *roots[2] = {_runtime->getActiveSharedScene().get(), _runtime->getActiveMainScene().get()};
+				for (int ri = 0; ri < 2; ri++)
+					if (roots[ri])
+						sondeListInteractive(f, roots[ri], ri);
+			}
+			debug("remote: ilist %s", arg);
+		} else if (c == "goto") {
+			Common::SharedPtr<Structural> found = sondeFindScene(_runtime->getProject(), Common::String(arg));
+			if (found) {
+				_runtime->addSceneStateTransition(HighLevelSceneTransition(found, HighLevelSceneTransition::kTypeChangeToScene, false, false));
+				debug("remote: goto %s OK", arg);
+			} else
+				debug("remote: goto %s not found", arg);
+		} else if (c == "loadscene") {
+			// Sonde Album : « sous-section/scène » pour viser une scène homonyme (ex. objets/totem)
+			Common::String sa(arg);
+			Structural *base = _runtime->getProject();
+			size_t slash = sa.findFirstOf('/');
+			if (slash != Common::String::npos) {
+				Common::String sub = sa.substr(0, slash);
+				sa = sa.substr(slash + 1);
+				for (const Common::SharedPtr<Structural> &sec : base->getChildren())
+					for (const Common::SharedPtr<Structural> &ss : sec->getChildren())
+						if (ss->getName() == sub)
+							base = ss.get();
+			}
+			Common::SharedPtr<Structural> found = sondeFindScene(base, sa);
+			if (found) {
+				_runtime->loadScene(found);
+				debug("remote: loadscene %s OK", arg);
+			} else
+				debug("remote: loadscene %s not found", arg);
+		} else if (c == "pick") {
+			Structural *roots[2] = {_runtime->getActiveSharedScene().get(), _runtime->getActiveMainScene().get()};
+			for (Structural *root : roots)
+				if (root)
+					sondePick(root, x, y, x, y);
+		} else if (c == "cel") {
+			char nameBuf[128] = {0};
+			int v = 0;
+			sscanf(arg, "%127s %d", nameBuf, &v);
+			Structural *roots[2] = {_runtime->getActiveSharedScene().get(), _runtime->getActiveMainScene().get()};
+			for (Structural *root : roots)
+				if (root)
+					sondeSetCelByName(root, nameBuf, v);
+			_runtime->setSceneGraphDirty();
+		} else if (c == "rotset") {
+			// Sonde Album : « rotset NOM DEGRÉS » pose l'angle des Rotators de l'élément NOM (tests de rendu)
+			char nameBuf[64] = {0};
+			double deg = 0;
+			sscanf(arg, "%63s %lf", nameBuf, &deg);
+			Structural *roots[2] = {_runtime->getActiveMainScene().get(), _runtime->getActiveSharedScene().get()};
+			Common::Array<VisualElement *> cands;
+			for (Structural *root : roots)
+				if (root)
+					sondeCollectNamed(root, Common::String(nameBuf), cands);
+			int n = 0;
+			for (VisualElement *v : cands)
+				n += sondeRotSetIn(_runtime.get(), v, deg);
+			_runtime->setSceneGraphDirty();
+			debug("remote: rotset %s %g (%d rotators)", nameBuf, deg, n);
+		} else if (c == "vis") {
+			char nameBuf[128] = {0};
+			int v = 0;
+			sscanf(arg, "%127s %d", nameBuf, &v);
+			Structural *roots[2] = {_runtime->getActiveSharedScene().get(), _runtime->getActiveMainScene().get()};
+			int count = 0;
+			for (Structural *root : roots)
+				if (root)
+					count += sondeSetVisible(_runtime.get(), root, nameBuf, v != 0);
+			_runtime->setSceneGraphDirty();
+			debug("remote: vis %s %d (%d elements)", nameBuf, v, count);
+		} else if (c == "tree") {
+			Common::DumpFile f;
+			if (f.open(Common::FSNode(Common::Path(arg)))) {
+				if (Common::String(arg).hasSuffix("-all.txt")) {
+					dumpTree(f, _runtime->getProject(), 0);
+				} else {
+					Structural *roots[2] = {_runtime->getActiveSharedScene().get(), _runtime->getActiveMainScene().get()};
+					for (Structural *root : roots)
+						if (root)
+							dumpTree(f, root, 0);
+				}
+			}
+			debug("remote: tree %s", arg);
+		} else if (c == "shot") {
+			Graphics::Surface *scr = _system->lockScreen();
+			Common::DumpFile f;
+			if (scr && f.open(Common::FSNode(Common::Path(arg)))) {
+				if (Common::String(arg).hasSuffix(".bmp")) {
+					// BMP : disponible partout (le PNG n'est pas compilé dans la version iOS)
+					byte pal[256 * 3];
+					if (scr->format.bytesPerPixel == 1)
+						_system->getPaletteManager()->grabPalette(pal, 0, 256);
+					Graphics::Surface *conv = scr->convertTo(Graphics::PixelFormat(3, 8, 8, 8, 0, 16, 8, 0, 0), scr->format.bytesPerPixel == 1 ? pal : nullptr);
+					Image::writeBMP(f, *conv);
+					conv->free();
+					delete conv;
+				} else if (scr->format.bytesPerPixel == 1) {
+					byte pal[256 * 3];
+					_system->getPaletteManager()->grabPalette(pal, 0, 256);
+					Image::writePNG(f, *scr, pal, 256);
+				} else {
+					Graphics::Surface *conv = scr->convertTo(Graphics::PixelFormat(3, 8, 8, 8, 0, 16, 8, 0, 0));
+					Image::writePNG(f, *conv);
+					conv->free();
+					delete conv;
+				}
+			}
+			_system->unlockScreen();
+			debug("remote: shot %s", arg);
+		}
+	}
+}
