+
+void TextLabelElement::sondeUpdateCalculated() {
+	debug(1, "calculated '%s': text='%s' isBitmap=%d haveTemplate=%d", getName().c_str(), _text.c_str(), (int)_isBitmap, (int)_sondeHaveTemplate);
+	if (!_sondeHaveTemplate) {
+		_sondeTemplate = _text;
+		_sondeHaveTemplate = true;
+	}
+	if (_sondeTemplate.find('<') == Common::String::npos)
+		return;
+
+	Common::String out;
+	uint i = 0;
+	while (i < _sondeTemplate.size()) {
+		char ch = _sondeTemplate[i];
+		size_t close = (ch == '<') ? _sondeTemplate.find('>', i + 1) : Common::String::npos;
+		if (ch == '<' && close != Common::String::npos) {
+			Common::String name = _sondeTemplate.substr(i + 1, close - i - 1);
+			Modifier *var = nullptr;
+			for (Structural *st = this; st && !var; st = st->getParent())
+				var = sondeFindVarInContainer(st->getModifiers(), name);
+			debug(1, "calculated '%s': tag <%s> -> %s (mods %u)", getName().c_str(), name.c_str(), var ? "trouvée" : "absente", (unsigned)getModifiers().size());
+			if (var) {
+				DynamicValue v;
+				static_cast<VariableModifier *>(var)->varGetValue(v);
+				debug(1, "   valeur type %d", (int)v.getType());
+				switch (v.getType()) {
+				case DynamicValueTypes::kString: out += v.getString(); break;
+				case DynamicValueTypes::kInteger: out += Common::String::format("%d", v.getInt()); break;
+				case DynamicValueTypes::kFloat: out += Common::String::format("%g", v.getFloat()); break;
+				case DynamicValueTypes::kBoolean: out += v.getBool() ? "true" : "false"; break;
+				default: break;
+				}
+				i = close + 1;
+				continue;
+			}
+		}
+		out += ch;
+		i++;
+	}
+	debug(1, "calculated '%s' -> '%s'", getName().c_str(), out.c_str());
+	if (out != _text)
+		sondeSetText(out);
+}
