+// Sonde Album : cherche une variable entière de nom donné dans les modificateurs d'un élément (comportements compris)
+static bool sondeFindIntVar(IModifierContainer *c, const Common::String &name, int32 &out) {
+	if (!c)
+		return false;
+	for (const Common::SharedPtr<Modifier> &m : c->getModifiers()) {
+		if (m->getName() == name && m->isVariable()) {
+			DynamicValue dv;
+			static_cast<VariableModifier *>(m.get())->varGetValue(dv);
+			if (dv.getType() == DynamicValueTypes::kInteger) {
+				out = dv.getInt();
+				return true;
+			}
+		}
+		if (sondeFindIntVar(m->getChildContainer(), name, out))
+			return true;
+	}
+	return false;
+}
+
+static void sondeCollectNamed(Structural *s, const Common::String &name, Common::Array<VisualElement *> &out) {
+	if (s->isElement() && static_cast<Element *>(s)->isVisual()) {
+		VisualElement *v = static_cast<VisualElement *>(s);
+		if (!v->isVisible())
+			return;
+		size_t slash = name.find('/');
+		if (slash == Common::String::npos ? s->getName() == name
+			: (s->getName() == name.substr(slash + 1) && s->getParent() && s->getParent()->getName() == name.substr(0, slash)))
+			out.push_back(v);
+	}
+	for (const Common::SharedPtr<Structural> &child : s->getChildren())
+		sondeCollectNamed(child.get(), name, out);
+}
+
+static void sondeFindHit(Structural *s, const Common::String &name, Common::Point &hit, Runtime *rt) {
+	if (hit.x >= 0)
+		return;
+	if (s->isElement() && static_cast<Element *>(s)->isVisual()) {
+		VisualElement *v = static_cast<VisualElement *>(s);
+		if (!v->isVisible())
+			return;
+		if (s->getName() == name) {
+			sondeFindHitIn(v, hit, rt);
+			return;
+		}
+	}
+	for (const Common::SharedPtr<Structural> &child : s->getChildren())
+		sondeFindHit(child.get(), name, hit, rt);
+}
+
+static void sondeListInteractive(Common::WriteStream &out, Structural *s, int sceneIndex) {
+	if (s->isElement() && static_cast<Element *>(s)->isVisual()) {
+		VisualElement *v = static_cast<VisualElement *>(s);
+		if (!v->isVisible())
+			return;	// ni lui ni ses enfants ne sont cliquables
+		if (Runtime::isStructuralMouseInteractive(v, kMouseInteractivityTestAnything)) {
+			const Common::Point &o = v->getCachedAbsoluteOrigin();
+			const Common::Rect &r = v->getRelativeRect();
+			out.writeString(Common::String::format("%d\t%s\t%x\t%d\t%d\t%d\t%d\t%d\t%d\n", sceneIndex, s->getName().c_str(), s->getStaticGUID(),
+				o.x, o.y, r.width(), r.height(), v->getLayer(), v->getDragMotionProperties() ? 1 : 0));
+		}
+	}
+	for (const Common::SharedPtr<Structural> &child : s->getChildren())
+		sondeListInteractive(out, child.get(), sceneIndex);
+}
+
+static void sondePick(Structural *s, int32 rx, int32 ry, int32 gx, int32 gy) {
+	int32 crx = rx, cry = ry;
+	if (s->isElement() && static_cast<Element *>(s)->isVisual()) {
+		VisualElement *v = static_cast<VisualElement *>(s);
+		bool inside = v->isMouseInsideDrawableArea(rx, ry);
+		if (inside)
+			debug("pick (%d,%d): '%s' #%x vis=%d layer=%d interactive=%d collision=%d", gx, gy, s->getName().c_str(), s->getStaticGUID(), v->isVisible() ? 1 : 0, v->getLayer(),
+				Runtime::isStructuralMouseInteractive(v, kMouseInteractivityTestAnything) ? 1 : 0, v->isMouseCollisionAtPoint(rx, ry) ? 1 : 0);
+		crx -= v->getRelativeRect().left;
+		cry -= v->getRelativeRect().top;
 	}
+	for (const Common::SharedPtr<Structural> &child : s->getChildren())
+		sondePick(child.get(), crx, cry, gx, gy);
 }
 
+// Sonde Album : « cel NOM N » sur tous les mToon NOM
+static int sondeSetCelByName(Structural *s, const char *name, int cel) {
+	int n = 0;
+	if (s->getName() == name && s->isElement() && static_cast<Element *>(s)->isVisual()) {
+		MToonElement *m = dynamic_cast<MToonElement *>(s);
+		if (m)
+			debug("remote: cel %s %d / %d", name, cel, (int)m->sondeSetCel(cel)), n++;
+	}
+	for (const Common::SharedPtr<Structural> &child : s->getChildren())
+		n += sondeSetCelByName(child.get(), name, cel);
+	return n;
+}
+
+static int sondeSetVisible(Runtime *rt, Structural *s, const char *name, bool visible) {
+	int n = 0;
+	if (s->getName() == name && s->isElement() && static_cast<Element *>(s)->isVisual()) {
+		static_cast<VisualElement *>(s)->setVisible(rt, visible);
+		n++;
+	}
+	for (const Common::SharedPtr<Structural> &child : s->getChildren())
+		n += sondeSetVisible(rt, child.get(), name, visible);
+	return n;
+}
