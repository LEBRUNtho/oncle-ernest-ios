+// Sonde Album : marque-pages du livre = mToon « pNN » enfants de zone_post_it (scène partagée), par numéro de page (num_post)
+void MTropolisEngine::sondeCollectTabs(Common::Array<MToonElement *> &out) {
+	out.clear();
+	const Common::SharedPtr<Structural> &shared = _runtime->getActiveSharedScene();
+	if (!shared)
+		return;
+	Structural *zone = sondeFindDescendant(shared.get(), "zone_post_it");
+	if (!zone)
+		return;
+	for (const Common::SharedPtr<Structural> &c : zone->getChildren()) {
+		const Common::String &n = c->getName();
+		if (n.size() >= 2 && n.size() <= 3 && n[0] == 'p' && Common::isDigit(n[1]) && (n.size() == 2 || Common::isDigit(n[2])))
+			if (MToonElement *m = dynamic_cast<MToonElement *>(c.get()))
+				out.push_back(m);
+	}
+	Common::sort(out.begin(), out.end(), [](MToonElement *a, MToonElement *b) { return sondeVarInt(a, "num_post") < sondeVarInt(b, "num_post"); });
+}
