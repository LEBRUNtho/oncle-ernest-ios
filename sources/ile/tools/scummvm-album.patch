+static void sondeCollectPrefix(Structural *s, const Common::String &pre, Common::Array<VisualElement *> &out) {
+	if (s->isElement() && static_cast<Element *>(s)->isVisual() && s->getName().hasPrefix(pre) && static_cast<VisualElement *>(s)->isVisible())
+		out.push_back(static_cast<VisualElement *>(s));
+	for (const Common::SharedPtr<Structural> &child : s->getChildren())
+		sondeCollectPrefix(child.get(), pre, out);
+}
