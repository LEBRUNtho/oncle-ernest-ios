 VThreadState ImportBitmapModifier::consumeMessage(Runtime *runtime, const Common::SharedPtr<MessageProperties> &msg) {
+	sondeLog("import", msg);
+	Common::String path;
+	BitmapVariableModifier *var = nullptr;
+	if (!sondeFindPathAndBitmap(resolveRef(0), resolveRef(1), path, var)) {
