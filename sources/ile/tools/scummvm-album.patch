+// (« axisoffset », ex. (-37,0) = bout gauche d'une planche de 76 px). Le pivot reste au centre de l'élément : le centre de
+// l'image est donc déplacé de -axe tourné du même angle que le dessin (sens trigo à l'écran, y vers le bas).
+static Common::Rect sondeShiftForAxis(const Common::Rect &r, const Common::Point &axis, double degrees) {
+	if (axis.x == 0 && axis.y == 0)
+		return r;
+	const double rad = degrees * M_PI / 180.0, c = cos(rad), sn = sin(rad);
+	const double vx = -axis.x, vy = -axis.y;
+	Common::Rect out = r;
+	out.translate((int16)floor(c * vx + sn * vy + 0.5), (int16)floor(-sn * vx + c * vy + 0.5));
+	return out;
