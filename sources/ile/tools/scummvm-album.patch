+// Sonde Album : image « cel » de l'animation en RGBA (toile = rectangle de l'animation), même détourage que le dessin
+bool MToonElement::sondeRenderCelRGBA(int32 cel, Graphics::Surface &out) {
+	if (!_cachedMToon || !_metadata || cel < 1 || cel > (int32)_metadata->frames.size())
+		return false;
+	_cachedMToon->optimize(getRuntime());
+	const uint32 frame = cel - 1;
+	Common::SharedPtr<Graphics::ManagedSurface> surf;
+	_cachedMToon->getOrRenderFrame(0, frame, surf);
+	if (!surf)
+		return false;
+	const Common::Rect frameRect = _metadata->frames[frame].rect;
+	Common::Rect src = (frameRect.width() == surf->w && frameRect.height() == surf->h) ? Common::Rect(0, 0, surf->w, surf->h) : frameRect;
+	src.clip(Common::Rect(0, 0, surf->w, surf->h));
+	const int32 nw = _metadata->rect.width(), nh = _metadata->rect.height();
+	if (src.isEmpty() || nw <= 0 || nh <= 0)
+		return false;
+	const byte *pal = nullptr;
+	if (surf->format.bytesPerPixel == 1) {
+		const Palette *palette = getPalette().get();
+		if (!palette)
+			palette = &getRuntime()->getGlobalPalette();
+		pal = palette->getPalette();
+	}
+	const VisualElementRenderProperties::InkMode ink = _renderProps.getInkMode();
+	const bool keyed = (ink == VisualElementRenderProperties::kInkModeBackgroundMatte || ink == VisualElementRenderProperties::kInkModeBackgroundTransparent);
+	const ColorRGB8 key = _renderProps.getBackColor();
+	out.create(nw, nh, Graphics::PixelFormat::createFormatRGBA32());
+	out.fillRect(Common::Rect(0, 0, nw, nh), 0);
+	for (int y = 0; y < src.height(); y++) {
+		const int dy = frameRect.top + y;
+		if (dy < 0 || dy >= nh)
+			continue;
+		for (int x = 0; x < src.width(); x++) {
+			const int dx = frameRect.left + x;
+			if (dx < 0 || dx >= nw)
+				continue;
+			const void *p = surf->getBasePtr(src.left + x, src.top + y);
+			byte r, g, b;
+			if (pal) {
+				const byte idx = *(const byte *)p;
+				r = pal[idx * 3];
+				g = pal[idx * 3 + 1];
+				b = pal[idx * 3 + 2];
+			} else {
+				const uint32 c = (surf->format.bytesPerPixel == 2) ? *(const uint16 *)p : *(const uint32 *)p;
+				surf->format.colorToRGB(c, r, g, b);
+			}
+			const bool transparent = keyed && (ColorRGB8(r, g, b) == key);
+			*(uint32 *)out.getBasePtr(dx, dy) = out.format.ARGBToColor(transparent ? 0 : 255, r, g, b);
+		}
+	}
+	return true;
+}
