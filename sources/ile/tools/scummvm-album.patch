+// Sonde Album : la télécommande ne déplace le VRAI curseur que si « sonde_warp=true » (sinon le jeu, piloté en arrière-plan,
+// prendrait la souris du mainteneur pendant qu'il utilise le Mac) ; le moteur reçoit de toute façon onMouseMove.
+static void sondeWarpMouse(OSystem *sys, int x, int y) {
+	if (ConfMan.hasKey("sonde_warp") && ConfMan.getBool("sonde_warp"))
+		sys->warpMouse(x, y);
+}
