+
+bool BehaviorModifier::readAttribute(MiniscriptThread *thread, DynamicValue &result, const Common::String &attrib) {
+	if (Modifier::readAttribute(thread, result, attrib))
+		return true;
+	Modifier *child = sondeFindChild(attrib);
+	if (child && child->isVariable()) {
+		static_cast<VariableModifier *>(child)->varGetValue(result);
+		return true;
+	}
+	if (child) {
+		result.setObject(child->getSelfReference());
+		return true;
+	}
+	// Sonde Album : attribut inconnu du comportement → celui de son élément (une référence « parent de l'expéditeur » peut
+	// désigner le comportement depuis le 26/09, les scripts du jeu 1 y lisent des attributs d'élément : visible, position…)
+	if (Structural *owner = findStructuralOwner())
+		return owner->readAttribute(thread, result, attrib);
+	return false;
+}
+
+bool BehaviorModifier::readAttributeIndexed(MiniscriptThread *thread, DynamicValue &result, const Common::String &attrib, const DynamicValue &index) {
+	Modifier *child = sondeFindChild(attrib);
+	if (child && child->isVariable())
+		return child->readAttributeIndexed(thread, result, "value", index);
+	return Modifier::readAttributeIndexed(thread, result, attrib, index);
+}
+
+MiniscriptInstructionOutcome BehaviorModifier::writeRefAttribute(MiniscriptThread *thread, DynamicValueWriteProxy &writeProxy, const Common::String &attrib) {
+	MiniscriptInstructionOutcome outcome = Modifier::writeRefAttribute(thread, writeProxy, attrib);
+	if (outcome != kMiniscriptInstructionOutcomeFailed)
+		return outcome;
+	Modifier *child = sondeFindChild(attrib);
+	if (child && child->isVariable()) {
+		writeProxy = static_cast<VariableModifier *>(child)->createWriteProxy();
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+	if (child) {
+		// Sous-comportement ou autre modificateur : référence d'objet, pour les écritures en chaîne (demarre.tourne.v_speed_rot)
+		DynamicValueWriteObjectHelper::create(child, writeProxy);
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+	if (Structural *owner = findStructuralOwner())	// Sonde Album : voir readAttribute
+		return owner->writeRefAttribute(thread, writeProxy, attrib);
+	return kMiniscriptInstructionOutcomeFailed;
+}
+
+MiniscriptInstructionOutcome BehaviorModifier::writeRefAttributeIndexed(MiniscriptThread *thread, DynamicValueWriteProxy &writeProxy, const Common::String &attrib, const DynamicValue &index) {
+	Modifier *child = sondeFindChild(attrib);
+	if (child && child->isVariable())
+		return child->writeRefAttributeIndexed(thread, writeProxy, "value", index);
+	return Modifier::writeRefAttributeIndexed(thread, writeProxy, attrib, index);
+}
