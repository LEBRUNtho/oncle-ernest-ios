+MiniscriptInstructionOutcome ListVariableModifier::sondeInsert(MiniscriptThread *thread, size_t realIndex, const DynamicValue &value) {
+	ListVariableStorage *storage = static_cast<ListVariableStorage *>(_storage.get());
+	Common::SharedPtr<DynamicList> &list = storage->_list;
+
+	DynamicValue converted;
+	if (!value.convertToType(storage->_preferredContentType == DynamicValueTypes::kInvalid ? value.getType() : storage->_preferredContentType, converted))
+		converted = value;
+
+	size_t size = list->getSize();
+	if (realIndex >= size)
+		return list->setAtIndex(realIndex, converted) ? kMiniscriptInstructionOutcomeContinue : kMiniscriptInstructionOutcomeFailed;
+
+	DynamicValue moved;
+	for (size_t i = size; i > realIndex; i--) {
+		list->getAtIndex(i - 1, moved);
+		if (!list->setAtIndex(i, moved))
+			return kMiniscriptInstructionOutcomeFailed;
+	}
+	return list->setAtIndex(realIndex, converted) ? kMiniscriptInstructionOutcomeContinue : kMiniscriptInstructionOutcomeFailed;
+}
