+// Sonde Album : couleur du pixel en haut à gauche (couleur de détourage du Rotator)
+static ColorRGB8 sondeCornerColor(const Graphics::ManagedSurface &src, const Common::Rect &srcRect) {
+	uint32 px = src.getPixel(srcRect.left, srcRect.top);
+	uint8 a = 255, r = 0, g = 0, b = 0;
+	if (src.format.bytesPerPixel == 1) {
+		byte pal[256 * 3];
+		const_cast<Graphics::ManagedSurface &>(src).grabPalette(pal, 0, 256);
+		r = pal[px * 3 + 0];
+		g = pal[px * 3 + 1];
+		b = pal[px * 3 + 2];
+	} else
+		src.format.colorToARGB(px, a, r, g, b);
+	return ColorRGB8(r, g, b);
+}
