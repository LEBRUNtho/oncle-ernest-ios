+// Sonde Album : grande vidéo (≥ 320×240) seule dans sa scène : les autres éléments visibles sont des fonds plein écran
+static bool sondeOnlyBackgrounds(Structural *s, Structural *movie) {
+	for (const Common::SharedPtr<Structural> &child : s->getChildren()) {
+		Structural *c = child.get();
+		if (c == movie || !c->isElement() || !static_cast<Element *>(c)->isVisual())
+			continue;
+		VisualElement *v = static_cast<VisualElement *>(c);
+		if (!v->isVisible())
+			continue;
+		const Common::Rect &r = v->getRelativeRect();
+		if ((int32)r.width() * r.height() < 640 * 480 * 9 / 10)
+			return false;
+		if (!sondeOnlyBackgrounds(c, movie))
+			return false;
+	}
+	return true;
+}
+
+bool MovieElement::sondeIsLoneMovie() {
+	if (_rect.width() < 320 || _rect.height() < 240)
+		return false;
+	Structural *scene = this;
+	while (scene->getParent() && scene->getParent()->isElement())
+		scene = scene->getParent();
+	return scene != this && sondeOnlyBackgrounds(scene, this);
+}
