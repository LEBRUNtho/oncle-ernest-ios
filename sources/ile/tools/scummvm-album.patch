 void FadeModifier::disable(Runtime *runtime) {
+	if (_scheduledEvent) {
+		_scheduledEvent->cancel();
+		_scheduledEvent.reset();
+	}
+}
+
+bool FadeModifier::respondsToEvent(const Event &evt) const {
+	return _startWhen.respondsTo(evt) || _stopWhen.respondsTo(evt);
+}
+
+VThreadState FadeModifier::consumeMessage(Runtime *runtime, const Common::SharedPtr<MessageProperties> &msg) {
+	if (_stopWhen.respondsTo(msg->getEvent()) && !_startWhen.respondsTo(msg->getEvent())) {
+		disable(runtime);
+		return kVThreadReturn;
+	}
+	Structural *owner = findStructuralOwner();
+	SoundElement *snd = owner ? dynamic_cast<SoundElement *>(owner) : nullptr;
+	if (!snd)
+		return kVThreadReturn;
+	disable(runtime);
+	_fromVol = snd->sondeGetVolume();
+	_fadeStart = runtime->getPlayTime();
+	debug(1, "fade '%s' on '%s': %d -> %d in %d ticks", getName().c_str(), snd->getName().c_str(), _fromVol, _target, _durationTicks);
+	_scheduledEvent = runtime->getScheduler().scheduleMethod<FadeModifier, &FadeModifier::runFade>(_fadeStart + 1, this);
+	return kVThreadReturn;
+}
+
+void FadeModifier::runFade(Runtime *runtime) {
+	_scheduledEvent.reset();
+	Structural *owner = findStructuralOwner();
+	SoundElement *snd = owner ? dynamic_cast<SoundElement *>(owner) : nullptr;
+	if (!snd)
+		return;
+	uint64 durMs = (uint64)MAX<int32>(_durationTicks, 1) * 1000 / 60;
+	uint64 el = runtime->getPlayTime() - _fadeStart;
+	int32 target = CLIP<int32>(_target, 0, 100);
+	if (el >= durMs) {
+		snd->setVolume(target);
+		return;
+	}
+	snd->setVolume((uint16)(_fromVol + (target - _fromVol) * (int64)el / (int64)durMs));
+	_scheduledEvent = runtime->getScheduler().scheduleMethod<FadeModifier, &FadeModifier::runFade>(runtime->getPlayTime() + 30, this);
 }
 
