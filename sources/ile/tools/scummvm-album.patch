+// Sonde Album : changement d'animation à la volée (utilisé par Init_cloner)
+MiniscriptInstructionOutcome MToonElement::scriptSetAsset(MiniscriptThread *thread, const DynamicValue &value) {
+	DynamicValue derefValue = value.dereference();
+	Project *project = thread->getRuntime()->getProject();
+
+	uint32 assetID = 0;
+	if (derefValue.getType() == DynamicValueTypes::kString) {
+		if (!project->getAssetIDByName(derefValue.getString(), assetID)) {
+			warning("mToon element references asset '%s' but the asset ID couldn't be resolved", derefValue.getString().c_str());
+			return kMiniscriptInstructionOutcomeFailed;
+		}
+	} else if (derefValue.getType() == DynamicValueTypes::kInteger) {
+		assetID = derefValue.getInt();
+	} else {
+		thread->error(Common::String::format("Tried to set an mToon's asset to a value of type %i", (int)derefValue.getType()));
+		return kMiniscriptInstructionOutcomeFailed;
+	}
+
+	Common::SharedPtr<Asset> asset = project->getAssetByID(assetID).lock();
+	if (!asset) {
+		Common::Array<Common::SharedPtr<Asset> > forceLoadedAssets;
+		project->forceLoadAsset(assetID, forceLoadedAssets);
+		asset = project->getAssetByID(assetID).lock();
+	}
+	if (!asset || asset->getAssetType() != kAssetTypeMToon) {
+		warning("mToon element assigned asset %u which isn't a loaded mToon", assetID);
+		return kMiniscriptInstructionOutcomeFailed;
+	}
+
+	uint hackFlags = 0;
+	_assetID = assetID;
+	_cachedMToon = static_cast<MToonAsset *>(asset.get())->loadAndCacheMToon(getRuntime(), hackFlags);
+	_metadata = _cachedMToon->getMetadata();
+	_playRange = IntRange(1, _metadata->frames.size());
+	if (_cel < 1 || _cel > _metadata->frames.size())
+		_cel = 1;
+	_renderSurface.reset();
+	_renderedFrame = 0;
+	_contentsDirty = true;
+	return kMiniscriptInstructionOutcomeContinue;
