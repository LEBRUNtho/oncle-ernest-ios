@@ -74,6 +74,12 @@ VThreadState VThread::step() {
 		VThreadStackFrame *frame = _stackChunks[_numActiveStackChunks - 1]._topFrame;
 
 		VThreadState state = frame->data->execute(this);
+		if (state == kVThreadError) {
+			// Sonde Album : une tâche en erreur restait au sommet et gelait tout le jeu ; on la retire et on continue
+			warning("VThread task '%s' failed, dropping it", sondeTopTaskName().c_str());
+			popFrame();
+			continue;
+		}
 		if (state != kVThreadReturn)
 			return state;
 	}
@@ -81,6 +87,19 @@ VThreadState VThread::step() {
