+// Sonde Album : image tournée d'un quart de tour (onglets du menu : le bout de l'onglet vers le livre, à gauche)
+static UIImage *albumRotatedImage(UIImage *img, BOOL clockwise) {
+	const CGSize sz = CGSizeMake(img.size.height, img.size.width);
+	UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat];
+	fmt.scale = img.scale;
+	UIGraphicsImageRenderer *r = [[UIGraphicsImageRenderer alloc] initWithSize:sz format:fmt];
+	UIImage *out = [r imageWithActions:^(UIGraphicsImageRendererContext *ctx) {
+		CGContextRef c = ctx.CGContext;
+		CGContextTranslateCTM(c, sz.width / 2, sz.height / 2);
+		CGContextRotateCTM(c, (clockwise ? 1.0 : -1.0) * M_PI_2);
+		[img drawInRect:CGRectMake(-img.size.width / 2, -img.size.height / 2, img.size.width, img.size.height)];
+	}];
+	[r release];
+	return out;
+}
+
+// Icône d'un marque-page : album_icons/tabs/<nom>.png (bout de l'onglet extrait du jeu, télécommande « tabs »), tournée
+// pour pointer vers le livre, à gauche (les onglets du bas du livre pointent vers le bas : tournés dans l'autre sens)
+- (UIImage *)albumTabIcon:(NSString *)name bottom:(BOOL)bottom {
+	if (!_albumTabIcons)
+		_albumTabIcons = [[NSMutableDictionary alloc] init];
+	UIImage *img = _albumTabIcons[name];
+	if (img)
+		return img;
+	NSString *path = [[NSBundle mainBundle] pathForResource:name ofType:@"png" inDirectory:@"album_icons/tabs"];
+	img = path ? [UIImage imageWithContentsOfFile:path] : nil;
+	if (!img) {
+		// pas d'image : un rectangle arrondi neutre
+		UIGraphicsImageRenderer *r = [[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(22, 22)];
+		img = [r imageWithActions:^(UIGraphicsImageRendererContext *ctx) {
+			[[UIColor colorWithWhite:0.8 alpha:1.0] setFill];
+			[[UIBezierPath bezierPathWithRoundedRect:CGRectMake(0, 0, 22, 22) cornerRadius:6] fill];
+		}];
+		[r release];
+	} else {
+		img = albumRotatedImage(img, bottom);
+		// onglets HD (×4) : ramenés à la taille d'affichage (hauteur 22 points) à la définition de l'écran, sinon le bouton
+		// les dessine à leur taille propre et le nom est repoussé hors du bouton
+		if (img.size.height > 30) {
+			const CGFloat h = 22, w = h * img.size.width / img.size.height;
+			UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat];
+			fmt.scale = [UIScreen mainScreen].scale;
+			UIGraphicsImageRenderer *rr = [[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(w, h) format:fmt];
+			UIImage *src = img;
+			img = [rr imageWithActions:^(UIGraphicsImageRendererContext *ctx) {
+				CGContextSetInterpolationQuality(ctx.CGContext, kCGInterpolationHigh);
+				[src drawInRect:CGRectMake(0, 0, w, h)];
+			}];
+			[rr release];
+		}
+	}
+	_albumTabIcons[name] = img;
+	return img;
+}
