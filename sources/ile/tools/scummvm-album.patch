+}
+
+void BitmapSuiteModifier::linkInternalReferences(ObjectLinkingScope *scope) {
+	for (int k = 0; k < 2; k++) {
+		if (_refGUID[k]) {
+			Common::WeakPtr<RuntimeObject> obj = scope->resolve(_refGUID[k]);
+			RuntimeObject *objPtr = obj.lock().get();
+			if (objPtr && objPtr->isModifier())
+				_ref[k] = obj.staticCast<Modifier>();
+			else
+				warning("%s '%s': reference #%x unresolved", debugGetTypeName(), getName().c_str(), _refGUID[k]);
+		}
+	}
+}
+
+void BitmapSuiteModifier::visitInternalReferences(IStructuralReferenceVisitor *visitor) {
+	for (int k = 0; k < 2; k++)
+		visitor->visitWeakModifierRef(_ref[k]);
+}
+
+Modifier *BitmapSuiteModifier::resolveRef(int index) const {
+	return _ref[index].lock().get();
+}
+
+BitmapVariableModifier *BitmapSuiteModifier::resolveBitmapVar(int index) const {
+	return dynamic_cast<BitmapVariableModifier *>(resolveRef(index));
+}
+
+VisualElement *BitmapSuiteModifier::findParentVisualElement() const {
+	RuntimeObject *obj = getParent().lock().get();
+	while (obj) {
+		if (obj->isStructural()) {
+			Structural *st = static_cast<Structural *>(obj);
+			if (st->isElement() && static_cast<Element *>(st)->isVisual())
+				return static_cast<VisualElement *>(st);
+			obj = st->getParent();
+		} else if (obj->isModifier())
+			obj = static_cast<Modifier *>(obj)->getParent().lock().get();
+		else
+			break;
+	}
+	return nullptr;
+}
+
+void BitmapSuiteModifier::sondeLog(const char *kind, const Common::SharedPtr<MessageProperties> &msg) const {
+	VisualElement *elem = findParentVisualElement();
+	Modifier *r0 = resolveRef(0);
+	Modifier *r1 = resolveRef(1);
+	debug(1, "hoologic %s '%s' #%x on '%s' ref0='%s'(%s) ref1='%s'(%s) data type %d", kind, getName().c_str(), getStaticGUID(), elem ? elem->getName().c_str() : "?",
+		r0 ? r0->getName().c_str() : "-", r0 ? r0->debugGetTypeName() : "-", r1 ? r1->getName().c_str() : "-", r1 ? r1->debugGetTypeName() : "-", (int)msg->getValue().getType());
+}
+
+static Common::Rect sondeElementScreenRect(Runtime *runtime, VisualElement *elem) {
+	// Position absolue recalculée par la chaîne des parents : l'origine mise en cache n'existe qu'après le premier
+	// rendu (capture au démarrage de la scène « totem » → coin 0,0 → caches noirs)
+	Common::Point origin(0, 0);
+	for (Structural *s = elem; s; s = s->getParent()) {
+		if (s->isElement() && static_cast<Element *>(s)->isVisual()) {
+			const Common::Rect &pr = static_cast<VisualElement *>(s)->getRelativeRect();
+			origin.x += pr.left;
+			origin.y += pr.top;
+		}
+	}
+	const Common::Rect &r = elem->getRelativeRect();
+	return Common::Rect(origin.x, origin.y, origin.x + r.width(), origin.y + r.height());
+}
+
+static void sondeDumpBitmap(const Graphics::ManagedSurface &bmp, const Common::String &path) {
+	Common::DumpFile f;
+	if (!f.open(Common::FSNode(Common::Path(path))))
+		return;
+	if (bmp.format.bytesPerPixel == 1) {
+		byte pal[256 * 3];
+		g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+		Image::writePNG(f, *const_cast<Graphics::ManagedSurface &>(bmp).surfacePtr(), pal, 256);
+	} else {
+		Graphics::Surface *conv = const_cast<Graphics::ManagedSurface &>(bmp).surfacePtr()->convertTo(Graphics::PixelFormat(3, 8, 8, 8, 0, 16, 8, 0, 0));
+		Image::writePNG(f, *conv);
+		conv->free();
+		delete conv;
+	}
+}
+
+// ---- Sonde Album : fichiers de photos (Save/Import Bitmap) ----
+// Chemins du jeu du type "<player>/photos/pages/page_g1.bmp" -> fichier de sauvegarde ScummVM "albert1.player_photos_pages_page_g1.bmp"
+static Common::String sondeBitmapSaveName(const Common::String &gamePath) {
+	// préfixe = jeu en cours (albert1, albert2…), comme les autres fichiers de sauvegarde
+	Common::String n = ConfMan.getActiveDomainName().empty() ? Common::String("albert1.") : ConfMan.getActiveDomainName() + ".";
+	for (uint i = 0; i < gamePath.size(); i++) {
+		char ch = gamePath[i];
+		if (ch == '<' || ch == '>')
+			continue;
+		n += (ch == '/' || ch == '\\' || ch == ':' || ch == ' ') ? '_' : ch;
+	}
+	return n;
+}
+
+static bool sondeFindPathAndBitmap(Modifier *r0, Modifier *r1, Common::String &path, BitmapVariableModifier *&bitmapVar) {
+	Modifier *refs[2] = {r0, r1};
+	bitmapVar = nullptr;
+	path.clear();
+	for (Modifier *m : refs) {
+		if (!m)
+			continue;
+		if (BitmapVariableModifier *b = dynamic_cast<BitmapVariableModifier *>(m)) {
+			bitmapVar = b;
+			continue;
+		}
+		if (m->isVariable()) {
+			DynamicValue v;
+			static_cast<VariableModifier *>(m)->varGetValue(v);
+			if (v.getType() == DynamicValueTypes::kString)
+				path = v.getString();
+		}
+	}
+	return bitmapVar && !path.empty();
+}
+
+static Common::SharedPtr<Graphics::ManagedSurface> sondeLoadBMP(Common::SeekableReadStream &stream, const Graphics::PixelFormat &fmt) {
+	Image::BitmapDecoder decoder;
+	if (!decoder.loadStream(stream) || !decoder.getSurface())
+		return nullptr;
+	const Graphics::Surface *src = decoder.getSurface();
+	Common::SharedPtr<Graphics::ManagedSurface> out(new Graphics::ManagedSurface());
+	out->create(src->w, src->h, fmt);
+	const Graphics::Palette &pal = decoder.getPalette();
+	for (int y = 0; y < src->h; y++) {
+		for (int x = 0; x < src->w; x++) {
+			uint32 px = src->getPixel(x, y);
+			uint8 a = 255, r, g, b;
+			if (src->format.bytesPerPixel == 1)
+				pal.get(px, r, g, b);
+			else
+				src->format.colorToARGB(px, a, r, g, b);
+			out->setPixel(x, y, fmt.ARGBToColor(255, r, g, b));
+		}
+	}
+	return out;
+}
