+// Sonde Album : doigt posé. Sur un objet (pas le fond de page) et sans outil en main → bouton enfoncé tout de suite :
+// l'objet suit le doigt sans appui long, et un simple toucher reste un clic. Sur le fond, ou avec un outil (viseur,
+// loupe, flamme…), glisser le doigt reste un survol.
+void MTropolisEngine::sondeTouchBegin(int x, int y) {
+	_runtime->onMouseMove(x, y);
+	_sondeLastMouse = Common::Point(x, y);
+	_sondeSnap = Common::Point(0, 0);
+	if (_sondeTouchReleaseAt)
+		sondeTouchRelease();	// contact précédent pas encore relâché
+	if (_sondeTouchHeld)
+		return;
+	// Outil en main = le jeu a remplacé son curseur ordinaire (« magn_curs ») par un autre élément : viseur de l'appareil
+	// photo (photo_viseur), torche (feu)…
+	Common::SharedPtr<VisualElement> cursorElt = _runtime->sondeCursorElement();
+	const bool tool = cursorElt && cursorElt->getName() != "magn_curs";
+	bool nothing = false;
+	// doigt posé juste à côté d'un petit objet : on l'attrape quand même (même tolérance que pour les clics), le décalage
+	// suit le doigt jusqu'au relâchement
+	if (!tool && sondeFindSnap(x, y, _sondeSnap)) {
+		debug(1, "touch snap grab (%d,%d) +(%d,%d)", x, y, _sondeSnap.x, _sondeSnap.y);
+		x += _sondeSnap.x;
+		y += _sondeSnap.y;
+		_runtime->onMouseMove(x, y);
+		_sondeLastMouse = Common::Point(x, y);
+	}
+	Structural *s = _runtime->sondeTopAt(x, y);
+	if (tool || sondeIsBackgroundAt(x, y, nothing)) {
+		debug(1, "touch hover (%d,%d) '%s'%s", x, y, s ? s->getName().c_str() : "-", tool ? Common::String::format(" outil '%s'", cursorElt->getName().c_str()).c_str() : "");
+		return;
+	}
+	debug(1, "touch grab (%d,%d) '%s'", x, y, s ? s->getName().c_str() : "-");
+	_sondeTouchHeld = true;
+	_sondeSwallowUp = false;
+	_sondeTouchFreezeUntil = _system->getMillis() + 250;
+	_sondeTouchPendingMove = false;
+	_runtime->sondeTapEditLabel(x, y);
+	_runtime->onMouseDown(x, y, MTropolis::Actions::kMouseButtonLeft);
+}
+
+// Sonde Album : doigt levé → relâcher ce qu'on a saisi 250 ms plus tard (l'objet rattrape le doigt ; le clic du
+// tapotement qui suit est ignoré)
+void MTropolisEngine::sondeTouchEnd(int x, int y) {
+	if (!_sondeTouchHeld || _sondeTouchReleaseAt)
+		return;
+	x += _sondeSnap.x;	// objet attrapé à côté du doigt : le décalage le suit
+	y += _sondeSnap.y;
+	if (_system->getMillis() < _sondeTouchFreezeUntil) {
+		_sondeTouchPendingMove = true;
+		_sondeTouchPendingPos = Common::Point(x, y);
+	} else if (x != _sondeLastMouse.x || y != _sondeLastMouse.y) {
+		_runtime->onMouseMove(x, y);
+		_sondeLastMouse = Common::Point(x, y);
+	}
+	_sondeTouchReleasePos = Common::Point(x, y);
+	_sondeTouchReleaseAt = MAX<uint32>(_system->getMillis(), _sondeTouchFreezeUntil) + 250;
+	_sondeTouchSwallowUntil = _sondeTouchReleaseAt + 400;
+}
+
+void MTropolisEngine::sondeTouchRelease() {
+	const Common::Point &p = _sondeTouchReleasePos;
+	_sondeTouchReleaseAt = 0;
+	if (!_sondeTouchHeld)
+		return;
+	if (_sondeTouchPendingMove) {
+		_sondeTouchPendingMove = false;
+		_runtime->onMouseMove(p.x, p.y);
+	}
+	_runtime->onMouseUp(p.x, p.y, MTropolis::Actions::kMouseButtonLeft);
+	_sondeTouchHeld = false;
+	_sondeTouchSwallowUntil = _system->getMillis() + 400;
+	_sondeSnap = Common::Point(0, 0);
+	debug(1, "touch release (%d,%d)", p.x, p.y);
+}
+
 void MTropolisEngine::handleEvents() {
 	Common::Event evt;
 	Common::EventManager *eventMan = _system->getEventManager();
 
+	// Sonde Album : télécommande de test (fichier ernest_cmd) seulement si « album_remote=true » (Mac, simulateur) ;
+	// désactivée dans la version iPhone, où le dossier est visible depuis l'app Fichiers (revue Fable B4)
+	if (_sondeRemoteOn)
+		pollRemote();
+
+	// Sonde Album : fin du temps d'immobilité après la saisie → l'objet rejoint le doigt
+	if (_sondeTouchPendingMove && _system->getMillis() >= _sondeTouchFreezeUntil) {
+		_sondeTouchPendingMove = false;
+		_runtime->onMouseMove(_sondeTouchPendingPos.x, _sondeTouchPendingPos.y);
+		_sondeLastMouse = _sondeTouchPendingPos;
+	}
+	if (_sondeTouchReleaseAt && _system->getMillis() >= _sondeTouchReleaseAt)
+		sondeTouchRelease();
+	sondeUpdateLayout();
+	if (_sondeToolClickAt && _system->getMillis() >= _sondeToolClickAt) {	// Sonde Album : clic différé du bouton d'outil
+		_sondeToolClickAt = 0;
+		const Common::Point c = _sondeToolClickPos;
+		_runtime->onMouseMove(c.x, c.y);
+		_runtime->onMouseDown(c.x, c.y, MTropolis::Actions::kMouseButtonLeft);
+		_runtime->onMouseUp(c.x, c.y, MTropolis::Actions::kMouseButtonLeft);
+		// l'outil pris suit le pointeur : on le pose au milieu de la page plutôt que dans la barre masquée (rognée)
+		_sondeToolRecenterAt = _system->getMillis() + 120;
+	}
+	if (_sondeToolRecenterAt && _system->getMillis() >= _sondeToolRecenterAt) {
+		_sondeToolRecenterAt = 0;
+		Common::SharedPtr<VisualElement> cursorElt = _runtime->sondeCursorElement();
+		if (cursorElt && cursorElt->getName() != "magn_curs") {
+			_runtime->onMouseMove(320, 240);
+			_sondeLastMouse = Common::Point(320, 240);
+		}
+	}
+
 	while (eventMan->pollEvent(evt)) {
+		// Sonde Album : tactile iOS, début et fin de contact du doigt (déplacements marqués par le backend iOS)
+		if (evt.type == Common::EVENT_MOUSEMOVE && evt.customType == kSondeToolMark) {	// Sonde Album : bouton iOS
+			sondeToolCommand(evt.relMouse.x);
+			continue;
+		}
+		if (evt.type == Common::EVENT_MOUSEMOVE && evt.customType == kSondeTabMark) {	// Sonde Album : menu des marque-pages
+			sondeTabCommand(evt.relMouse.x);
+			continue;
+		}
+		if (evt.type == Common::EVENT_MOUSEMOVE && evt.customType == kSondeLayoutMark) {	// Sonde Album : lignes pour les noms
+			ConfMan.setInt("album_tab_lines", evt.relMouse.x, Common::ConfigManager::kTransientDomain);
+			continue;
+		}
+		if (evt.type == Common::EVENT_MOUSEMOVE && (evt.customType == kSondeTouchBeginMark || evt.customType == kSondeTouchEndMark)) {
+			if (evt.customType == kSondeTouchBeginMark)
+				sondeTouchBegin(evt.mouse.x, evt.mouse.y);
+			else
+				sondeTouchEnd(evt.mouse.x, evt.mouse.y);
+			continue;
+		}
+		// Sonde Album : pendant le temps d'immobilité qui suit la saisie, le curseur reste sur place (dernière position gardée)
+		if (evt.type == Common::EVENT_MOUSEMOVE && _sondeTouchHeld && _system->getMillis() < _sondeTouchFreezeUntil) {
+			_sondeTouchPendingMove = true;
+			_sondeTouchPendingPos = Common::Point(evt.mouse.x + _sondeSnap.x, evt.mouse.y + _sondeSnap.y);
+			continue;
+		}
+		// Sonde Album : clic du tapotement / de l'appui long alors que le doigt a déjà saisi l'objet → ignoré
+		if (evt.type == Common::EVENT_LBUTTONDOWN) {
+			if (_sondeTouchHeld)
+				continue;
+			if (_system->getMillis() < _sondeTouchSwallowUntil) {
+				_sondeSwallowUp = true;
+				continue;
+			}
+		} else if (evt.type == Common::EVENT_LBUTTONUP && !_sondeTouchHeld) {
+			if (_sondeSwallowUp || _system->getMillis() < _sondeTouchSwallowUntil) {
+				_sondeSwallowUp = false;
+				continue;
+			}
+		} else if (evt.type == Common::EVENT_LBUTTONUP && _sondeTouchHeld) {
+			// fin de l'appui long / du tapotement avant la fin du contact : même relâchement différé
+			sondeTouchEnd(evt.mouse.x, evt.mouse.y);
+			continue;
+		}
+		// Sonde Album : tolérance de clic (tactile) : un appui sur une zone vide proche d'une cible (post-it, outil de la barre)
+		// est rattrapé vers la cible la plus proche ; le décalage s'applique jusqu'au relâchement
+		if (evt.type == Common::EVENT_LBUTTONDOWN) {
+			_runtime->sondeTapEditLabel(evt.mouse.x, evt.mouse.y);	// Sonde Album : rouvrir le clavier rangé
+			_sondeSnap = Common::Point(0, 0);
+			if (sondeFindSnap(evt.mouse.x, evt.mouse.y, _sondeSnap))
+				debug(1, "touch snap (%d,%d) +(%d,%d)", evt.mouse.x, evt.mouse.y, _sondeSnap.x, _sondeSnap.y);
+		}
+		if (evt.type == Common::EVENT_LBUTTONDOWN || evt.type == Common::EVENT_LBUTTONUP || (evt.type == Common::EVENT_MOUSEMOVE && (_sondeSnap.x || _sondeSnap.y))) {
+			evt.mouse.x += _sondeSnap.x;
+			evt.mouse.y += _sondeSnap.y;
+		}
+		const bool sondeUp = (evt.type == Common::EVENT_LBUTTONUP);
+		// Sonde Album : tactile iOS, un tapotement arrive sans déplacement préalable du curseur ; le moteur teste la cible à la
+		// dernière position connue → on envoie d'abord un déplacement à l'endroit touché
+		if ((evt.type == Common::EVENT_LBUTTONDOWN || evt.type == Common::EVENT_LBUTTONUP || evt.type == Common::EVENT_RBUTTONDOWN) &&
+			(evt.mouse.x != _sondeLastMouse.x || evt.mouse.y != _sondeLastMouse.y))
+			_runtime->onMouseMove(evt.mouse.x, evt.mouse.y);
+		if (evt.type == Common::EVENT_LBUTTONDOWN || evt.type == Common::EVENT_LBUTTONUP || evt.type == Common::EVENT_RBUTTONDOWN || evt.type == Common::EVENT_MOUSEMOVE)
+			_sondeLastMouse = evt.mouse;
 		switch (evt.type) {
 		case Common::EVENT_LBUTTONDOWN:
 			_runtime->onMouseDown(evt.mouse.x, evt.mouse.y, MTropolis::Actions::kMouseButtonLeft);
@@ -101,10 +597,1715 @@ void MTropolisEngine::handleEvents() {
 		default:
 			break;
 		}
+		if (sondeUp)
+			_sondeSnap = Common::Point(0, 0);
+	}
+}
+
+
+// Télécommande de diagnostic : lit les nouvelles lignes ajoutées à /tmp/ernest_cmd
+// move X Y | down X Y | up X Y | click X Y | key C | text MOT | enter | wait N | shot CHEMIN.png
+static Common::SharedPtr<Structural> sondeFindScene(Structural *s, const Common::String &name) {
+	for (const Common::SharedPtr<Structural> &child : s->getChildren()) {
+		if (child->getSceneLoadState() != Structural::SceneLoadState::kNotAScene && child->getName() == name)
+			return child;
+		if (child->getSceneLoadState() == Structural::SceneLoadState::kNotAScene) {
+			Common::SharedPtr<Structural> r = sondeFindScene(child.get(), name);
+			if (r)
+				return r;
+		}
+	}
+	return nullptr;
+}
+
+static void sondeFindHitIn(VisualElement *v, Common::Point &hit, Runtime *rt, bool strict = false) {
+	const Common::Point &o = v->getCachedAbsoluteOrigin();
+	const Common::Rect &r = v->getRelativeRect();
+	int cx = r.width() / 2, cy = r.height() / 2;
+	for (int rad = 0; rad < MAX(r.width(), r.height()) && hit.x < 0; rad += 3) {
+		for (int a = 0; a < 16 && hit.x < 0; a++) {
+			int dx = (int)(rad * cos(a * M_PI / 8)), dy = (int)(rad * sin(a * M_PI / 8));
+			int lx = cx + dx, ly = cy + dy;
+			if (lx < 0 || ly < 0 || lx >= r.width() || ly >= r.height())
+				continue;
+			if (o.x + lx < 0 || o.y + ly < 0 || o.x + lx >= 640 || o.y + ly >= 480)
+				continue;
+			if (v->isMouseCollisionAtPoint(r.left + lx, r.top + ly)) {
+				Structural *top = rt->sondeTopAt(o.x + lx, o.y + ly);
+				if (strict ? top == v : (!top || top == v || top->getName() == v->getName() || top == v->getParent()))
+					hit = Common::Point(o.x + lx, o.y + ly);
+			}
+		}
+	}
+}
