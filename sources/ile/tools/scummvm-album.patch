+bool Project::loadNativeVariableFile(Common::SeekableReadStream &stream, Modifier *target) {
+	if (!stream.seek(4))
+		return false;
+
+	Data::DataReader reader(4, stream, (_platform == kProjectPlatformMacintosh) ? Data::kDataFormatMacintosh : Data::kDataFormatWindows, _runtimeVersion, _isRuntimeVersionAutoDetect);
+
+	g_sondeNativeSaveLoading = true;
+	SimpleModifierContainer holder;
+	ChildLoaderStack stack;
+	ChildLoaderContext rootContext;
+	rootContext.type = ChildLoaderContext::kTypeCountedModifierList;
+	rootContext.remainingCount = 1;
+	rootContext.containerUnion.modifierContainer = &holder;
+	stack.contexts.push_back(rootContext);
+
+	while (!stack.contexts.empty()) {
+		Common::SharedPtr<Data::DataObject> dataObject;
+		int64 objPos = stream.pos();
+		uint32 peekType = stream.readUint32LE();
+		uint16 peekRev = stream.readUint16LE();
+		stream.seek(objPos);
+		Data::DataReadErrorCode objErr = Data::loadDataObject(_plugInRegistry.getDataLoaderRegistry(), reader, dataObject);
+		if (objErr != Data::kDataReadErrorNone || !dataObject) {
+			g_sondeNativeSaveLoading = false;
+			warning("native restore: failed to read data object at %d type %x rev %d err %d", (int)objPos, peekType, peekRev, (int)objErr);
+			return false;
+		}
+		loadContextualObject(0, stack, *dataObject);
+	}
+	g_sondeNativeSaveLoading = false;
+
+	if (holder.getModifiers().empty() || !holder.getModifiers()[0])
+		return false;
+
+	Modifier *loaded = holder.getModifiers()[0].get();
+	if (loaded->isVariable() || !caseInsensitiveEqual(loaded->getName(), target->getName()))
+		debug(1, "native restore: file holds '%s', target is '%s'", loaded->getName().c_str(), target->getName().c_str());
+	sondeCopyVariableValues(loaded, target);
+	return true;
+}
