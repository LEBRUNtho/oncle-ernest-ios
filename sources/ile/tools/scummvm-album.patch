+// Sonde Album : changement d'image à la volée (utilisé par Init_cloner, ex. la boussole)
+MiniscriptInstructionOutcome ImageElement::scriptSetAsset(MiniscriptThread *thread, const DynamicValue &value) {
+	DynamicValue derefValue = value.dereference();
+	Project *project = thread->getRuntime()->getProject();
+	uint32 assetID = 0;
+	if (derefValue.getType() == DynamicValueTypes::kString) {
+		if (!project->getAssetIDByName(derefValue.getString(), assetID)) {
+			warning("Image element references asset '%s' but the asset ID couldn't be resolved", derefValue.getString().c_str());
+			return kMiniscriptInstructionOutcomeFailed;
+		}
+	} else if (derefValue.getType() == DynamicValueTypes::kInteger) {
+		assetID = derefValue.getInt();
+	} else {
+		thread->error("Tried to set an image's asset to an unsupported value");
+		return kMiniscriptInstructionOutcomeFailed;
+	}
+	Common::SharedPtr<Asset> asset = project->getAssetByID(assetID).lock();
+	if (!asset) {
+		Common::Array<Common::SharedPtr<Asset> > forceLoadedAssets;
+		project->forceLoadAsset(assetID, forceLoadedAssets);
+		asset = project->getAssetByID(assetID).lock();
+	}
+	if (!asset || asset->getAssetType() != kAssetTypeImage) {
+		warning("Image element assigned asset %u which isn't a loaded image", assetID);
+		return kMiniscriptInstructionOutcomeFailed;
+	}
+	_assetID = assetID;
+	_cachedImage = static_cast<ImageAsset *>(asset.get())->loadAndCacheImage(getRuntime());
+	_contentsDirty = true;
+	thread->getRuntime()->setSceneGraphDirty();
+	return kMiniscriptInstructionOutcomeContinue;
+}
