+// Sonde Album : dessin pivoté (plugin Rotator). Projection inverse au plus proche voisin autour du centre du rectangle cible.
+static void sondeBlitRotated(Graphics::ManagedSurface &dest, const Graphics::ManagedSurface &src, const Common::Rect &srcRect, const Common::Rect &destRect, double degrees, bool useTrans, uint32 transColor, const ColorRGB8 *keyRGB, bool shadow, VisualElement *hitOwner) {
+	const double rad = degrees * M_PI / 180.0;
+	const double c = cos(rad), sn = sin(rad);
+	const double cx = destRect.left + destRect.width() / 2.0;
+	const double cy = destRect.top + destRect.height() / 2.0;
+	const double hw = destRect.width() / 2.0, hh = destRect.height() / 2.0;
+	const double r = sqrt(hw * hw + hh * hh);
+	// Sonde Album (revue Fable B5) : bornage avant conversion en int16 (élément envoyé très loin par un script)
+	auto clamp16 = [](double v) { return (int16)CLIP<double>(v, -16000.0, 16000.0); };
+	Common::Rect bbox(clamp16(floor(cx - r)), clamp16(floor(cy - r)), clamp16(ceil(cx + r) + 1), clamp16(ceil(cy + r) + 1));
+	bbox.clip(Common::Rect(dest.w, dest.h));
+	if (hitOwner) {
+		hitOwner->sondeHitBox = bbox;
+		// Sonde Album : réutiliser le masque au lieu de le réallouer à chaque image (revue Fable B1)
+		const uint n = bbox.isEmpty() ? 0 : (uint)bbox.width() * bbox.height();
+		if (hitOwner->sondeHitMask.size() != n)
+			hitOwner->sondeHitMask.resize(n);
+		if (n)
+			memset(&hitOwner->sondeHitMask[0], 0, n);
+	}
+	if (bbox.isEmpty() || destRect.width() <= 0 || destRect.height() <= 0 || srcRect.isEmpty())	// Sonde Album : revue Fable A5
+		return;
+
+	const bool srcIndexed = (src.format.bytesPerPixel == 1);
+	byte pal[256 * 3];
+	if (srcIndexed)
+		const_cast<Graphics::ManagedSurface &>(src).grabPalette(pal, 0, 256);
+
+	for (int y = bbox.top; y < bbox.bottom; y++) {
+		for (int x = bbox.left; x < bbox.right; x++) {
+			// rotation inverse : on remonte du pixel écran vers le pixel source
+			double dx = x + 0.5 - cx, dy = y + 0.5 - cy;
+			double ux = c * dx - sn * dy;
+			double uy = sn * dx + c * dy;
+			int sx = srcRect.left + (int)floor((ux + hw) * srcRect.width() / destRect.width());
+			int sy = srcRect.top + (int)floor((uy + hh) * srcRect.height() / destRect.height());
+			if (sx < srcRect.left || sy < srcRect.top || sx >= srcRect.right || sy >= srcRect.bottom)
+				continue;
+			uint32 px = src.getPixel(sx, sy);
+			if (useTrans && px == transColor)
+				continue;
+			if (keyRGB) {
+				uint8 ka, kr, kg, kb;
+				if (srcIndexed) {
+					kr = pal[px * 3 + 0]; kg = pal[px * 3 + 1]; kb = pal[px * 3 + 2];
+				} else
+					src.format.colorToARGB(px, ka, kr, kg, kb);
+				if (kr == keyRGB->r && kg == keyRGB->g && kb == keyRGB->b)
+					continue;
+			}
+			if (hitOwner)
+				hitOwner->sondeHitMask[(y - bbox.top) * bbox.width() + (x - bbox.left)] = 1;
+			if (shadow) {
+				// ombre : assombrit ce qui est dessous (approximation du rendu du Rotator, à confirmer)
+				uint8 da, dr, dg, db;
+				dest.format.colorToARGB(dest.getPixel(x, y), da, dr, dg, db);
+				dest.setPixel(x, y, dest.format.ARGBToColor(255, dr * 55 / 100, dg * 55 / 100, db * 55 / 100));
+				continue;
+			}
+			if (srcIndexed) {
+				dest.setPixel(x, y, dest.format.RGBToColor(pal[px * 3 + 0], pal[px * 3 + 1], pal[px * 3 + 2]));
+			} else if (src.format == dest.format) {
+				dest.setPixel(x, y, px);
+			} else {
+				uint8 a, rr, g, b;
+				src.format.colorToARGB(px, a, rr, g, b);
+				if (a == 0)
+					continue;
+				dest.setPixel(x, y, dest.format.ARGBToColor(a, rr, g, b));
+			}
+		}
+	}
+}
