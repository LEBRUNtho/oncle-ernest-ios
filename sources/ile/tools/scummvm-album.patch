+static void dumpModifier(Common::WriteStream &out, Modifier *m, int depth) {
+	if (!m)
+		return;
+	Common::String line(depth * 2, ' ');
+	line += Common::String::format("- %s '%s' #%x", m->debugGetTypeName(), m->getName().c_str(), m->getStaticGUID());
+	if (SetModifier *sm = dynamic_cast<SetModifier *>(m))
+		line += Common::String::format(" when=%x/%x", (unsigned)sm->sondeWhen().eventType, sm->sondeWhen().eventInfo);	// Sonde Album
+	if (MiniscriptModifier *mm = dynamic_cast<MiniscriptModifier *>(m))
+		line += Common::String::format(" when=%x/%x", (unsigned)mm->sondeWhen().eventType, mm->sondeWhen().eventInfo);	// Sonde Album
+	if (m->getName() == "v_pds")
+		line += Common::String::format(" @%p", (void *)m);	// Sonde Album
+	if (BehaviorModifier *bm = dynamic_cast<BehaviorModifier *>(m))
+		line += bm->sondeDescribeSwitch(); // Sonde Album : état des comportements commutables
+	if (Standard::ListVariableModifier *lv = dynamic_cast<Standard::ListVariableModifier *>(m)) {
+		line += " = " + lv->sondeDescribe();
+	} else if (Standard::ObjectReferenceVariableModifier *ov = dynamic_cast<Standard::ObjectReferenceVariableModifier *>(m)) {
+		line += " " + ov->sondeDescribe();
+	} else if (m->isVariable()) {
+		DynamicValue v;
+		static_cast<VariableModifier *>(m)->varGetValue(v);
+		switch (v.getType()) {
+		case DynamicValueTypes::kInteger: line += Common::String::format(" = %d", v.getInt()); break;
+		case DynamicValueTypes::kFloat: line += Common::String::format(" = %g", v.getFloat()); break;
+		case DynamicValueTypes::kBoolean: line += v.getBool() ? " = true" : " = false"; break;
+		case DynamicValueTypes::kString: line += " = \"" + v.getString() + "\""; break;
+		case DynamicValueTypes::kPoint: line += Common::String::format(" = (%d,%d)", v.getPoint().x, v.getPoint().y); break;
+		case DynamicValueTypes::kList: {
+			line += Common::String::format(" = list[%u]", (unsigned)v.getList()->getSize());
+			const Common::SharedPtr<DynamicList> &lst = v.getList();
+			for (size_t li = 0; li < lst->getSize() && li < (lst->getSize() > 200 ? 12 : 200); li++) {
+				DynamicValue e;
+				lst->getAtIndex(li, e);
+				if (e.getType() == DynamicValueTypes::kPoint)
+					line += Common::String::format(" (%d,%d)", e.getPoint().x, e.getPoint().y);
+				else if (e.getType() == DynamicValueTypes::kInteger)
+					line += Common::String::format(" %d", e.getInt());
+				else if (e.getType() == DynamicValueTypes::kString)
+					line += " \"" + e.getString() + "\"";
+				else if (e.getType() == DynamicValueTypes::kFloat)
+					line += Common::String::format(" %g", e.getFloat());
+				else if (e.getType() == DynamicValueTypes::kBoolean)
+					line += e.getBool() ? " vrai" : " faux";
+				else if (e.getType() == DynamicValueTypes::kObject) {
+					Common::SharedPtr<RuntimeObject> lo = e.getObject().object.lock();
+					if (lo && lo->isStructural())
+						line += " @" + static_cast<Structural *>(lo.get())->getName();
+					else if (lo && lo->isModifier())
+						line += " @" + static_cast<Modifier *>(lo.get())->getName();
+					else
+						line += " @?";
+				} else
+					line += Common::String::format(" ?%d", (int)e.getType());
+			}
+		} break;
+		case DynamicValueTypes::kObject: {
+			Common::SharedPtr<RuntimeObject> o = v.getObject().object.lock();
+			line += Common::String::format(" = obj #%x", o ? o->getStaticGUID() : 0);
+		} break;
+		default: line += Common::String::format(" = (type %d)", (int)v.getType()); break;
+		}
+	}
+	if (TimerMessengerModifier *tm = dynamic_cast<TimerMessengerModifier *>(m))
+		line += Common::String::format(" when=%x/%x send=%x/%x", (unsigned)tm->sondeExecuteWhen().eventType, tm->sondeExecuteWhen().eventInfo,
+			(unsigned)tm->sondeSendSpec().send.eventType, tm->sondeSendSpec().send.eventInfo);
+	if (IfMessengerModifier *im = dynamic_cast<IfMessengerModifier *>(m))
+		line += Common::String::format(" when=%x/%x send=%x/%x dest=%x", (unsigned)im->sondeWhen().eventType, im->sondeWhen().eventInfo,
+			(unsigned)im->sondeSendSpec().send.eventType, im->sondeSendSpec().send.eventInfo, im->sondeSendSpec().destination);
+	if (MessengerModifier *mm = dynamic_cast<MessengerModifier *>(m))
+		line += Common::String::format(" when=%x/%x send=%x/%x dest=%x", (unsigned)mm->sondeWhen().eventType, mm->sondeWhen().eventInfo,
+			(unsigned)mm->sondeSendSpec().send.eventType, mm->sondeSendSpec().send.eventInfo, mm->sondeSendSpec().destination);
+	line += "\n";
+	out.writeString(line);
+	IModifierContainer *c = m->getChildContainer();
+	if (c)
+		for (const Common::SharedPtr<Modifier> &child : c->getModifiers())
+			dumpModifier(out, child.get(), depth + 1);
+}
+
+static void dumpTree(Common::WriteStream &out, Structural *s, int depth) {
+	Common::String line(depth * 2, ' ');
+	line += Common::String::format("%s '%s' #%x", s->debugGetTypeName(), s->getName().c_str(), s->getStaticGUID());
+	if (s->isElement() && static_cast<Element *>(s)->isVisual()) {
+		VisualElement *v = static_cast<VisualElement *>(s);
+		const Common::Rect &r = v->getRelativeRect();
+		line += Common::String::format(" vis=%d%s layer=%d rect=(%d,%d %dx%d)", v->isVisible() ? 1 : 0, v->isVisibleByDefault() ? "" : "(cache)", v->getLayer(), r.left, r.top, r.width(), r.height());
+		const VisualElementRenderProperties &rp = v->sondeGetRenderProps();
+		line += Common::String::format(" ink=%x bg=%02x%02x%02x", (unsigned)rp.getInkMode(), rp.getBackColor().r, rp.getBackColor().g, rp.getBackColor().b);
+		if (v->sondeRotationDeg != 0.0)
+			line += Common::String::format(" rot=%g", v->sondeRotationDeg);
+		if (MToonElement *mt = dynamic_cast<MToonElement *>(v))
+			line += Common::String::format(" cel=%d nat=%dx%d@%d,%d", (int)mt->sondeGetCel(), mt->sondeNatRect().width(), mt->sondeNatRect().height(), mt->sondeNatRect().left, mt->sondeNatRect().top);
+		if (v->getDragMotionProperties())
+			line += " drag";	// Sonde Album
+		if (v->isTextLabel())
+			line += " text=\"" + static_cast<TextLabelElement *>(v)->sondeGetText() + "\"";
+	}
+	line += Common::String::format(" mods=%u\n", (unsigned)s->getModifiers().size());
+	out.writeString(line);
+	for (const Common::SharedPtr<Modifier> &m : s->getModifiers())
+		dumpModifier(out, m.get(), depth + 1);
+	for (const Common::SharedPtr<Structural> &child : s->getChildren())
+		dumpTree(out, child.get(), depth + 1);
+}
+
+// Sonde Album : applique un angle à tous les Rotators d'une liste de modificateurs (y compris dans les comportements)
+static int sondeRotSetIn(Runtime *runtime, IModifierContainer *c, double deg) {
+	int n = 0;
+	if (!c)
+		return 0;
+	for (const Common::SharedPtr<Modifier> &m : c->getModifiers()) {
+		if (Hoologic::RotatorKModifier *r = dynamic_cast<Hoologic::RotatorKModifier *>(m.get())) {
+			if (strcmp(r->_kind, "Rotator") == 0) {
+				r->sondeApplyAngle(runtime, deg);
+				n++;
+			}
+		}
+		n += sondeRotSetIn(runtime, m->getChildContainer(), deg);
+	}
+	return n;
+}
+
+void MTropolisEngine::pollRemote() {
+	if (_sondeSnapcamFrames > 0) {	// Sonde Album : guetteur « snapcam »
+		_sondeSnapcamFrames--;
+		if ((_sondeSnapcamFrames % 120) == 0)
+			debug("remote: snapcam actif, bouton=%d", (int)_sondeRemoteButtonDown);
+		{
+			Structural *roots[2] = {_runtime->getActiveMainScene().get(), _runtime->getActiveSharedScene().get()};
+			Common::Array<VisualElement *> all;
+			for (Structural *root : roots)
+				if (root)
+					sondeCollectNamed(root, _sondeSnapcamName, all);
+			for (VisualElement *v : all) {
+				if (!v->isVisible())
+					continue;
+				if (_sondeSnapcamCelMin >= 0) {	// plage d'images de l'animation (photo valable seulement sur ces images)
+					MToonElement *mt = dynamic_cast<MToonElement *>(v);
+					if (!mt) {	// jeu 3 : l'animal est un élément graphique dont l'animation est l'enfant « animation »
+						for (const Common::SharedPtr<Structural> &ch : v->getChildren())
+							if (ch->getName() == "animation")
+								mt = dynamic_cast<MToonElement *>(ch.get());
+					}
+					if (!mt || (int)mt->sondeGetCel() < _sondeSnapcamCelMin || (int)mt->sondeGetCel() > _sondeSnapcamCelMax)
+						continue;
+				}
+				const Common::Rect &r = v->getRelativeRect();
+				Common::Point o = v->getCachedAbsoluteOrigin();
+				int cx = o.x + r.width() / 2, cy = o.y + r.height() / 2;
+				int dx = cx - _sondeSnapcamX, dy = cy - _sondeSnapcamY;
+				if ((_sondeSnapcamFrames % 20) == 0)
+					debug("remote: snapcam guette %s (%d,%d) bouton=%d", _sondeSnapcamName.c_str(), cx, cy, (int)_sondeRemoteButtonDown);
+				if (dx * dx + dy * dy <= _sondeSnapcamR * _sondeSnapcamR) {
+					debug("remote: snapcam %s dans la zone (%d,%d)", _sondeSnapcamName.c_str(), cx, cy);
+					// prioritaire : passe devant les commandes en attente (lâche d'abord une planche tenue)
+					if (_sondeRemoteButtonDown) {
+						_runtime->onMouseUp(_sondeRemoteX, _sondeRemoteY, MTropolis::Actions::kMouseButtonLeft);
+						_sondeRemoteButtonDown = false;
+					}
+					// bouton de l'appareil photo : là où le jeu l'affiche (jeu 2 : 232,459 ; jeu 3 : 203,459)
+					int camX = 232, camY = 459;
+					for (Structural *root : roots) {
+						Common::Array<VisualElement *> cams;
+						if (root)
+							sondeCollectNamed(root, Common::String("appphotos_bas"), cams);
+						for (VisualElement *cam : cams) {
+							const Common::Rect &cr = cam->getRelativeRect();
+							Common::Point co = cam->getCachedAbsoluteOrigin();
+							camX = co.x + cr.width() / 2;
+							camY = co.y + cr.height() / 2;
+						}
+					}
+					_remoteQueue.insert_at(0, Common::String::format("click %d %d", camX, camY));
+					_remoteQueue.insert_at(1, Common::String("wait 12"));
+					// jeu 3 : un suivi d'une seule image ne prend pas la photo (survol non enregistré) : réglage « sonde_snap_follow »
+					int snapFollow = ConfMan.hasKey("sonde_snap_follow") ? ConfMan.getInt("sonde_snap_follow") : 1;
+					_remoteQueue.insert_at(2, Common::String::format("snap %s %d %d 0 %d %d %d", _sondeSnapcamName.c_str(), 40 + snapFollow, snapFollow, _sondeSnapcamX, _sondeSnapcamY, _sondeSnapcamR + 60));
+					_remoteQueue.insert_at(3, Common::String("wait 45"));
+					_remoteQueue.insert_at(4, Common::String::format("click %d %d", camX, camY));
+					_remoteWait = 0;
+					_sondeSnapcamFrames = 0;
+					break;
+				}
+			}
+		}
+	}
+	if (_remoteWait > 0) {
+		_remoteWait--;
+		return;
+	}
+	if (_remoteQueue.empty() && (++_remoteTick % 10) == 0) {
+		Common::FSNode node(Common::Path("/tmp/ernest_cmd"));
+		Common::SeekableReadStream *s = node.exists() ? node.createReadStream() : nullptr;
+		if (s) {
+			uint n = 0;
+			while (!s->eos()) {
+				Common::String line = s->readLine();
+				if (s->eos() && line.empty())
+					break;
+				if (++n > _remoteLines && !line.empty())
+					_remoteQueue.push_back(line);
+			}
+			_remoteLines = n;
+			delete s;
+		}
+	}
+	while (!_remoteQueue.empty() && _remoteWait == 0) {
+		Common::String line = _remoteQueue.remove_at(0);
+		char cmd[16] = {0}, arg[256] = {0};
+		int x = 0, y = 0;
+		sscanf(line.c_str(), "%15s %255[^\n]", cmd, arg);
+		sscanf(arg, "%d %d", &x, &y);
+		Common::String c(cmd);
+		if (c == "move" || c == "down" || c == "up" || c == "click") {
+			_sondeRemoteX = x;
+			_sondeRemoteY = y;
+			sondeWarpMouse(_system, x, y);
+			_runtime->onMouseMove(x, y);
+			if (c == "down" || c == "click")
+				_runtime->onMouseDown(x, y, MTropolis::Actions::kMouseButtonLeft);
+			if (c == "up")
+				_runtime->onMouseUp(x, y, MTropolis::Actions::kMouseButtonLeft);
+			if (c == "down" || c == "click")	// Sonde Album : guetteur snapcam (pas pendant un glisser)
+				_sondeRemoteButtonDown = true;
+			else if (c == "up")
+				_sondeRemoteButtonDown = false;
+			if (c == "click") {
+				_remoteQueue.insert_at(0, Common::String::format("up %d %d", x, y));
+				_remoteWait = 3;
+			}
+		} else if (c == "key" || c == "text" || c == "enter") {
+			Common::String chars = (c == "enter") ? Common::String("\r") : Common::String(arg);
+			for (uint i = 0; i < chars.size(); i++) {
+				Common::KeyState ks;
+				ks.ascii = (byte)chars[i];
+				ks.keycode = (chars[i] == '\r') ? Common::KEYCODE_RETURN : (Common::KeyCode)tolower((byte)chars[i]);
+				_runtime->onKeyboardEvent(Common::EVENT_KEYDOWN, false, ks);
+				_runtime->onKeyboardEvent(Common::EVENT_KEYUP, false, ks);
+			}
+		} else if (c == "wait") {
+			_remoteWait = x;
+		} else if (c == "stopat") {
+			// Sonde Album (jeu 3, galeries) : « stopat CAILLOU FOURMI TX TY N » attend (N images max) que le centre de l'élément
+			// CAILLOU soit à moins de 4 px de (TX,TY), puis attrape la FOURMI la plus proche du caillou (souris enfoncée = elle
+			// s'arrête), inverse sa direction (myDir) et la relâche : elle repart en arrière au lieu de continuer à pousser.
+			char stoneBuf[64] = {0}, antBuf[64] = {0};
+			int tx = 0, ty = 0, frames = 0;
+			sscanf(arg, "%63s %63s %d %d %d", stoneBuf, antBuf, &tx, &ty, &frames);
+			Structural *root = _runtime->getActiveMainScene().get();
+			Common::Array<VisualElement *> st, an;
+			if (root) {
+				sondeCollectNamed(root, Common::String(stoneBuf), st);
+				sondeCollectNamed(root, Common::String(antBuf), an);
+			}
+			bool done = false;
+			if (!st.empty()) {
+				// le caillou le plus proche de la cible (plusieurs cailloux de même nom sur la page)
+				VisualElement *sv = st[0];
+				int64 sbd = INT64_MAX;
+				for (VisualElement *v : st) {
+					Common::Point o = v->getCachedAbsoluteOrigin();
+					int64 dx = o.x + v->getRelativeRect().width() / 2 - tx, dy = o.y + v->getRelativeRect().height() / 2 - ty;
+					if (dx * dx + dy * dy < sbd) {
+						sbd = dx * dx + dy * dy;
+						sv = v;
+					}
+				}
+				Common::Point so = sv->getCachedAbsoluteOrigin();
+				int scx = so.x + sv->getRelativeRect().width() / 2, scy = so.y + sv->getRelativeRect().height() / 2;
+				if (ABS(scx - tx) <= 4 && ABS(scy - ty) <= 4) {
+					VisualElement *best = nullptr;
+					int64 bd = INT64_MAX;
+					for (VisualElement *v : an) {
+						Common::Point o = v->getCachedAbsoluteOrigin();
+						int64 dx = o.x + v->getRelativeRect().width() / 2 - scx, dy = o.y + v->getRelativeRect().height() / 2 - scy;
+						if (dx * dx + dy * dy < bd) {
+							bd = dx * dx + dy * dy;
+							best = v;
+						}
+					}
+					if (best) {
+						Common::Point o = best->getCachedAbsoluteOrigin();
+						int ax = o.x + best->getRelativeRect().width() / 2, ay = o.y + best->getRelativeRect().height() / 2;
+						_runtime->onMouseMove(ax, ay);
+						_runtime->onMouseDown(ax, ay, MTropolis::Actions::kMouseButtonLeft);
+						for (const Common::SharedPtr<Modifier> &m : best->getModifiers())
+							if (m->getName() == "myDir" && m->isVariable()) {
+								DynamicValue dv;
+								static_cast<VariableModifier *>(m.get())->varGetValue(dv);
+								if (dv.getType() == DynamicValueTypes::kPoint) {
+									dv.setPoint(Common::Point(-dv.getPoint().x, -dv.getPoint().y));
+									static_cast<VariableModifier *>(m.get())->varSetValue(nullptr, dv);
+								}
+							}
+						_remoteQueue.insert_at(0, Common::String::format("up %d %d", ax, ay));
+						_remoteQueue.insert_at(0, Common::String("wait 3"));
+						debug("stopat : caillou en (%d,%d), fourmi attrapée en (%d,%d) et retournée", scx, scy, ax, ay);
+					}
+					done = true;
+				}
+			}
+			if (!done) {
+				if (frames > 1) {
+					_remoteQueue.insert_at(0, Common::String::format("stopat %s %s %d %d %d", stoneBuf, antBuf, tx, ty, frames - 1));
+					_remoteWait = 1;
+				} else
+					debug("stopat TEMPS ÉCOULÉ");
+			}
+		} else if (c == "flamebot") {
+			// Sonde Album (jeu 3, cache secrète) : « flamebot N » torche en main, passe la flamme sur le serpent qui revient vers le
+			// puits (variable fosse_state = 3) le plus proche du puits (310,272) : il fait demi-tour vers son trou. Sans serpent à
+			// repousser, souris dans le coin haut droit. Trace toutes les 60 images.
+			int frames = 0;
+			sscanf(arg, "%d", &frames);
+			Structural *root = _runtime->getActiveMainScene().get();
+			Common::Array<VisualElement *> all;
+			static const char *kinds[3] = {"snake_yellow", "snake_red", "snake_cobra"};
+			if (root)
+				for (const char *k : kinds)
+					sondeCollectNamed(root, Common::String(k), all);
+			VisualElement *best = nullptr;
+			int64 bd = INT64_MAX;
+			int retour = 0;
+			for (VisualElement *v : all) {
+				int32 st = 0;
+				if (!sondeFindIntVar(v, "fosse_state", st) || st != 3)
+					continue;
+				retour++;
+				Common::Point o = v->getCachedAbsoluteOrigin();
+				int64 dx = o.x + v->getRelativeRect().width() / 2 - 310, dy = o.y + v->getRelativeRect().height() / 2 - 272;
+				if (dx * dx + dy * dy < bd) {
+					bd = dx * dx + dy * dy;
+					best = v;
+				}
+			}
+			// torche éteinte (outil à durée limitée, 20 s) : la torche du bas disparaît avec elle, on rallume à la flamme murale
+			// (élément « feu » 128 de large de la page ; l'élément curseur « feu » 20x36 n'est visible que torche en main)
+			{
+				Common::Array<VisualElement *> feux;
+				Structural *sroot = _runtime->getActiveSharedScene().get();
+				if (sroot)
+					sondeCollectNamed(sroot, Common::String("feu"), feux);
+				if (root)
+					sondeCollectNamed(root, Common::String("feu"), feux);
+				bool feuEnMain = false;
+				VisualElement *murale = nullptr;
+				for (VisualElement *f : feux) {
+					if (f->getRelativeRect().width() == 20 && f->isVisible())
+						feuEnMain = true;
+					if (f->getRelativeRect().width() == 128 && f->isVisible())
+						murale = f;
+				}
+				if (!feuEnMain && murale && (frames % 20) == 0) {
+					Common::Point h(-1, -1);
+					sondeFindHitIn(murale, h, _runtime.get());
+					if (h.x < 0) {
+						Common::Point o = murale->getCachedAbsoluteOrigin();
+						h = Common::Point(o.x + 64, o.y + 60);
+					}
+					_runtime->onMouseMove(h.x, h.y);
+					_runtime->onMouseDown(h.x, h.y, MTropolis::Actions::kMouseButtonLeft);
+					_runtime->onMouseUp(h.x, h.y, MTropolis::Actions::kMouseButtonLeft);
+					debug("flamebot : torche rallumée à la flamme murale (%d,%d)", h.x, h.y);
+					if (frames > 1) {
+						_remoteQueue.insert_at(0, Common::String::format("flamebot %d", frames - 1));
+						_remoteWait = 3;
+					}
+					break;
+				}
+			}
+			int mx = 600, my = 60;	// sans serpent à repousser : souris hors de la porte (la survoler bloque la sortie des serpents)
+			if (best) {
+				Common::Point o = best->getCachedAbsoluteOrigin();
+				mx = o.x + best->getRelativeRect().width() / 2;
+				my = o.y + best->getRelativeRect().height() / 2;
+				// viser un pixel réellement dessiné de l'ANIMATION du serpent (c'est elle qui porte « survol → retour au trou ») ; le
+				// support 50x50 du serpent est au-dessus d'elle en son centre : seules la tête et la queue qui dépassent comptent
+				Common::Point h(-1, -1);
+				for (const Common::SharedPtr<Structural> &ch : best->getChildren())
+					if (ch->getName() == "animation" && ch->isElement() && static_cast<Element *>(ch.get())->isVisual() && h.x < 0)
+						sondeFindHitIn(static_cast<VisualElement *>(ch.get()), h, _runtime.get(), true);
+				if (h.x >= 0) {
+					mx = h.x;
+					my = h.y;
+				}
+				if (frames % 30 == 1) {
+					Structural *top = _runtime->sondeTopAt(mx, my);
+					debug("flamebot : vise %s #%x en (%d,%d) touché=%d dessus=%s #%x", best->getName().c_str(), best->getStaticGUID(), mx, my,
+						(int)(h.x >= 0), top ? top->getName().c_str() : "-", top ? top->getStaticGUID() : 0);
+				}
+				if ((frames % 2) == 0) {	// une image sur deux hors du serpent : le survol (entrée) se redéclenche
+					mx = 600;
+					my = 60;
+				}
+			}
+			_runtime->onMouseMove(mx, my);
+			if (frames % 60 == 0)
+				debug("flamebot : %d serpents visibles, %d reviennent vers le puits", (int)all.size(), retour);
+			if (frames > 1) {
+				_remoteQueue.insert_at(0, Common::String::format("flamebot %d", frames - 1));
+				_remoteWait = 1;
+			} else
+				debug("flamebot FIN");
+		} else if (c == "boatgo") {
+			// Sonde Album (jeu 3, voilier 06-B-cotes) : « boatgo N [FICHIER] » suit une route (points « x,y » du coin haut-gauche
+			// du bateau en coordonnées de la carte, lus dans FICHIER au premier appel) : à chaque image, souris posée à 70 px du
+			// centre du bateau dans la direction du prochain point (le jeu arrondit à l'une de ses 6 directions). Coincé
+			// (vent de face) : on dévie de 60° un moment. Trace toutes les 60 images.
+			static Common::Array<Common::Point> wps;
+			static uint wpIdx = 0;
+			static int stuck = 0, detour = 0, bestD = INT_MAX;
+			int frames = 0;
+			char fileBuf[256] = {0};
+			sscanf(arg, "%d %255s", &frames, fileBuf);
+			if (fileBuf[0]) {
+				wps.clear();
+				wpIdx = 0;
+				stuck = detour = 0;
+				bestD = INT_MAX;
+				Common::File f;
+				if (f.open(Common::FSNode(Common::Path(fileBuf)))) {
+					Common::String all;
+					while (!f.eos())
+						all += f.readLine() + " ";
+					const char *q = all.c_str();
+					int x, y, n;
+					while (sscanf(q, " %d,%d%n", &x, &y, &n) == 2) {
+						wps.push_back(Common::Point(x, y));
+						q += n;
+					}
+				}
+				debug("boatgo : %u points", (unsigned)wps.size());
+			}
+			Structural *root = _runtime->getActiveMainScene().get();
+			Common::Array<VisualElement *> boats, maps;
+			if (root) {
+				sondeCollectNamed(root, Common::String("boat"), boats);
+				sondeCollectNamed(root, Common::String("map"), maps);
+			}
+			if (boats.empty() || maps.empty() || wpIdx >= wps.size()) {
+				debug("boatgo FIN (point %u/%u)", wpIdx, (unsigned)wps.size());
+				break;
+			}
+			VisualElement *b = boats[0], *m = maps[0];
+			int bx = b->getRelativeRect().left - m->getRelativeRect().left, by = b->getRelativeRect().top - m->getRelativeRect().top;
+			Common::Point t = wps[wpIdx];
+			int dx = t.x - bx, dy = t.y - by, d2 = dx * dx + dy * dy;
+			while (d2 < 24 * 24 && wpIdx + 1 < wps.size()) {
+				wpIdx++;
+				t = wps[wpIdx];
+				dx = t.x - bx;
+				dy = t.y - by;
+				d2 = dx * dx + dy * dy;
+				bestD = INT_MAX;
+				stuck = 0;
+			}
+			if (d2 < bestD) {
+				bestD = d2;
+				stuck = 0;
+			} else if (++stuck > 60 && detour == 0) {
+				detour = 40;
+				stuck = 0;
+			}
+			// 6 caps possibles (souris au centre exact d'un secteur du jeu) ; vitesse réelle de chaque cap apprise en marchant
+			static double vx[6], vy[6];
+			static int lastK = -1, lastBx = 0, lastBy = 0, sameK = 0;
+			if (fileBuf[0]) {
+				for (int k = 0; k < 6; k++) {
+					double ck = (30 + 60 * k) * M_PI / 180;
+					vx[k] = 2 * cos(ck);
+					vy[k] = 2 * sin(ck);
+				}
+				lastK = -1;
+			}
+			if (lastK >= 0 && (bx != lastBx || by != lastBy) && abs(bx - lastBx) < 20 && abs(by - lastBy) < 20) {
+				vx[lastK] = 0.8 * vx[lastK] + 0.2 * (bx - lastBx);
+				vy[lastK] = 0.8 * vy[lastK] + 0.2 * (by - lastBy);
+			}
+			double n = sqrt((double)d2);
+			int bestK = 0;
+			double bestP = -1e9;
+			for (int k = 0; k < 6; k++) {
+				double p = (vx[k] * dx + vy[k] * dy) / (n > 0 ? n : 1);
+				if (k == lastK)
+					p += 0.15;	// un peu d'inertie : évite de changer de cap à chaque image
+				if (p > bestP) {
+					bestP = p;
+					bestK = k;
+				}
+			}
+			if (detour > 0) {
+				bestK = (bestK + (detour > 20 ? 1 : 5)) % 6;
+				detour--;
+			}
+			sameK = (bestK == lastK) ? sameK + 1 : 0;
+			lastK = bestK;
+			lastBx = bx;
+			lastBy = by;
+			double a = (30 + 60 * bestK) * M_PI / 180;
+			Common::Point o = b->getCachedAbsoluteOrigin();
+			int mx = CLIP<int>(o.x + 15 + (int)(70 * cos(a)), 0, 639), my = CLIP<int>(o.y + 15 + (int)(70 * sin(a)), 0, 479);
+			_runtime->onMouseMove(mx, my);
+			if (frames % 60 == 0) {
+				Common::String vs;
+				for (int k = 0; k < 6; k++)
+					vs += Common::String::format(" %d:(%.1f,%.1f)", 30 + 60 * k, vx[k], vy[k]);
+				debug("boatgo : caps appris%s", vs.c_str());
+			}
