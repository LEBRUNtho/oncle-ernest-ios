+// Sonde Album : une chaîne contenant un chemin d'objet (« /album42/tome1/.../zone sensible ») se résout en objet via .object
+static RuntimeObject *sondeResolveObjectPath(Runtime *runtime, const Common::String &path) {
+	Structural *project = runtime->getProject();
+	if (!project || path.empty() || path[0] != '/')
+		return nullptr;
+	Common::Array<Common::String> parts;
+	size_t start = 1;
+	while (start <= path.size()) {
+		size_t slash = path.find('/', start);
+		if (slash == Common::String::npos)
+			slash = path.size();
+		parts.push_back(path.substr(start, slash - start));
+		start = slash + 1;
+	}
+	if (parts.empty())
+		return nullptr;
+	// 1er élément = nom du projet ou <project>
+	if (!caseInsensitiveEqual(parts[0], project->getName()) && parts[0] != "<project>")
+		return nullptr;
+	Structural *cur = project;
+	for (uint i = 1; i < parts.size(); i++) {
+		Structural *next = nullptr;
+		for (const Common::SharedPtr<Structural> &child : cur->getChildren())
+			if (caseInsensitiveEqual(child->getName(), parts[i])) {
+				next = child.get();
+				break;
+			}
+		if (!next) {
+			// dernier segment : peut être un modificateur
+			if (i == parts.size() - 1)
+				for (const Common::SharedPtr<Modifier> &m : cur->getModifiers())
+					if (m && caseInsensitiveEqual(m->getName(), parts[i]))
+						return m.get();
+			return nullptr;
+		}
+		cur = next;
+	}
+	return cur;
+}
+
+bool StringVariableModifier::readAttribute(MiniscriptThread *thread, DynamicValue &result, const Common::String &attrib) {
+	if (attrib == "object") {
+		DynamicValue v;
+		varGetValue(v);
+		RuntimeObject *obj = (v.getType() == DynamicValueTypes::kString) ? sondeResolveObjectPath(thread->getRuntime(), v.getString()) : nullptr;
+		if (obj)
+			result.setObject(obj->getSelfReference());
+		else
+			result.clear();
+		return true;
+	}
+	return VariableModifier::readAttribute(thread, result, attrib);
+}
