+// Sonde Album : déplacement linéaire « sortie de scène » (vers l'extérieur de la fenêtre dans la direction choisie) ou
+// « entrée en scène » (depuis l'extérieur jusqu'à la position actuelle), en _steps pas espacés de _delayMSecTimes4800/4800 ms
+void SimpleMotionModifier::startLinear(Runtime *runtime) {
+	Structural *structural = findStructuralOwner();
+	Window *mainWindow = runtime->getMainWindow().lock().get();
+	if (!structural || !structural->isElement() || !static_cast<Element *>(structural)->isVisual() || !mainWindow)
+		return;
+	VisualElement *visual = static_cast<VisualElement *>(structural);
+	const Common::Point pos = visual->getGlobalPosition();
+	const Common::Rect rel = visual->getRelativeRect();
+	// Zone de référence = le parent visuel (comme la détection de bord de mTropolis), sinon la fenêtre ; on sort d'un pixel
+	// de plus, pour que « complètement dehors » soit vrai (bord < 0) et que le détecteur de bord se déclenche
+	int32 pw = mainWindow->getWidth(), ph = mainWindow->getHeight();
+	Common::Rect r = rel;
+	Structural *par = visual->getParent();
+	if (par && par->isElement() && static_cast<Element *>(par)->isVisual()) {
+		pw = static_cast<VisualElement *>(par)->getRelativeRect().width();
+		ph = static_cast<VisualElement *>(par)->getRelativeRect().height();
+	} else
+		r = Common::Rect(pos.x, pos.y, pos.x + rel.width(), pos.y + rel.height());
+	Common::Point exitOffset(0, 0);
+	if (_directionFlags & kDirectionFlagLeft)
+		exitOffset.x = -r.right - 1;
+	else if (_directionFlags & kDirectionFlagRight)
+		exitOffset.x = pw - r.left + 1;
+	if (_directionFlags & kDirectionFlagUp)
+		exitOffset.y = -r.bottom - 1;
+	else if (_directionFlags & kDirectionFlagDown)
+		exitOffset.y = ph - r.top + 1;
+
+	if (_motionType == kMotionTypeOutOfScene) {
+		_linStart = pos;
+		_linTotal = exitOffset;
+	} else {
+		// Entrée : on part de l'extérieur, côté opposé à la direction du mouvement
+		Common::Point entry(0, 0);
+		if (_directionFlags & kDirectionFlagRight)
+			entry.x = -r.right - 1;
+		else if (_directionFlags & kDirectionFlagLeft)
+			entry.x = pw - r.left + 1;
+		if (_directionFlags & kDirectionFlagDown)
+			entry.y = -r.bottom - 1;
+		else if (_directionFlags & kDirectionFlagUp)
+			entry.y = ph - r.top + 1;
+		_linStart = Common::Point(pos.x + entry.x, pos.y + entry.y);
+		_linTotal = Common::Point(-entry.x, -entry.y);
+		VisualElement::OffsetTranslateTaskData *taskData = runtime->getVThread().pushTask("VisualElement::offsetTranslateTask", visual, &VisualElement::offsetTranslateTask);
+		taskData->dx = entry.x;
+		taskData->dy = entry.y;
+	}
+	_linStep = 0;
+	_lastTickTime = runtime->getPlayTime();
+	_scheduledEvent = runtime->getScheduler().scheduleMethod<SimpleMotionModifier, &SimpleMotionModifier::runLinear>(_lastTickTime + 1, this);
+}
+
+void SimpleMotionModifier::runLinear(Runtime *runtime) {
+	_scheduledEvent.reset();
+	Structural *structural = findStructuralOwner();
+	if (!structural || !structural->isElement() || !static_cast<Element *>(structural)->isVisual())
+		return;
+	VisualElement *visual = static_cast<VisualElement *>(structural);
+	const uint steps = _steps ? _steps : 1;
+	const uint64 stepMs = _delayMSecTimes4800 / 4800u;
+	const uint64 now = runtime->getPlayTime();
+	uint target = steps;
+	if (stepMs > 0)
+		target = MIN<uint>(steps, _linStep + (uint)((now - _lastTickTime) / stepMs));
+	else
+		target = MIN<uint>(steps, _linStep + 1);
+	if (target > _linStep) {
+		if (stepMs > 0)
+			_lastTickTime += (target - _linStep) * stepMs;
+		_linStep = target;
+		Common::Point cur = visual->getGlobalPosition();
+		Common::Point dest(_linStart.x + _linTotal.x * (int32)_linStep / (int32)steps, _linStart.y + _linTotal.y * (int32)_linStep / (int32)steps);
+		if (dest != cur) {
+			if (visual->getHooks())
+				visual->getHooks()->onSetPosition(runtime, visual, cur, dest);
+			VisualElement::OffsetTranslateTaskData *taskData = runtime->getVThread().pushTask("VisualElement::offsetTranslateTask", visual, &VisualElement::offsetTranslateTask);
+			taskData->dx = dest.x - cur.x;
+			taskData->dy = dest.y - cur.y;
+		}
+	}
+	if (_linStep < steps)
+		_scheduledEvent = runtime->getScheduler().scheduleMethod<SimpleMotionModifier, &SimpleMotionModifier::runLinear>(now + 1, this);
+}
