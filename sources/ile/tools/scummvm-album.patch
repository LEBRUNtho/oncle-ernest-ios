+int Runtime::sondeLayoutShift(const VisualElement *v) {
+	if (!s_sondeLayoutCropBottom)
+		return 0;
+	const Structural *parent = v->getParent();
+	const Common::String &n = v->getName();
+	// nom du marque-page (au survol) : dessiné hors de l'image recadrée → masqué, l'iPhone l'affiche lui-même
+	if (n == "legende" && parent && parent->getName().size() >= 2 && parent->getName()[0] == 'p' && Common::isDigit(parent->getName()[1]))
+		return kSondeLayoutHidden;
+	const bool isTab = n.size() >= 2 && n.size() <= 3 && n[0] == 'p' && Common::isDigit(n[1]) && (n.size() == 2 || Common::isDigit(n[2]));
+	// menu iOS des marque-pages : les onglets du jeu ne sont plus dessinés (ni touchés, sauf pendant le clic du bouton iOS)
+	if (isTab && s_sondeTabMenu && parent && (parent->getName() == "zone_post_it" ||
+		parent->getName().hasPrefix("post_it_") || parent->getName().hasPrefix("new_post_it_")))	// jeu 2 : faux onglets de décor de la 1re page
+		return kSondeLayoutHidden;
+	// marque-pages du bas (pNN, bas du livre) remontés : leur bout restait dans la bande du geste « accueil » d'iOS (bord
+	// inférieur de l'écran) ; une marge noire les sépare maintenant du bord
+	if (isTab && v->getRelativeRect().top > 250)
+		return -kSondeBottomTabLift;
+	// objets et bestioles posés dans les marges noires à gauche et à droite du livre (cloportes du jeu 2, objets rangés) :
+	// ramenés dans la bande recadrée au lieu d'être coupés (enfants directs d'une scène : scène principale ou « share »)
+	// (sauf la barre d'outils du jeu, remplacée par les boutons iOS : traitée plus bas, cachée)
+	const bool sondeIsToolbar = parent && parent->getName() == "share" && (n == "magneto" || n == "appphotos_mt" || n == "arrosoir_mt" ||
+		n == "torche" || n == "marteau_pic" || n == "imprimante" || n == "help" || n == "help2" || n == "sortie-00.pct" || n == "gestion_volume" ||
+		n == "oil_bas" || n == "torche_bas" || n == "acide_bas" || n == "appphotos_bas" || n == "sortie" || n == "explosif_bas");	// jeu 3
+	if (!sondeIsToolbar && parent && parent->isElement() && parent->getParent() && !parent->getParent()->isElement() && n != "fondbarre.pct") {
+		const Common::Rect &r = v->getRelativeRect();
+		if ((r.right <= 80 || r.left >= 560) && r.height() < 200) {
+			if (r.bottom > s_sondeLayoutCropBottom && r.top < s_sondeLayoutCropBottom)
+				return s_sondeLayoutCropBottom - r.bottom;
+			if (s_sondeLayoutCropTop && r.top < s_sondeLayoutCropTop && r.bottom > s_sondeLayoutCropTop)
