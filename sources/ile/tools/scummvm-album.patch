diff --git a/engines/mtropolis/assets.cpp b/engines/mtropolis/assets.cpp
index 45f82294aa..365b2d41cd 100644
--- a/engines/mtropolis/assets.cpp
+++ b/engines/mtropolis/assets.cpp
@@ -1113,6 +1113,42 @@ const Common::SharedPtr<CachedImage> &ImageAsset::loadAndCacheImage(Runtime *run
 	}
 
 	_imageCache.reset(new CachedImage());
+	// Sonde Album : jeux Ernest : pixels isolés d'index 246-254 (plage réservée aux couleurs système de Windows, rouge vif
+	// dans la palette du jeu) semés par la conversion en 256 couleurs (points rouges sur le dialogue Quitter du jeu 2) :
+	// un pixel de cette plage qu'aucun voisin ne partage prend l'index le plus fréquent de ses 4 voisins
+	if (getColorDepth() == kColorDepthMode8Bit && runtime->getHacks().sondeTransitionDivisor > 1) {
+		uint fixed = 0;
+		const int w = imageSurface->w, h = imageSurface->h;
+		for (int pass = 0; pass < 2; pass++)	// 2 passes : les paires de points isolés (1 voisin identique) aussi
+		for (int y = 1; y < h - 1; y++) {
+			for (int x = 1; x < w - 1; x++) {
+				byte *p = static_cast<byte *>(imageSurface->getBasePtr(x, y));
+				if (*p < 246 || *p > 254)
+					continue;
+				const byte n[4] = {*(p - 1), *(p + 1), *static_cast<byte *>(imageSurface->getBasePtr(x, y - 1)), *static_cast<byte *>(imageSurface->getBasePtr(x, y + 1))};
+				const int same = (n[0] == *p) + (n[1] == *p) + (n[2] == *p) + (n[3] == *p);
+				if (same > 1)
+					continue;
+				byte best = n[0];
+				int bestCount = 0;
+				for (int i = 0; i < 4; i++) {
+					if (n[i] == *p)
+						continue;
+					int c = 0;
+					for (int j = 0; j < 4; j++)
+						c += (n[j] == n[i]) ? 1 : 0;
+					if (c > bestCount) {
+						bestCount = c;
+						best = n[i];
+					}
+				}
+				*p = best;
+				fixed++;
+			}
+		}
+		if (fixed)
+			debug(1, "sonde image %u : %u points isolés de la plage système corrigés", getAssetID(), fixed);
+	}
 	_imageCache->resetSurface(getColorDepth(), imageSurface);
 
 	return _imageCache;
