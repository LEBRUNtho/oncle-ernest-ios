+- (void)albumSetTools:(NSString *)tools legend:(NSString *)legend tabs:(NSString *)tabs gameRect:(CGRect)rect {
+	[self albumCreateButtons];
+	_albumGameRect = rect;
+	[self albumSetTabs:tabs];
+	[self albumShowLegend:legend];
+	// Comme la barre du jeu (outil en couleur au survol de la souris) : icône grise « nom_gris » au repos, en couleur
+	// pendant l'appui du doigt (état « surligné » du bouton)
+	// « nom* » = outil en main : bouton allumé (image couleur, état « sélectionné »)
+	NSMutableArray<NSString *> *visible = [NSMutableArray array];
+	NSString *activeTool = nil;
+	for (NSString *t in (tools.length ? [tools componentsSeparatedByString:@","] : @[])) {
+		if ([t hasSuffix:@"*"]) {
+			activeTool = [t substringToIndex:t.length - 1];
+			[visible addObject:activeTool];
+		} else {
+			[visible addObject:t];
+		}
+	}
+	if (!_albumIconsLoaded) {
+		_albumIconsLoaded = YES;
+		NSArray<NSString *> *names = albumToolNames();
+		for (UIButton *b in _albumButtons) {
+			NSString *n = names[(NSUInteger)b.tag];
+			UIImage *color = [self albumIconForTool:n fallback:YES];
+			UIImage *grey = [self albumIconForTool:[n stringByAppendingString:@"_gris"] fallback:NO];
+			[b setImage:(grey ? grey : color) forState:UIControlStateNormal];
+			[b setImage:color forState:UIControlStateHighlighted];
+			[b setImage:color forState:UIControlStateSelected];
+			[b setImage:color forState:(UIControlStateSelected | UIControlStateHighlighted)];
+			b.adjustsImageWhenHighlighted = NO;
+		}
+	}
+	{
+		NSArray<NSString *> *names = albumToolNames();
+		for (UIButton *b in _albumButtons)
+			b.selected = [names[(NSUInteger)b.tag] isEqualToString:activeTool];
+	}
+	[_albumVisibleTools release];
+	_albumVisibleTools = [visible retain];
+	_albumGameRect = rect;
+	[self albumLayoutButtons];
+}
+
+// Outils dans la bande de gauche (magnétophone en haut), Sortie seule dans la bande de droite ; boutons centrés
+// verticalement, taille selon la place disponible (tous les iPhone)
+- (void)albumLayoutButtons {
+	if (!_albumButtons)
+		return;
+	const CGFloat s = self.contentScaleFactor;
+	const CGRect g = CGRectMake(_albumGameRect.origin.x / s, _albumGameRect.origin.y / s, _albumGameRect.size.width / s, _albumGameRect.size.height / s);
+	const UIEdgeInsets safe = self.safeAreaInsets;
+	const CGRect bounds = self.bounds;
+	const CGRect leftBand = CGRectMake(safe.left, safe.top, MAX(0, CGRectGetMinX(g) - safe.left), bounds.size.height - safe.top - safe.bottom);
+	const CGFloat rightX = CGRectGetMaxX(g);
+	const CGRect rightBand = CGRectMake(rightX, safe.top, MAX(0, bounds.size.width - safe.right - rightX), bounds.size.height - safe.top - safe.bottom);
+
+	// Noms des marque-pages : le moteur a besoin de savoir combien de lignes du jeu afficher pour laisser une bande de
+	// 110 points à droite (outils à gauche sur 48 points) ; envoyé quand la géométrie change
+	{
+		const CGFloat avail = bounds.size.width - safe.left - safe.right - 48 - 110;
+		int lines = (avail > 100) ? (int)ceil(bounds.size.height * 640.0 / avail) : 480;
+		lines = MAX(406, MIN(480, lines));
+		if (lines != _albumTabLinesSent) {
+			_albumTabLinesSent = lines;
+			[self addEvent:InternalEvent(kInputAlbumLayout, lines, 0)];
+		}
+	}
+	// mesures (journal) : taille de la vue, zone sûre, image du jeu et bandes, en points
+	NSLog(@"Sonde Album: vue %.0fx%.0f sûre g%.0f d%.0f h%.0f b%.0f jeu x%.1f y%.1f %.1fx%.1f bandes gauche %.1f droite %.1f",
+		bounds.size.width, bounds.size.height, safe.left, safe.right, safe.top, safe.bottom, g.origin.x, g.origin.y, g.size.width, g.size.height,
+		leftBand.size.width, rightBand.size.width);
+	NSArray<NSString *> *names = albumToolNames();
+	NSMutableArray<UIButton *> *left = [NSMutableArray array], *right = [NSMutableArray array];
+	for (UIButton *b in _albumButtons) {
+		NSString *name = names[(NSUInteger)b.tag];
+		const BOOL visible = [_albumVisibleTools containsObject:name];
+		b.hidden = !visible;
+		if (visible)
+			[(([name isEqualToString:@"sortie-00.pct"] || [name isEqualToString:@"sortie"]) ? right : left) addObject:b];
+	}
+	void (^stack)(NSArray<UIButton *> *, CGRect) = ^(NSArray<UIButton *> *buttons, CGRect band) {
+		if (!buttons.count)
+			return;
+		if (band.size.width < 30) {	// pas de place (écran presque 4:3) : on laisse la barre du jeu
+			for (UIButton *b in buttons)
+				b.hidden = YES;
+			return;
+		}
+		CGFloat size = MIN(band.size.width * 0.72, 76);
+		const CGFloat gap = size * 0.25;
+		if (buttons.count * size + (buttons.count - 1) * gap > band.size.height * 0.94)
+			size = band.size.height * 0.94 / (buttons.count * 1.25);
+		const CGFloat total = buttons.count * size + (buttons.count - 1) * size * 0.25;
+		CGFloat y = CGRectGetMidY(band) - total / 2;
+		for (UIButton *b in buttons) {
+			b.frame = CGRectMake(CGRectGetMidX(band) - size / 2, y, size, size);
+			y += size * 1.25;
+		}
+	};
+	stack(left, leftBand);
+	if (_albumTabScroll && !_albumTabScroll.hidden && rightBand.size.width >= 30) {
+		// Sortie en bas de la bande de droite, le menu des marque-pages au-dessus
+		CGFloat exitTop = CGRectGetMaxY(rightBand);
+		if (right.count) {
+			const CGFloat size = MIN(rightBand.size.width * 0.72, 56);
+			UIButton *b = right[0];
+			b.frame = CGRectMake(CGRectGetMidX(rightBand) - size / 2, CGRectGetMaxY(rightBand) - size - 6, size, size);
+			exitTop = CGRectGetMinY(b.frame);
+		}
+		const CGRect area = CGRectMake(rightBand.origin.x, rightBand.origin.y + 4, rightBand.size.width, MAX(0, exitTop - 8 - rightBand.origin.y - 4));
+		[self albumLayoutTabsIn:area];
+	} else {
+		stack(right, rightBand);
+	}
+	// Les bandes appartenant désormais au jeu : pas de boutons ScummVM (souris / menu) par-dessus
+	if (_albumVisibleTools.count) {
+		[_toggleTouchModeButton setHidden:YES];
+		[_menuButton setHidden:YES];
+	}
+}
+
+// Sonde Album : menu des marque-pages dans la zone donnée : bande large (≥ 100 pt) = une colonne avec les noms en
+// capitales ; bande étroite = onglets seuls, sur 1 ou 2 colonnes, rangées réduites pour tout montrer si possible, sinon
+// la liste défile. La page courante est surlignée et amenée à la vue.
+- (void)albumLayoutTabsIn:(CGRect)area {
+	_albumTabScroll.frame = area;
+	const NSUInteger n = _albumTabs.count;
+	if (!n)
+		return;
+	const BOOL names = area.size.width >= 100;
+	// largeur d'un onglet pour une hauteur donnée (image la plus large)
+	CGFloat aspect = 1.2;
+	for (NSDictionary *t in _albumTabs) {
+		UIImage *img = [self albumTabIcon:t[@"name"] bottom:[t[@"bottom"] boolValue]];
+		if (img.size.height > 0)
+			aspect = MAX(aspect, img.size.width / img.size.height);
+	}
+	NSUInteger cols = 1;
+	CGFloat rowH = 30;
+	if (!names) {
+		const CGFloat iconW = (rowH - 6) * aspect;
+		cols = (area.size.width >= 2 * iconW + 6) ? 2 : 1;
+		const NSUInteger rows = (n + cols - 1) / cols;
+		rowH = MIN(30, MAX(22, floor(area.size.height / rows)));
+	}
+	const NSUInteger rows = (n + cols - 1) / cols;
+	const CGFloat colW = floor(area.size.width / cols);
+	const CGFloat iconH = rowH - 6;
+	for (NSUInteger i = 0; i < n; i++) {
+		UIButton *b = _albumTabButtons[i];
+		const NSUInteger r = names ? i : i / cols, c = names ? 0 : i % cols;
+		b.frame = CGRectMake(c * colW, r * rowH, colW, rowH);
+		NSDictionary *t = _albumTabs[i];
+		UIImage *img = [self albumTabIcon:t[@"name"] bottom:[t[@"bottom"] boolValue]];
+		const CGFloat iw = (img.size.height > 0) ? iconH * img.size.width / img.size.height : iconH;
+		if (names) {
+			const BOOL vis = [t[@"vis"] boolValue];
+			NSString *title = vis ? [t[@"title"] uppercaseStringWithLocale:[NSLocale localeWithLocaleIdentifier:@"fr_FR"]] : @"";
+			[b setTitle:title forState:UIControlStateNormal];
+			// mot le plus long : police réduite pour qu'il tienne sur une ligne (« LABORATOIRE »)
+			// taille choisie d'après la largeur réelle du mot le plus long (« PLANISPHÈRE » passait à la ligne en 8,5)
+			const CGFloat maxIconW = iconH * aspect;
+			const CGFloat availW = colW - (8 + maxIconW) - 3 - 4;
+			CGFloat fontSize = 9.5;
+			for (; fontSize > 6.5; fontSize -= 0.5) {
+				UIFont *f = [UIFont systemFontOfSize:fontSize weight:UIFontWeightBold];
+				CGFloat widest = 0;
+				for (NSString *word in [title componentsSeparatedByString:@" "])
+					widest = MAX(widest, [word sizeWithAttributes:@{NSFontAttributeName: f}].width);
+				if (widest <= availW)
+					break;
+			}
+			b.titleLabel.font = [UIFont systemFontOfSize:fontSize weight:UIFontWeightBold];
+			b.contentHorizontalAlignment = UIControlContentHorizontalAlignmentLeft;
+			b.imageEdgeInsets = UIEdgeInsetsMake(0, 3 + (maxIconW - iw) / 2, 0, 0);
+			b.titleEdgeInsets = UIEdgeInsetsMake(0, 8 + (maxIconW - iw) / 2, 0, 3);
+		} else {
+			[b setTitle:@"" forState:UIControlStateNormal];
+			b.contentHorizontalAlignment = UIControlContentHorizontalAlignmentCenter;
+			b.imageEdgeInsets = UIEdgeInsetsZero;
+			b.titleEdgeInsets = UIEdgeInsetsZero;
+		}
+		b.imageView.frame = CGRectMake(0, 0, iw, iconH);
+	}
+	const CGSize content = CGSizeMake(area.size.width, rows * rowH);
+	if (!CGSizeEqualToSize(content, _albumTabContentSize)) {
+		_albumTabContentSize = content;
+		_albumTabsChanged = YES;	// nouvelle géométrie : ramener la page courante à la vue
+	}
+	_albumTabScroll.contentSize = content;
+	if (_albumTabsChanged) {
+		_albumTabsChanged = NO;
+		if (_albumTabCurrent >= 0 && (NSUInteger)_albumTabCurrent < n)
+			[_albumTabScroll scrollRectToVisible:_albumTabButtons[(NSUInteger)_albumTabCurrent].frame animated:NO];
+	}
+}
+
+// Sonde Album : un appui (long) sur un bouton des bandes ne doit pas aussi devenir un clic/appui long dans le jeu
+- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)gestureRecognizer {
+	const CGPoint p = [gestureRecognizer locationInView:self];
+	for (UIButton *b in _albumButtons)
+		if (!b.hidden && CGRectContainsPoint(b.frame, p))
+			return NO;
+	if (_albumTabScroll && !_albumTabScroll.hidden && CGRectContainsPoint(_albumTabScroll.frame, p))
+		return NO;
+	return [super gestureRecognizerShouldBegin:gestureRecognizer];
 }
 #endif
 
