+// Sonde Album : chemin de la page n° num (l_pages.chemin, liste de la scène partagée, numérotée à partir de 1)
+static Common::String sondePagePath(Runtime *rt, int num) {
+	const Common::SharedPtr<Structural> &shared = rt->getActiveSharedScene();
+	if (!shared || num < 1)
+		return Common::String();
+	for (const Common::SharedPtr<Modifier> &m : shared->getModifiers()) {
+		if (!m || m->getName() != "l_pages")
+			continue;
+		IModifierContainer *c = m->getChildContainer();
+		if (!c)
+			continue;
+		for (const Common::SharedPtr<Modifier> &cm : c->getModifiers()) {
+			if (!cm || cm->getName() != "chemin")
+				continue;
+			// liste du plugin Standard : la valeur de la variable est une référence, le contenu est dans son stockage
+			Standard::ListVariableModifier *lv = dynamic_cast<Standard::ListVariableModifier *>(cm.get());
+			DynamicValue e;
+			if (lv && lv->sondeGetAt(num - 1, e) && e.getType() == DynamicValueTypes::kString)
+				return e.getString();
+		}
+	}
