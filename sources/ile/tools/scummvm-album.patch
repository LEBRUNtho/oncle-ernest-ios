+MiniscriptInstructionOutcome CompoundVariableModifier::sondeCreateMember(MiniscriptThread *thread, const DynamicValue &value) {
+	Common::SharedPtr<Modifier> mod;
+	switch (value.getType()) {
+	case DynamicValueTypes::kInteger: mod.reset(new IntegerVariableModifier()); break;
+	case DynamicValueTypes::kString: mod.reset(new StringVariableModifier()); break;
+	case DynamicValueTypes::kPoint: mod.reset(new PointVariableModifier()); break;
+	case DynamicValueTypes::kBoolean: mod.reset(new BooleanVariableModifier()); break;
+	case DynamicValueTypes::kFloat: mod.reset(new FloatingPointVariableModifier()); break;
+	default:
+		warning("Sonde Album : membre '%s' de la variable composée '%s' absent, type de valeur %d non géré", _sondePendingMember.c_str(), getName().c_str(), (int)value.getType());
+		return kMiniscriptInstructionOutcomeFailed;
+	}
+	mod->setName(_sondePendingMember);
+	mod->setSelfReference(mod);
+	mod->setRuntimeGUID(thread->getRuntime()->allocateRuntimeGUID());
+	appendModifier(mod);
+	debug(1, "Sonde Album : membre '%s' créé dans la variable composée '%s' #%x (type %d)", _sondePendingMember.c_str(), getName().c_str(), getStaticGUID(), (int)value.getType());
+	return static_cast<VariableModifier *>(mod.get())->varSetValue(thread, value) ? kMiniscriptInstructionOutcomeContinue : kMiniscriptInstructionOutcomeFailed;
