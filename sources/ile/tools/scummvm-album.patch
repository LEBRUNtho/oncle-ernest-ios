+static Modifier *sondeFindVarInContainer(const Common::Array<Common::SharedPtr<Modifier> > &mods, const Common::String &name) {
+	for (const Common::SharedPtr<Modifier> &m : mods) {
+		if (!m)
+			continue;
+		if (m->isVariable() && caseInsensitiveEqual(m->getName(), name))
+			return m.get();
