+
+bool RotatorKModifier::load(const PlugInModifierLoaderContext &context, const Data::Hoologic::RotatorKModifier &data) {
+	_rawData = data.rawData;
+
+	// Tentative de décodage : suite de valeurs typées comme les autres plugins
+	Common::String decoded;
+	int eventIndex = 0;
+	bool haveInt = false;
+	if (!_rawData.empty()) {
+		Common::MemoryReadStream stream(&_rawData[0], _rawData.size());
+		Data::DataReader reader(0, stream, data.isMacFormat ? Data::kDataFormatMacintosh : Data::kDataFormatWindows, kRuntimeVersion112, false);
+		for (int k = 0; k < 40 && stream.pos() < (int64)_rawData.size(); k++) {
+			Data::PlugInTypeTaggedValue v;
+			int64 before = stream.pos();
+			if (!v.load(reader)) {
+				decoded += Common::String::format(" <stop@%d>", (int)before);
+				break;
+			}
+			switch (v.type) {
+			case Data::PlugInTypeTaggedValue::kInteger:
+				decoded += Common::String::format(" int:%d", v.value.asInt);
+				if (!haveInt) {
+					_startAngle = v.value.asInt;
+					haveInt = true;
+				}
+				break;
+			case Data::PlugInTypeTaggedValue::kBoolean: decoded += Common::String::format(" bool:%d", v.value.asBoolean); break;
+			case Data::PlugInTypeTaggedValue::kFloat: decoded += Common::String::format(" float:%g", v.value.asFloat.toXPFloat().toDouble()); break;
+			case Data::PlugInTypeTaggedValue::kPoint:
+				decoded += Common::String::format(" point:(%d,%d)", v.value.asPoint.x, v.value.asPoint.y);
+				if (!_haveAxis) {
+					_axisOffset = Common::Point(v.value.asPoint.x, v.value.asPoint.y);
+					_haveAxis = true;
+				}
+				break;
+			case Data::PlugInTypeTaggedValue::kEvent:
+				decoded += Common::String::format(" event:%x/%x", v.value.asEvent.eventID, v.value.asEvent.eventInfo);
+				if (eventIndex == 0)
+					_evtStart.load(v.value.asEvent);
+				else if (eventIndex == 1)
+					_evtStop.load(v.value.asEvent);
+				eventIndex++;
+				break;
+			case Data::PlugInTypeTaggedValue::kVariableReference: decoded += Common::String::format(" varref:#%x", v.value.asVarRefGUID); break;
+			case Data::PlugInTypeTaggedValue::kString: decoded += " str:\"" + v.value.asString + "\""; break;
+			case Data::PlugInTypeTaggedValue::kNull: decoded += " null"; break;
+			default: decoded += Common::String::format(" type%x", v.type); break;
+			}
+		}
+	}
+	Common::String hex;
+	for (uint k = 0; k < _rawData.size() && k < 160; k++)
+		hex += Common::String::format("%02x", _rawData[k]);
+	debug(1, "rotatork load %s '%s' #%x size %u :%s | %s", _kind, getName().c_str(), getStaticGUID(), (unsigned)_rawData.size(), decoded.c_str(), hex.c_str());
+	return true;
+}
+
+bool RotatorKModifier::respondsToEvent(const Event &evt) const {
+	// Ne jamais se déclarer sensible à la souris sans raison : sinon l'élément porteur devient « cliquable »
+	// et intercepte les clics destinés à son parent (ex. l'animation de la coccinelle au-dessus de la coccinelle).
+	bool isMouse = (evt.eventType >= EventIDs::kMouseDown && evt.eventType <= EventIDs::kMouseUpOutside);
+	if (strcmp(_kind, "Tracker") == 0)
+		return evt.eventType == EventIDs::kMouseTracking || _evtStart.respondsTo(evt) || _evtStop.respondsTo(evt);
+	if (isMouse)
+		return false;
+	return true;	// messages de l'auteur / Play / etc. : journalisés
+}
+
+// Applique un angle au Rotator (attribut « angle » + rendu pivoté de l'élément visuel porteur)
+// Convention (déduite des cadrans du laboratoire : angle de départ 270 = aiguille vers le haut) : angle absolu en degrés,
+// sens horaire à l'écran (y vers le bas) ; l'image au repos correspond à l'angle de départ ; rendu = rotation de
+// (angle - départ) dans le sens horaire (sondeRotationDeg est en sens trigonométrique, d'où le signe).
+void RotatorKModifier::sondeApplyAngle(Runtime *runtime, double deg) {
+	DynamicValue v;
+	v.setFloat(deg);
+	_attribs["angle"] = v;
+	// 27/09 (jeu 3) : rendu = rotation RELATIVE (angle - départ), l'image au repos est dessinée telle quelle (les cadrans
+	// du jeu 1, départ 270, gardent leur aiguille vers le haut ; 45 Rotators du jeu 1 et 20 du jeu 2 ont un départ non nul),
+	// dans le sens TRIGONOMÉTRIQUE à l'écran : c'est ce qu'exigent le script de la longue-vue (check_mouse_down, jeu 3 :
+	// direction du tube = angle + 90 en repère mathématique ; soluce « tourner vers le nord-ouest ») et celui qui oriente les
+	// animaux vers la souris (angle := -pt2vec(souris - position).angle, repère écran). L'ancien sens horaire était un miroir.
+	// Réglage de test « sonde_rot_cw=true » : ancien sens, pour comparer.
+	deg = deg - _startAngle;
+	if (ConfMan.hasKey("sonde_rot_cw") && ConfMan.getBool("sonde_rot_cw"))
+		deg = -deg;
+	RuntimeObject *obj = getParent().lock().get();
+	while (obj && !(obj->isStructural() && static_cast<Structural *>(obj)->isElement() && static_cast<Element *>(static_cast<Structural *>(obj))->isVisual()))
+		obj = obj->isModifier() ? static_cast<Modifier *>(obj)->getParent().lock().get() : (obj->isStructural() ? static_cast<Structural *>(obj)->getParent() : nullptr);
+	if (obj) {
+		static_cast<VisualElement *>(obj)->sondeRotationDeg = fmod(deg, 360.0);
+		if (runtime->getHacks().sondeRelayLastObject)	// Sonde Album : pivot décalé, jeu 3 seulement (jeux 1 et 2 inchangés)
+			static_cast<VisualElement *>(obj)->sondeRotAxis = _axisOffset;
+		runtime->setSceneGraphDirty();
+	}
+}
+
+// Sonde Album : « tourner.size » réduit l'objet (transition vers le bord de l'album) : mémorisé sur l'élément tourné
+void RotatorKModifier::sondeApplySize(const Common::Point &pt) {
+	RuntimeObject *obj = getParent().lock().get();
+	while (obj && !(obj->isStructural() && static_cast<Structural *>(obj)->isElement() && static_cast<Element *>(static_cast<Structural *>(obj))->isVisual()))
+		obj = obj->isModifier() ? static_cast<Modifier *>(obj)->getParent().lock().get() : (obj->isStructural() ? static_cast<Structural *>(obj)->getParent() : nullptr);
+	if (obj) {
+		VisualElement *v = static_cast<VisualElement *>(obj);
+		v->sondeRotSize = pt;
+	}
+}
+
+VThreadState RotatorKModifier::consumeMessage(Runtime *runtime, const Common::SharedPtr<MessageProperties> &msg) {
+	RuntimeObject *parent = getParent().lock().get();
+	// Sonde Album : l'élément porteur d'un Rotator est dessiné par celui-ci (fond transparent)
+	if (strcmp(_kind, "Rotator") == 0) {
+		// remonter jusqu'à l'élément visuel (le Rotator peut être dans un comportement)
+		RuntimeObject *o = parent;
+		while (o && !(o->isStructural() && static_cast<Structural *>(o)->isElement() && static_cast<Element *>(o)->isVisual()))
+			o = o->isModifier() ? static_cast<Modifier *>(o)->getParent().lock().get() : (o->isStructural() ? static_cast<Structural *>(o)->getParent() : nullptr);
+		if (o && !static_cast<VisualElement *>(o)->sondeHasRotator) {
+			static_cast<VisualElement *>(o)->sondeHasRotator = true;
+			runtime->setSceneGraphDirty();
+		}
+	}
+	const char *parentName = (parent && parent->isStructural()) ? static_cast<Structural *>(parent)->getName().c_str() : "?";
+	if (msg->getEvent().eventType != EventIDs::kMouseTracking)
+		debug(1, "rotatork event %s '%s' #%x on '%s': (%d,%d) data type %d", _kind, getName().c_str(), getStaticGUID(), parentName, (int)msg->getEvent().eventType, msg->getEvent().eventInfo, (int)msg->getValue().getType());
+
+	// Sonde Album : Tracker = fait tourner le Rotator voisin pour suivre la souris pendant le glisser (version provisoire)
+	if (strcmp(_kind, "Tracker") == 0) {
+		if (_evtStart.respondsTo(msg->getEvent()))
+			_tracking = true;
+		else if (_evtStop.respondsTo(msg->getEvent()))
+			_tracking = false;
+
+		if (_tracking) {
+			RuntimeObject *obj = parent;
+			while (obj && !(obj->isStructural() && static_cast<Structural *>(obj)->isElement() && static_cast<Element *>(static_cast<Structural *>(obj))->isVisual()))
+				obj = obj->isModifier() ? static_cast<Modifier *>(obj)->getParent().lock().get() : (obj->isStructural() ? static_cast<Structural *>(obj)->getParent() : nullptr);
+			IModifierContainer *container = (parent && parent->isModifier()) ? static_cast<Modifier *>(parent)->getChildContainer() : nullptr;
+			if (!container && parent && parent->isStructural())
+				container = static_cast<Structural *>(parent);
+			RotatorKModifier *rot = nullptr;
+			if (container)
+				for (const Common::SharedPtr<Modifier> &m : container->getModifiers())
+					if (RotatorKModifier *r = dynamic_cast<RotatorKModifier *>(m.get()))
+						if (strcmp(r->_kind, "Rotator") == 0)
+							rot = r;
+			if (obj && rot) {
+				VisualElement *ve = static_cast<VisualElement *>(obj);
+				const Common::Point &o = ve->getCachedAbsoluteOrigin();
+				double cx = o.x + ve->getRelativeRect().width() / 2.0;
+				double cy = o.y + ve->getRelativeRect().height() / 2.0;
+				Common::Point m = runtime->getCachedMousePosition();
+				// 27/09 : suivi ABSOLU (comme FUN_10008240 de la décompilation, qui ne mémorise rien) : l'objet pointe vers la
+				// souris, l'image au repos étant supposée pointer vers le HAUT à l'angle de départ : angle = départ + (angle
+				// mathématique de la souris - 90). Seule formule compatible à la fois avec les cadrans du jeu 1 (départ 270,
+				// cible 90 = aiguille vers le bas) et la longue-vue du jeu 3 (départ 0, 30 = nord-ouest, script check_mouse_down).
+				double mdeg = atan2(-(m.y - cy), m.x - cx) * 180.0 / M_PI;
+				double deg = rot->_startAngle + (mdeg - 90.0);
+				deg = fmod(deg, 360.0);
+				if (deg < 0)
+					deg += 360.0;
+				rot->sondeApplyAngle(runtime, floor(deg + 0.5));
+			}
+		}
+	}
+	return kVThreadReturn;
+}
+
+bool RotatorKModifier::readAttribute(MiniscriptThread *thread, DynamicValue &result, const Common::String &attrib) {
+	Common::HashMap<Common::String, DynamicValue>::const_iterator it = _attribs.find(attrib);
+	if (it != _attribs.end())
+		result = it->_value;
+	else if (attrib == "angle")
+		result.setInt(_startAngle);
+	else if (attrib == "size" || attrib == "position") {
+		// Sonde Album : taille/position par défaut = celles de l'élément tourné (point attendu par les scripts)
+		Structural *owner = findStructuralOwner();
+		Common::Point pt(0, 0);
+		if (owner && owner->isElement() && static_cast<Element *>(owner)->isVisual()) {
+			const Common::Rect &r = static_cast<VisualElement *>(owner)->getRelativeRect();
+			pt = (attrib == "size") ? Common::Point(r.width(), r.height()) : Common::Point(r.left, r.top);
+		}
+		result.setPoint(pt);
+	}
+	else if (Modifier::readAttribute(thread, result, attrib))
+		return true;
+	else
+		result.setInt(0);
+	debug(1, "rotatork read %s '%s'.%s -> type %d", _kind, getName().c_str(), attrib.c_str(), (int)result.getType());
+	return true;
+}
+
+MiniscriptInstructionOutcome RotatorKModifier::writeRefAttribute(MiniscriptThread *thread, DynamicValueWriteProxy &result, const Common::String &attrib) {
+	if (Modifier::writeRefAttribute(thread, result, attrib) == kMiniscriptInstructionOutcomeContinue)
+		return kMiniscriptInstructionOutcomeContinue;
+	_pendingWriteAttrib = attrib;
+	DynamicValueWriteOrRefAttribFuncHelper<RotatorKModifier, &RotatorKModifier::scriptSetAttrib, &RotatorKModifier::scriptWriteRefAttribSub>::create(this, result);
+	return kMiniscriptInstructionOutcomeContinue;
+}
+
+MiniscriptInstructionOutcome RotatorKModifier::scriptSetAttrib(MiniscriptThread *thread, const DynamicValue &value) {
+	_attribs[_pendingWriteAttrib] = value;
+	if (_pendingWriteAttrib == "size" && value.getType() == DynamicValueTypes::kPoint)
+		sondeApplySize(value.getPoint());
+	if (_pendingWriteAttrib == "angle") {
+		double deg = 0.0;
+		if (value.getType() == DynamicValueTypes::kInteger)
+			deg = value.getInt();
+		else if (value.getType() == DynamicValueTypes::kFloat)
+			deg = value.getFloat();
+		sondeApplyAngle(thread->getRuntime(), deg);
+		_attribs["angle"] = value;
+	}
+	Common::String v;
+	switch (value.getType()) {
+	case DynamicValueTypes::kInteger: v = Common::String::format("%d", value.getInt()); break;
+	case DynamicValueTypes::kFloat: v = Common::String::format("%g", value.getFloat()); break;
+	case DynamicValueTypes::kBoolean: v = value.getBool() ? "true" : "false"; break;
+	case DynamicValueTypes::kPoint: v = Common::String::format("(%d,%d)", value.getPoint().x, value.getPoint().y); break;
+	default: v = Common::String::format("type %d", (int)value.getType()); break;
+	}
+	debug(1, "rotatork write %s '%s'.%s := %s", _kind, getName().c_str(), _pendingWriteAttrib.c_str(), v.c_str());
+	return kMiniscriptInstructionOutcomeContinue;
+}
+
+MiniscriptInstructionOutcome RotatorKModifier::scriptWriteRefAttribSub(MiniscriptThread *thread, DynamicValueWriteProxy &proxy, const Common::String &attrib) {
+	if (attrib != "x" && attrib != "y")
+		return kMiniscriptInstructionOutcomeFailed;
+	_pendingSubAttrib = attrib;
+	DynamicValueWriteFuncHelper<RotatorKModifier, &RotatorKModifier::scriptSetAttribSub, true>::create(this, proxy);
+	return kMiniscriptInstructionOutcomeContinue;
+}
+
+MiniscriptInstructionOutcome RotatorKModifier::scriptSetAttribSub(MiniscriptThread *thread, const DynamicValue &value) {
+	int32 v = 0;
+	if (!value.roundToInt(v))
+		return kMiniscriptInstructionOutcomeFailed;
+	Common::Point pt(0, 0);
+	Common::HashMap<Common::String, DynamicValue>::const_iterator it = _attribs.find(_pendingWriteAttrib);
+	if (it != _attribs.end() && it->_value.getType() == DynamicValueTypes::kPoint)
+		pt = it->_value.getPoint();
+	else {
+		DynamicValue cur;
+		if (readAttribute(thread, cur, _pendingWriteAttrib) && cur.getType() == DynamicValueTypes::kPoint)
+			pt = cur.getPoint();
+	}
+	if (_pendingSubAttrib == "x")
+		pt.x = v;
+	else
+		pt.y = v;
+	DynamicValue nv;
+	nv.setPoint(pt);
+	_attribs[_pendingWriteAttrib] = nv;
+	if (_pendingWriteAttrib == "size")
+		sondeApplySize(pt);
+	debug(2, "rotatork write %s '%s'.%s.%s := %d", _kind, getName().c_str(), _pendingWriteAttrib.c_str(), _pendingSubAttrib.c_str(), v);
+	return kMiniscriptInstructionOutcomeContinue;
+}
+
+Common::SharedPtr<Modifier> RotatorKModifier::shallowClone() const {
+	return Common::SharedPtr<Modifier>(new RotatorKModifier(*this));
+}
+
+const char *RotatorKModifier::getDefaultName() const {
+	return _kind;
+}
