 VThreadState ScaleBitmapModifier::consumeMessage(Runtime *runtime, const Common::SharedPtr<MessageProperties> &msg) {
+	sondeLog("scale", msg);
+	BitmapVariableModifier *var = resolveBitmapVar(0);
+	DynamicValue size = _size.produceValue(msg->getValue());
+	if (var && var->getBitmap() && size.getType() == DynamicValueTypes::kPoint) {
+		int16 w = size.getPoint().x;
+		int16 h = size.getPoint().y;
+		debug(1, "hoologic scale '%s' -> %dx%d (mode %d)", var->getName().c_str(), w, h, _mode);
+		// Sonde Album (revue Fable B5) : taille bornée, une valeur aberrante venue d'un script ne doit pas allouer des Go
+		if (w > 0 && h > 0 && w <= 2048 && h <= 2048) {
+			Common::SharedPtr<Graphics::ManagedSurface> src = var->getBitmap();
+			Common::SharedPtr<Graphics::ManagedSurface> dst(new Graphics::ManagedSurface());
+			dst->create(w, h, src->format);
+			for (int y = 0; y < h; y++) {
+				int sy = y * src->h / h;
+				for (int x = 0; x < w; x++) {
+					int sx = x * src->w / w;
+					dst->setPixel(x, y, src->getPixel(sx, sy));
+				}
+			}
+			var->setBitmap(dst);
+		}
+	}
 	return kVThreadReturn;
 }
 
