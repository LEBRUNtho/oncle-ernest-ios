+	NSString *l = [NSString stringWithUTF8String:legend.c_str()] ?: @"";
+	NSString *b = [NSString stringWithUTF8String:tabs.c_str()] ?: @"";
+	dispatch_async(dispatch_get_main_queue(), ^{
+		[[iOS7AppDelegate iPhoneView] albumSetTools:t legend:l tabs:b gameRect:CGRectMake(x, y, w, h)];
+	});
+}
+#else
+void iOS7_albumLayoutChanged(const Common::String &tools, const Common::String &legend, const Common::String &tabs, int x, int y, int w, int h) {}
