+
+// Sonde Album : nom du marque-page affiché (Text Label « legende » visible, enfant d'un post-it pNN)
+static Common::String sondeFindLegend(Structural *s, bool parentVisible) {
+	bool visible = parentVisible;
+	if (s->isElement() && static_cast<Element *>(s)->isVisual())
+		visible = visible && static_cast<VisualElement *>(s)->isVisible();
+	if (!visible)
+		return Common::String();
+	if (s->getName() == "legende" && static_cast<Element *>(s)->isVisual() && static_cast<VisualElement *>(s)->isTextLabel())
+		return static_cast<TextLabelElement *>(s)->sondeGetText();
+	for (const Common::SharedPtr<Structural> &c : s->getChildren()) {
+		Common::String t = sondeFindLegend(c.get(), visible);
+		if (!t.empty())
+			return t;
+	}
+	return Common::String();
