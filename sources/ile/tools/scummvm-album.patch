+// Sonde Album : « fond » = rien, ou un grand élément cliquable qui couvre la page (zone sensible)
+bool MTropolisEngine::sondeIsBackgroundAt(int x, int y, bool &nothing) {
+	Structural *s = _runtime->sondeTopAt(x, y);
+	nothing = (s == nullptr);
+	if (!s)
+		return true;
+	if (s->isElement() && static_cast<Element *>(s)->isVisual()) {
+		const Common::Rect &r = static_cast<VisualElement *>(s)->getRelativeRect();
+		return (int32)r.width() * r.height() > 640 * 480 / 4;
+	}
+	return false;
+}
+
+// Sonde Album : tolérance tactile. Appui sur du vide (ou sur un grand fond cliquable) près d'une petite cible (post-it,
+// outil, objet) → décalage vers la cible la plus proche. Rayon complet hors page, réduit (60 %) au-dessus d'un fond cliquable.
+bool MTropolisEngine::sondeFindSnap(int x, int y, Common::Point &snap) {
+	snap = Common::Point(0, 0);
+	const int radius = (ConfMan.hasKey("album_touch_snap") || ConfMan.hasDefault("album_touch_snap")) ? ConfMan.getInt("album_touch_snap") : 0;
+	bool nothing = false;
+	if (radius <= 0 || !sondeIsBackgroundAt(x, y, nothing))
+		return false;
+	const int rad = nothing ? radius : radius * 6 / 10;
+	int bestD = INT_MAX;
+	for (int dy = -rad; dy <= rad; dy += 2) {
+		for (int dx = -rad; dx <= rad; dx += 2) {
+			const int d = dx * dx + dy * dy;
+			if (d >= bestD || d > rad * rad)
+				continue;
+			bool n2;
+			if (!sondeIsBackgroundAt(x + dx, y + dy, n2)) {
+				bestD = d;
+				snap = Common::Point(dx, dy);
+			}
+		}
+	}
+	return bestD != INT_MAX;
+}
