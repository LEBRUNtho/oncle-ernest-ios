+			return kSondeLayoutHidden;
+		return MIN<int>(0, s_sondeLayoutCropBottom - r.bottom);
+	}
+	if (n == "appphotos_mt" || n == "arrosoir_mt" || n == "torche" || n == "marteau_pic" || n == "imprimante" || n == "help" || n == "help2" ||
+		n == "sortie-00.pct" || n == "gestion_volume" ||
+		n == "oil_bas" || n == "torche_bas" || n == "acide_bas" || n == "appphotos_bas" || n == "sortie" ||	// jeu 2
+		n == "explosif_bas")	// jeu 3
+		return kSondeLayoutHidden;
+	return 0;
