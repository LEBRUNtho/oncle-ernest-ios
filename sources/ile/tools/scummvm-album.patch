+// Sonde Album : recopie les valeurs d'une variable chargée vers la variable du jeu, en appariant les enfants par nom
+static void sondeCopyVariableValues(Modifier *src, Modifier *dst) {
+	if (!src || !dst)
+		return;
+	if (src->isVariable() && dst->isVariable()) {
+		static_cast<VariableModifier *>(dst)->setStorage(static_cast<VariableModifier *>(src)->getStorage()->clone());
+		debug(1, "native restore: '%s' <- guid %x", dst->getName().c_str(), src->getStaticGUID());
+		return;
+	}
+	IModifierContainer *srcContainer = src->getChildContainer();
+	IModifierContainer *dstContainer = dst->getChildContainer();
+	if (!srcContainer || !dstContainer)
+		return;
+	const Common::Array<Common::SharedPtr<Modifier> > &srcMods = srcContainer->getModifiers();
+	const Common::Array<Common::SharedPtr<Modifier> > &dstMods = dstContainer->getModifiers();
+	for (size_t i = 0; i < srcMods.size(); i++) {
+		Modifier *s = srcMods[i].get();
+		if (!s)
+			continue;
+		Modifier *match = nullptr;
+		for (const Common::SharedPtr<Modifier> &d : dstMods) {
+			if (d && d->getStaticGUID() == s->getStaticGUID()) {
+				match = d.get();
+				break;
+			}
+		}
+		if (!match && !s->getName().empty()) {
+			for (const Common::SharedPtr<Modifier> &d : dstMods) {
+				if (d && caseInsensitiveEqual(s->getName(), d->getName())) {
+					match = d.get();
+					break;
+				}
+			}
+		}
+		if (!match && srcMods.size() == dstMods.size())
+			match = dstMods[i].get();
+		if (match)
+			sondeCopyVariableValues(s, match);
+		else
+			warning("native restore: no match for child #%u guid %x", (unsigned)i, s->getStaticGUID());
+	}
+}
