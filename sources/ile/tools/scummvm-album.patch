 }
 
 VThreadState CaptureBitmapModifier::consumeMessage(Runtime *runtime, const Common::SharedPtr<MessageProperties> &msg) {
+	sondeLog("capture", msg);
+	BitmapVariableModifier *var = resolveBitmapVar(0);
+	VisualElement *elem = findParentVisualElement();
+	Common::SharedPtr<Window> win = runtime->getMainWindow().lock();
+	if (var && elem && win) {
+		Common::Rect rect = sondeElementScreenRect(runtime, elem);
+		rect.translate(-win->getX(), -win->getY());
+		Common::SharedPtr<Graphics::ManagedSurface> screen = win->getSurface();
+		// Sonde Album : pour le viseur de l'appareil photo, on capture la scène redessinée SANS le viseur (calques >= au sien)
+		if (elem->getName() == "viseur_reel") {
+			Common::SharedPtr<Graphics::ManagedSurface> saved(new Graphics::ManagedSurface());
+			saved->copyFrom(*screen);
+			Render::sondeRenderBelowLayer(runtime, win.get(), elem->getLayer());
+			Common::SharedPtr<Graphics::ManagedSurface> clean(new Graphics::ManagedSurface());
+			clean->copyFrom(*screen);
+			screen->copyFrom(*saved);
+			screen = clean;
+		}
+		rect.clip(Common::Rect(screen->w, screen->h));
+		if (!rect.isEmpty()) {
+			Common::SharedPtr<Graphics::ManagedSurface> bmp(new Graphics::ManagedSurface());
+			bmp->create(rect.width(), rect.height(), screen->format);
+			bmp->copyRectToSurface(*screen->surfacePtr(), 0, 0, rect);
+			var->setBitmap(bmp);
+
+			// Sonde Album : copie PNG de chaque capture pour contrôle (niveau de débogage >= 5 seulement)
+			static int sondeCaptureCount = 0;
+			// (revue Fable B5 : chemin construit seulement en débogage, et HOME absent toléré)
+			Common::DumpFile f;
+			const char *home = getenv("HOME");
+			if (gDebugLevel >= 5 && home && f.open(Common::FSNode(Common::Path(Common::String::format("%s/album-ernest-build/shots/capture_%02d_%s.png", home, sondeCaptureCount++, elem->getName().c_str()))))) {
+				if (bmp->format.bytesPerPixel == 1) {
+					byte pal[256 * 3];
+					g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+					Image::writePNG(f, *bmp->surfacePtr(), pal, 256);
+				} else {
+					Graphics::Surface *conv = bmp->surfacePtr()->convertTo(Graphics::PixelFormat(3, 8, 8, 8, 0, 16, 8, 0, 0));
+					Image::writePNG(f, *conv);
+					conv->free();
+					delete conv;
+				}
+			}
+			debug(1, "hoologic capture rect (%d,%d %dx%d) format bpp %d", rect.left, rect.top, rect.width(), rect.height(), bmp->format.bytesPerPixel);
+		}
+	}
 	return kVThreadReturn;
 }
 
