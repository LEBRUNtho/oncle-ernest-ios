+static VisualElement *sondeSharedChild(Runtime *rt, const char *name) {
+	const Common::SharedPtr<Structural> &shared = rt->getActiveSharedScene();
+	if (!shared)
+		return nullptr;
+	for (const Common::SharedPtr<Structural> &c : shared->getChildren())
+		if (c->getName() == name && c->isElement() && static_cast<Element *>(c.get())->isVisual())
+			return static_cast<VisualElement *>(c.get());
+	return nullptr;
+}
+
+// Sonde Album : descendant nommé (visible ou non)
+static Structural *sondeFindDescendant(Structural *s, const char *name) {
+	if (s->getName() == name)
+		return s;
+	for (const Common::SharedPtr<Structural> &c : s->getChildren())
+		if (Structural *r = sondeFindDescendant(c.get(), name))
+			return r;
+	return nullptr;
+}
+
+// Sonde Album : valeur d'une variable portée directement par l'élément (num_post, nom_page, v_scene des marque-pages)
+static bool sondeVarValue(Structural *s, const char *name, DynamicValue &out) {
+	for (const Common::SharedPtr<Modifier> &m : s->getModifiers())
+		if (m && m->isVariable() && m->getName() == name) {
+			static_cast<VariableModifier *>(m.get())->varGetValue(out);
+			return true;
+		}
+	return false;
+}
