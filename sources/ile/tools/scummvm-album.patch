+void MTropolisEngine::sondeToolCommand(int index) {
+	if (index < 0 || index >= (int)ARRAYSIZE(kSondeToolNames))
+		return;
+	VisualElement *v = sondeSharedChild(_runtime.get(), kSondeToolNames[index]);
+	if (v && v->isVisible()) {
+		// Comme avec la souris : le pointeur (et l'outil tenu, ex. viseur) passe d'abord sur la case de l'outil. Sans ça,
+		// un 2e appui sur l'appareil photo ne le rangeait pas (viseur figé sur la page).
+		// (origine calculée par la chaîne des parents : un élément masqué par la disposition n'est plus dessiné, son origine
+		// en cache n'est donc pas à jour)
+		Common::Point c(v->getRelativeRect().width() / 2, v->getRelativeRect().height() / 2);
+		for (Structural *s = v; s && s->isElement() && static_cast<Element *>(s)->isVisual(); s = s->getParent()) {
+			c.x += static_cast<VisualElement *>(s)->getRelativeRect().left;
+			c.y += static_cast<VisualElement *>(s)->getRelativeRect().top;
+		}
+		// Vrai clic à l'emplacement de l'outil (le jeu en a besoin pour ranger l'outil tenu), 150 ms après y avoir amené le
+		// pointeur (l'outil tenu suit avec retard) ; barre rendue cliquable (invisible) le temps du clic
+		_runtime->onMouseMove(c.x, c.y);
+		_sondeLastMouse = c;
+		_sondeToolClickPos = c;
+		_sondeToolClickAt = _system->getMillis() + 150;
+		_sondeActiveTool = index;
+		_sondeToolGraceUntil = _sondeToolClickAt + 700;
+		Runtime::s_sondeLayoutClickableUntil = _sondeToolClickAt + 400;
+		debug(1, "sonde tool '%s' (%d,%d)", kSondeToolNames[index], c.x, c.y);
+	}
+	else
+		debug(1, "sonde tool '%s' absent", kSondeToolNames[index]);
+}
