+void sondeRenderBelowLayer(Runtime *runtime, Window *window, uint16 maxLayerExclusive) {
+	Common::Array<Structural *> scenes;
+	runtime->getScenesInRenderOrder(scenes);
+
+	Common::Array<RenderItem> normalBucket;
+	Common::Array<RenderItem> directBucket;
+	size_t sceneStackDepth = 0;
+	for (Structural *scene : scenes) {
+		recursiveCollectDrawElementsAndUpdateOrigins(Common::Point(0, 0), scene, sceneStackDepth, normalBucket, directBucket);
+		sceneStackDepth++;
+	}
+	Common::sort(normalBucket.begin(), normalBucket.end(), renderItemLess);
+	Common::sort(directBucket.begin(), directBucket.end(), renderItemLess);
+
+	window->getSurface()->fillRect(Common::Rect(window->getSurface()->w, window->getSurface()->h), 0);
+	// Le viseur est dans la scène partagée (dessinée en premier) : on exclut ses éléments de calque >= au sien,
+	// la page elle-même (scène principale) est entièrement dessinée
+	for (const RenderItem &item : normalBucket)
+		if (item.sceneStackDepth > 0 || item.element->getLayer() < maxLayerExclusive)
+			renderNormalElement(item, window);
+	for (const RenderItem &item : directBucket)
+		if (item.sceneStackDepth > 0 || item.element->getLayer() < maxLayerExclusive)
+			renderDirectElement(item, window);
