+// Sonde Ernest 4 (étude de faisabilité, jeu « Le Temple perdu ») : SONDE_SHOT_DIR = dossier où déposer une capture
+// toutes les 2 s (shot_NNNN.png) ; /tmp/ernest4_cmd = lignes « click X Y » ou « key CODE » jouées dans l'ordre.
+void DirectorEngine::sondeTick() {
+	static const char *dir = getenv("SONDE_SHOT_DIR");
+	static uint32 lastShot = 0, shotNo = 0;
+	static int32 cmdPos = 0;
+	uint32 now = g_system->getMillis();
+	if (dir && now - lastShot >= 2000) {
+		lastShot = now;
+		Graphics::Surface *scr = g_system->lockScreen();
+		if (scr) {
+			Common::DumpFile f;
+			if (f.open(Common::Path(Common::String::format("%s/shot_%04u.png", dir, shotNo++)))) {
+				byte pal[768];
+				g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+				Image::writePNG(f, *scr, scr->format.bytesPerPixel == 1 ? pal : nullptr);
+			}
+			g_system->unlockScreen();
+		}
+	}
+	Common::File c;
+	if (c.open(Common::FSNode(Common::Path("/tmp/ernest4_cmd")))) {
+		c.seek(cmdPos);
+		while (!c.eos()) {
+			Common::String l = c.readLine();
+			if (c.eos() && l.empty())
+				break;
+			int x, y;
+			if (sscanf(l.c_str(), "click %d %d", &x, &y) == 2) {
+				Common::Event e;
+				e.mouse = Common::Point(x, y);
+				e.type = Common::EVENT_MOUSEMOVE;
+				g_system->getEventManager()->pushEvent(e);
+				e.type = Common::EVENT_LBUTTONDOWN;
+				g_system->getEventManager()->pushEvent(e);
+				e.type = Common::EVENT_LBUTTONUP;
+				g_system->getEventManager()->pushEvent(e);
+				debug("sonde : click %d %d", x, y);
+			}
+		}
+		cmdPos = c.pos();
+	}
+}
