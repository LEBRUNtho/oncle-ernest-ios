+		return false;
+	}
+	if (event.type == Common::EVENT_MOUSEMOVE && event.customType == kSondeTouchEnded) {
+		if (_sondeHasPendingDown) {
+			_sondeHasPendingDown = false;
+			_injectedEvents.push_back(_sondePendingDown);
+			_sondeDownAt = now;
+			_sondePendingUpAfter = false;
+		}
+		if (_sondeTouchHeld) {
+			Common::Event up = event;
+			up.type = Common::EVENT_LBUTTONUP;
+			up.customType = kSondeSynthetic;
+			if (now < _sondeDownAt + 80) {
