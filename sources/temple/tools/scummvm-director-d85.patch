+// Sonde Album : impression demandée par le jeu (outil imprimante) : fenêtre AirPrint d'iOS (imprimante, PDF, partage)
+void iOS7_albumPrint(const Common::String &path) {
+#if TARGET_OS_IOS
+	NSString *p = [NSString stringWithUTF8String:path.c_str()];
+	dispatch_async(dispatch_get_main_queue(), ^{
+		UIImage *img = [UIImage imageWithContentsOfFile:p];
+		if (!img) {
+			NSLog(@"Sonde Album: impression, image illisible %@", p);
+			return;
+		}
+		UIPrintInteractionController *pc = [UIPrintInteractionController sharedPrintController];
+		UIPrintInfo *info = [UIPrintInfo printInfo];
+		info.outputType = UIPrintInfoOutputPhoto;
+		info.jobName = @"L'oncle Ernest";
+		info.orientation = UIPrintInfoOrientationLandscape;
+		pc.printInfo = info;
+		pc.printingItem = img;
+		UIView *v = [iOS7AppDelegate iPhoneView];
+		if ([[UIDevice currentDevice] userInterfaceIdiom] == UIUserInterfaceIdiomPad)
+			[pc presentFromRect:CGRectMake(v.bounds.size.width / 2, v.bounds.size.height / 2, 1, 1) inView:v animated:YES completionHandler:nil];
+		else
+			[pc presentAnimated:YES completionHandler:nil];
+	});
+#endif
+}
