+		b.tag = (NSInteger)_albumTabButtons.count;
+		b.imageView.contentMode = UIViewContentModeScaleAspectFit;
+		b.titleLabel.font = [UIFont systemFontOfSize:9.5 weight:UIFontWeightBold];
+		b.titleLabel.numberOfLines = 2;
+		b.titleLabel.adjustsFontSizeToFitWidth = YES;
+		b.titleLabel.minimumScaleFactor = 0.8;
+		b.titleLabel.lineBreakMode = NSLineBreakByWordWrapping;
+		[b setTitleColor:[UIColor colorWithWhite:0.92 alpha:1.0] forState:UIControlStateNormal];
+		[b setTitleColor:[UIColor whiteColor] forState:UIControlStateSelected];
+		b.adjustsImageWhenHighlighted = YES;
+		b.layer.cornerRadius = 6;
+		[b addTarget:self action:@selector(albumTabPressed:) forControlEvents:UIControlEventTouchUpInside];
+		[b addTarget:self action:@selector(albumTabTouchDown:) forControlEvents:UIControlEventTouchDown];
+		[_albumTabScroll addSubview:b];
+		[_albumTabButtons addObject:b];
+	}
+	for (NSUInteger i = 0; i < _albumTabButtons.count; i++) {
+		UIButton *b = _albumTabButtons[i];
+		if (i >= list.count) {
+			b.hidden = YES;
+			continue;
+		}
+		NSDictionary *t = list[i];
+		const BOOL vis = [t[@"vis"] boolValue], bottom = [t[@"bottom"] boolValue];
+		UIImage *rest = [self albumTabIcon:t[@"name"] bottom:bottom];
+		if (vis) {
+			b.tintColor = nil;
+			[b setImage:rest forState:UIControlStateNormal];
+			[b setImage:rest forState:UIControlStateHighlighted];
+			[b setImage:rest forState:UIControlStateSelected];
+			b.accessibilityLabel = t[@"title"];
+		} else {
+			// page pas encore découverte : silhouette grise, sans nom, inerte
+			UIImage *grey = [rest imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
+			b.tintColor = [UIColor colorWithWhite:0.32 alpha:1.0];
+			[b setImage:grey forState:UIControlStateNormal];
+			[b setImage:grey forState:UIControlStateHighlighted];
+			[b setImage:grey forState:UIControlStateSelected];
+			b.accessibilityLabel = @"";
+		}
+		b.enabled = vis;
+		b.selected = ((NSInteger)i == _albumTabCurrent);
+		b.backgroundColor = b.selected ? [UIColor colorWithWhite:1.0 alpha:0.16] : [UIColor clearColor];
+		b.hidden = NO;
+	}
+	_albumTabScroll.hidden = (list.count == 0);
+	_albumTabsChanged = YES;
+}
