+
+void b_crop(int nargs) {
+	Common::Rect r = datumToRect(g_lingo->pop());
+	Datum target = g_lingo->pop();
+	if (target.type != CASTREF) {
+		warning("LingoImage::b_crop: unsupported target %s", target.asString(true).c_str());
+		return;
+	}
+	CastMember *member = g_director->getCurrentMovie()->getCastMember(*target.u.cast);
+	Datum img = getMemberImage(member);
+	if (!isImage(img))
+		return;
+	ImageObject *src = static_cast<ImageObject *>(img.u.obj);
+	r.clip(Common::Rect(src->_surface.w, src->_surface.h));
+	if (r.isEmpty())
+		return;
+	ImageObject *cropped = new ImageObject(r.width(), r.height());
+	cropped->_surface.blitFrom(src->_surface, r, Common::Point(0, 0));
+	int regX = member->_type == kCastBitmap ? ((BitmapCastMember *)member)->_regX : 0;
+	int regY = member->_type == kCastBitmap ? ((BitmapCastMember *)member)->_regY : 0;
+	setMemberImage(member, Datum(cropped));
+	// Director keeps the artwork where it was on stage: the registration point follows the crop origin
+	if (member->_type == kCastBitmap) {
+		((BitmapCastMember *)member)->_regX = regX - r.left;
+		((BitmapCastMember *)member)->_regY = regY - r.top;
+		markSharedImage(member);
+	}
+}
+
+Datum getMemberImage(CastMember *member) {
+	if (!member)
+		return Datum();
+	member->load();
+	if (member->_type == kCastBitmap) {
+		BitmapCastMember *bitmap = (BitmapCastMember *)member;
+		if (!bitmap->_picture)
+			return Datum();
+		const Graphics::Surface &surf = bitmap->_picture->_surface;
+		const byte *pal = nullptr;
+		int palColors = 0;
+		if (surf.format.bytesPerPixel == 1) {
+			PaletteV4 *p = g_director->getPalette(bitmap->_clut);
+			if (p) {
+				pal = p->palette;
+				palColors = p->length;
+			} else if (bitmap->_picture->_paletteColors) {
+				pal = bitmap->_picture->_palette;
+				palColors = bitmap->_picture->_paletteColors;
+			} else {
+				pal = g_director->getPalette();
+				palColors = 256;
+			}
+		}
+		return ImageObject::fromSurface(surf, pal, palColors);
+	}
+	// Text and other drawable members: render them
+	Common::Rect bbox = member->getBbox();
+	if (bbox.isEmpty())
+		bbox = Common::Rect(member->_initialRect.width(), member->_initialRect.height());
+	bbox.moveTo(0, 0);
+	if (bbox.isEmpty())
+		return Datum();
+	// only members whose widget does not need a channel (D8 Text Xtra)
+	if (!dynamic_cast<TextXtraCastMember *>(member))
+		return Datum(new ImageObject(bbox.width(), bbox.height()));
+	Graphics::MacWidget *widget = member->createWidget(bbox, nullptr, kTextSprite);
+	if (!widget)
+		return Datum();
+	widget->draw(true);
+	Graphics::ManagedSurface *ms = widget->getSurface();
+	Datum res;
+	if (ms) {
+		const byte *pal = g_director->_wm->getPalette();
+		res = ImageObject::fromSurface(ms->rawSurface(), pal, g_director->_wm->getPaletteSize());
+		// a text image has an alpha channel: the white background is transparent, the glyphs opaque
+		if (isImage(res)) {
+			Graphics::ManagedSurface &srf = static_cast<ImageObject *>(res.u.obj)->_surface;
+			const Graphics::PixelFormat &f = srf.format;
+			for (int y = 0; y < srf.h; y++)
+				for (int x = 0; x < srf.w; x++) {
+					uint8 a, r, g, b;
+					f.colorToARGB(srf.getPixel(x, y), a, r, g, b);
+					uint8 na = 255 - MIN(r, MIN(g, b));
+					srf.setPixel(x, y, f.ARGBToColor(na, r, g, b));
+				}
+		}
+	}
+	delete widget;
+	return res;
+}
+
+bool setMemberImage(CastMember *member, const Datum &image) {
+	if (!member || !isImage(image) || member->_type != kCastBitmap)
+		return false;
+	BitmapCastMember *bitmap = (BitmapCastMember *)member;
+	ImageObject *img = static_cast<ImageObject *>(image.u.obj);
+	PictureReference ref;
+	ref._picture = new Picture();
+	ref._picture->_surface.copyFrom(img->_surface.rawSurface());
+	bitmap->setPicture(ref);
+	bitmap->_bitsPerPixel = 32;
+	bitmap->_initialRect = Common::Rect(img->_surface.w, img->_surface.h);
+	bitmap->_regX = img->_surface.w / 2;
+	bitmap->_regY = img->_surface.h / 2;
+	bitmap->forceLoaded();
+	markSharedImage(member);
+	Movie *movie = g_director->getCurrentMovie();
+	Score *score = movie ? movie->getScore() : nullptr;
+	if (score) {
+		for (uint i = 0; i < score->_channels.size(); i++) {
+			Channel *ch = score->_channels[i];
+			if (ch && ch->_sprite && ch->_sprite->_cast == bitmap) {
+				if (!ch->_sprite->_stretch) {
+					ch->_sprite->_width = img->_surface.w;
+					ch->_sprite->_height = img->_surface.h;
+				}
+				ch->setDirty();
+			}
+		}
+	}
+	return true;
+}
+
+Datum getWindowImage(Window *window) {
+	// (the stage).image, or the image of a window (Oncle Ernest 4 photographs the next page opened in a hidden window)
+	Window *win = window ? window : g_director->getStage();
+	if (win && win != g_director->getStage())
+		win->render(true);
+	Graphics::ManagedSurface *surf = win ? win->getSurface() : nullptr;
+	if (!surf)
+		return Datum();
+	return ImageObject::fromSurface(surf->rawSurface(), g_director->_wm->getPalette(), g_director->_wm->getPaletteSize());
+}
+
+bool newCastMember(const Common::String &type, const Datum &where, Datum &result, Movie *inMovie) {
+	// inMovie: the movie being loaded (a hidden window used to turn the pages is not the current movie)
+	Movie *movie = inMovie ? inMovie : g_director->getCurrentMovie();
+	if (!movie)
+		return false;
+	Cast *cast = nullptr;
+	int id = 0;
+	if (where.type == CASTREF) {
+		cast = movie->getCast(*where.u.cast);
+		id = where.u.cast->member;
+	} else if (where.type == CASTLIBREF) {
+		cast = movie->getCasts()->getValOrDefault(where.u.i, nullptr);
+	} else {
+		cast = movie->getCast();
+	}
+	if (!cast)
+		return false;
+	if (id <= 0)
+		id = cast->getNextUnusedID();
+
+	CastMember *member = nullptr;
+	if (type.equalsIgnoreCase("bitmap")) {
+		BitmapCastMember *bitmap = new BitmapCastMember(cast, id);
+		bitmap->_picture = new Picture();
+		bitmap->_picture->_surface.create(1, 1, ImageObject::pixelFormat());
+		bitmap->_bitsPerPixel = 32;
+		bitmap->_initialRect = Common::Rect(1, 1);
+		member = bitmap;
+	} else if (type.equalsIgnoreCase("text")) {
+		member = new TextXtraCastMember(cast, id);
+	} else {
+		warning("LingoImage::newCastMember: unsupported type #%s", type.c_str());
+		return false;
+	}
+	member->forceLoaded();
+	if (cast->getCastMemberInfo(id) == nullptr)
+		cast->setCastMemberInfo(id, new CastMemberInfo());
+	cast->setCastMember(id, member);
+	result = Datum(CastMemberID(id, cast->_castLibID));
+	return true;
+}
+
+/* Photo album */
+
+struct StoredPhoto {
+	int id;
+	Common::String name;
+	Graphics::ManagedSurface surface;
+	int regX, regY;
+};
+
+static Common::Array<StoredPhoto *> s_photos;
+static bool s_photosValid = false;	// false: keep what the movie loaded from disk
+// first member of c_photo that holds a photo: 3 in Oncle Ernest 4 (1-2 are templates), 1 in Oncle Ernest 5
+// (members 1-2 are empty there and the game puts its first photos in them)
+static int firstPhoto() { return g_director->gameIsAlbert5() ? 1 : 3; }
+
+static Cast *findPhotoCast(Movie *movie) {
+	if (!movie)
+		return nullptr;
+	for (auto &it : *movie->getCasts()) {
+		if (it._value && it._value->getCastName().equalsIgnoreCase("c_photo"))
+			return it._value;
+	}
+	return nullptr;
+}
+
+static void clearStore() {
+	for (auto *p : s_photos)
+		delete p;
+	s_photos.clear();
+}
+
+// Images set by Lingo in shared casts (c_nav: snapshots of the pages for the page turn): ScummVM reloads the
+// external casts with each movie, so they are kept here and put back after the switch
+struct SharedImage {
+	Graphics::ManagedSurface surface;
+	int regX, regY;
+};
+static Common::HashMap<Common::String, SharedImage *> s_sharedImages;
+static Common::HashMap<Common::String, bool> s_sharedDirty;
+
+static Cast *findCastByName(Movie *movie, const Common::String &name) {
+	if (!movie)
+		return nullptr;
+	for (auto &it : *movie->getCasts()) {
+		if (it._value && it._value->getCastName().equalsIgnoreCase(name))
+			return it._value;
+	}
+	return nullptr;
+}
+
+static bool s_sharedPropagating = false;
+
+static void markSharedImage(CastMember *member) {
+	Cast *cast = member->getCast();
+	if (!cast || cast->getCastName().empty() || cast->getCastName().equalsIgnoreCase("c_photo") || s_sharedPropagating)
+		return;
+	Movie *movie = g_director->getCurrentMovie();
+	if (movie && cast == movie->getCast())
+		return;
+	s_sharedDirty[Common::String::format("%s:%d", cast->getCastName().c_str(), member->getID())] = true;
+	// the same cast is also open in the other windows (stage + hidden window of the next page): same image there
+	Datum img = getMemberImage(member);
+	if (!isImage(img))
+		return;
+	BitmapCastMember *b = (BitmapCastMember *)member;
+	s_sharedPropagating = true;
+	Common::Array<Window *> windows;
+	windows.push_back(g_director->getStage());
+	for (auto *w : *g_director->getWindowList())
+		windows.push_back(w);
+	for (auto *w : windows) {
+		Movie *m = w ? w->getCurrentMovie() : nullptr;
+		Cast *other = findCastByName(m, cast->getCastName());
+		CastMember *om = other && other != cast ? other->getCastMember(member->getID()) : nullptr;
+		if (!om || om->_type != kCastBitmap)
+			continue;
+		ImageObject *copy = new ImageObject(static_cast<ImageObject *>(img.u.obj)->_surface.w, static_cast<ImageObject *>(img.u.obj)->_surface.h);
+		copy->_surface.copyFrom(static_cast<ImageObject *>(img.u.obj)->_surface);
+		setMemberImage(om, Datum(copy));
+		((BitmapCastMember *)om)->_regX = b->_regX;
+		((BitmapCastMember *)om)->_regY = b->_regY;
+	}
+	s_sharedPropagating = false;
+}
+
+static void sharedSnapshot(Movie *movie) {
+	for (auto &it : s_sharedDirty) {
+		Common::String key = it._key;
+		int colon = key.findLastOf(':');
+		Cast *cast = findCastByName(movie, key.substr(0, colon));
+		CastMember *m = cast ? cast->getCastMember(atoi(key.c_str() + colon + 1)) : nullptr;
+		if (!m || m->_type != kCastBitmap)
+			continue;
+		Datum img = getMemberImage(m);
+		if (!isImage(img))
+			continue;
+		SharedImage *si = s_sharedImages.getValOrDefault(key, nullptr);
+		if (!si) {
+			si = new SharedImage;
+			s_sharedImages[key] = si;
+		}
+		si->surface.copyFrom(static_cast<ImageObject *>(img.u.obj)->_surface);
+		si->regX = ((BitmapCastMember *)m)->_regX;
+		si->regY = ((BitmapCastMember *)m)->_regY;
+	}
+}
+
+static void sharedApply(Movie *movie) {
+	for (auto &it : s_sharedImages) {
+		Common::String key = it._key;
+		int colon = key.findLastOf(':');
+		Cast *cast = findCastByName(movie, key.substr(0, colon));
+		CastMember *m = cast ? cast->getCastMember(atoi(key.c_str() + colon + 1)) : nullptr;
+		if (!m || m->_type != kCastBitmap)
+			continue;
+		ImageObject *img = new ImageObject(it._value->surface.w, it._value->surface.h);
+		img->_surface.copyFrom(it._value->surface);
+		setMemberImage(m, Datum(img));
+		((BitmapCastMember *)m)->_regX = it._value->regX;
+		((BitmapCastMember *)m)->_regY = it._value->regY;
+	}
+}
+
+void photoSnapshot(Movie *movie) {
+	sharedSnapshot(movie);
+	Cast *cast = findPhotoCast(movie);
+	if (!cast)
+		return;
+	clearStore();
+	int maxId = cast->getCastMaxID();
+	for (int id = firstPhoto(); id <= maxId; id++) {
+		CastMember *m = cast->getCastMember(id);
+		if (!m || m->_type != kCastBitmap)
+			continue;
+		BitmapCastMember *b = (BitmapCastMember *)m;
+		Datum img = getMemberImage(m);
+		if (!isImage(img))
+			continue;
+		StoredPhoto *p = new StoredPhoto;
+		p->id = id;
+		CastMemberInfo *info = cast->getCastMemberInfo(id);
+		p->name = info ? info->name : Common::String();
+		p->surface.copyFrom(static_cast<ImageObject *>(img.u.obj)->_surface);
+		p->regX = b->_regX;
+		p->regY = b->_regY;
+		s_photos.push_back(p);
+	}
+	s_photosValid = true;
+	debugC(2, kDebugImages, "photoSnapshot: %d photo(s)", s_photos.size());
+}
+
+void photoApply(Movie *movie) {
+	sharedApply(movie);
+	if (!s_photosValid)
+		return;
+	Cast *cast = findPhotoCast(movie);
+	if (!cast)
+		return;
+	int maxId = cast->getCastMaxID();
+	for (int id = firstPhoto(); id <= maxId; id++)
+		if (cast->getCastMember(id, false))
+			cast->eraseCastMember(id);
+	for (auto *p : s_photos) {
+		Datum where(CastMemberID(p->id, cast->_castLibID));
+		Datum res;
+		if (!newCastMember("bitmap", where, res, movie))
+			continue;
+		ImageObject *img = new ImageObject(p->surface.w, p->surface.h);
+		img->_surface.copyFrom(p->surface);
+		CastMember *m = cast->getCastMember(p->id);
+		if (!m || m->_type != kCastBitmap) {
+			// la photo n'a pas pu être recréée à sa place : on ne plante pas (Ernest 4, photo prise en forêt)
+			warning("photoApply: photo %d (%s) non recréée", p->id, p->name.c_str());
+			delete img;
+			continue;
+		}
+		setMemberImage(m, Datum(img));
+		BitmapCastMember *b = (BitmapCastMember *)m;
+		b->_regX = p->regX;
+		b->_regY = p->regY;
+		CastMemberInfo *info = cast->getCastMemberInfo(p->id);
+		if (!info && !p->name.empty()) {
+			info = new CastMemberInfo();
+			cast->setCastMemberInfo(p->id, info);
+		}
+		if (info)
+			info->name = p->name;
+	}
+	cast->rebuildCastNameCache();
+	debugC(2, kDebugImages, "photoApply: %d photo(s)", s_photos.size());
+}
+
+bool photoCastIsOpen() {
+	return findPhotoCast(g_director->getCurrentMovie()) != nullptr;
+}
+
+void photoReset() {
+	clearStore();
+	s_photosValid = true;
+	photoApply(g_director->getCurrentMovie());
+}
+
+bool photoSaveToFile(const Common::String &saveName) {
+	photoSnapshot(g_director->getCurrentMovie());
+	Common::OutSaveFile *out = g_system->getSavefileManager()->openForSaving(saveName, false);
+	if (!out)
+		return false;
+	out->writeUint32BE(MKTAG('P', 'H', 'O', '1'));
+	out->writeUint32BE(s_photos.size());
+	for (auto *p : s_photos) {
+		out->writeUint16BE(p->id);
+		out->writeUint16BE(p->name.size());
+		out->write(p->name.c_str(), p->name.size());
+		out->writeUint16BE(p->surface.w);
+		out->writeUint16BE(p->surface.h);
+		out->writeSint16BE(p->regX);
+		out->writeSint16BE(p->regY);
+		for (int y = 0; y < p->surface.h; y++)
+			for (int x = 0; x < p->surface.w; x++)
+				out->writeUint32BE(p->surface.getPixel(x, y));
+	}
+	out->finalize();
+	delete out;
+	return true;
+}
+
+bool photoLoadFromFile(const Common::String &saveName) {
+	Common::InSaveFile *in = g_system->getSavefileManager()->openForLoading(saveName);
+	if (!in)
+		return false;
+	if (in->readUint32BE() != MKTAG('P', 'H', 'O', '1')) {
+		delete in;
+		return false;
+	}
+	clearStore();
+	uint32 count = in->readUint32BE();
+	for (uint32 i = 0; i < count && !in->eos(); i++) {
+		StoredPhoto *p = new StoredPhoto;
+		p->id = in->readUint16BE();
+		uint16 len = in->readUint16BE();
+		for (uint16 k = 0; k < len; k++)
+			p->name += (char)in->readByte();
+		int w = in->readUint16BE(), h = in->readUint16BE();
+		p->regX = in->readSint16BE();
+		p->regY = in->readSint16BE();
+		p->surface.create(w, h, ImageObject::pixelFormat());
+		for (int y = 0; y < h; y++)
+			for (int x = 0; x < w; x++)
+				p->surface.setPixel(x, y, in->readUint32BE());
+		s_photos.push_back(p);
+	}
+	delete in;
+	s_photosValid = true;
+	photoApply(g_director->getCurrentMovie());
+	return true;
+}
+
+} // End of namespace LingoImage
+
+} // End of namespace Director
