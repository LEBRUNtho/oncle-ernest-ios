+static MethodProto xlibMethods[] = {
+	{ "new",				PropSaveXtra::m_new,		 0, 0,	500 },
+	{ nullptr, nullptr, 0, 0, 0 }
+};
+
+static BuiltinProto xlibBuiltins[] = {
+	{ "savePropsToDisk", PropSaveXtra::m_savePropsToDisk, 2, 2, 500, HBLTIN },
+	{ "loadPropsFromDisk", PropSaveXtra::m_loadPropsFromDisk, 1, 1, 500, FBLTIN },
+	{ nullptr, nullptr, 0, 0, 0, VOIDSYM }
+};
+
+enum {
+	kPSVoid = 0,
+	kPSSymbolRef = 2,
+	kPSString = 3,
+	kPSList = 7,
+	kPSPropList = 10,
+	// Our own extensions
+	kPSInt32 = 0x102,
+	kPSSymbol = 0x104,
+	kPSFloat = 0x105,
+	kPSPoint = 0x108,
+	kPSRect = 0x109,
+	kPSSprite = 0x10A,	// sprite(n)
+	kPSMember = 0x10B,	// member(n, castLib)
+};
+
+PropSaveXtraObject::PropSaveXtraObject(ObjectType ObjectType) :Object<PropSaveXtraObject>("propsave") {
+	_objType = ObjectType;
+}
+
+bool PropSaveXtraObject::hasProp(const Common::String &propName) {
+	return (propName == "name");
+}
+
+Datum PropSaveXtraObject::getProp(const Common::String &propName) {
+	if (propName == "name")
+		return Datum(PropSaveXtra::xlibName);
+	warning("PropSaveXtra::getProp: unknown property '%s'", propName.c_str());
+	return Datum();
+}
+
+void PropSaveXtra::open(ObjectType type, const Common::Path &path) {
+	PropSaveXtraObject::initMethods(xlibMethods);
+	PropSaveXtraObject *xobj = new PropSaveXtraObject(type);
+	if (type == kXtraObj) {
+		g_lingo->_openXtras.push_back(xlibName);
+		g_lingo->_openXtraObjects.push_back(xobj);
+	}
+	g_lingo->exposeXObject(xlibName, xobj);
+	g_lingo->initBuiltIns(xlibBuiltins);
+}
+
+void PropSaveXtra::close(ObjectType type) {
+	PropSaveXtraObject::cleanupMethods();
+	g_lingo->_globalvars[xlibName] = Datum();
+}
+
+void PropSaveXtra::m_new(int nargs) {
+	g_lingo->dropStack(nargs);
+	g_lingo->push(g_lingo->_state->me);
+}
+
+// Saved files live in the ScummVM save folder: the game path is flattened,
+// keeping what follows the "SAVE" folder (e.g. "SAVE\le mainteneur\Save.lex")
+Common::String saveName(const Common::String &path);
+
+bool PropSaveXtra::isGameSavePath(const Common::String &path) {
+	Common::String p = path;
+	p.toLowercase();
+	for (uint i = 0; i < p.size(); i++)
+		if (p[i] == ':' || p[i] == '/')
+			p.setChar('\\', i);
+	return p.contains("\\save\\") || p.hasSuffix("\\save") || p.hasSuffix("c_photo.cst");
+}
+
+Common::String PropSaveXtra::gameSaveName(const Common::String &path) {
+	Common::String p = path;
+	p.toLowercase();
+	if (!p.contains("save") && p.hasSuffix("c_photo.cst"))
+		return savePrefix() + "CST-c_photo.cst";
+	return saveName(path);
+}
+
+Common::String saveName(const Common::String &path) {
+	Common::Array<Common::String> parts;
+	Common::String cur;
+	for (uint i = 0; i < path.size(); i++) {
+		char c = path[i];
+		if (c == '\\' || c == '/' || c == ':') {
+			if (!cur.empty())
+				parts.push_back(cur);
+			cur.clear();
+		} else {
+			cur += c;
+		}
+	}
+	if (!cur.empty())
+		parts.push_back(cur);
+
+	uint start = parts.empty() ? 0 : parts.size() - 1;
+	for (uint i = 0; i < parts.size(); i++) {
+		if (parts[i].equalsIgnoreCase("SAVE")) {
+			start = i;
+			break;
+		}
+	}
+	Common::String name = savePrefix();
+	for (uint i = start; i < parts.size(); i++) {
+		if (i > start)
+			name += "-";
+		name += parts[i];
+	}
+	return name;
+}
+
+static Datum readValue(Common::SeekableReadStream &s, int depth, const Common::Array<Common::String> &syms) {
+	Datum d;
+	if (depth > 64 || s.eos())
+		return d;
+	uint32 type = s.readUint32BE();
+	switch (type) {
+	case kPSVoid:
+		break;
+	case kPSSymbolRef: {
+		uint16 index = s.readUint16BE();
+		d = Datum(index < syms.size() ? syms[index] : Common::String());
+		d.type = SYMBOL;
+		break;
+	}
+	case kPSInt32:
+		d = Datum((int)s.readSint32BE());
+		break;
+	case kPSString:
+	case kPSSymbol: {
+		uint32 len = s.readUint32BE();
+		Common::String str;
+		for (uint32 i = 0; i < len; i++) {
+			char c = (char)s.readByte();
+			if (c)
+				str += c;
+		}
+		str = str.decode(Common::kMacRoman).encode(Common::kUtf8);
+		d = Datum(str);
+		if (type == kPSSymbol)
+			d.type = SYMBOL;
+		break;
+	}
+	case kPSFloat: {
+		uint64 bits = s.readUint64BE();
+		double f;
+		memcpy(&f, &bits, sizeof(f));
+		d = Datum(f);
+		break;
+	}
+	case kPSSprite:
+		d = Datum((int)s.readSint32BE());
+		d.type = SPRITEREF;
+		break;
+	case kPSMember: {
+		int castLib = s.readSint32BE();
+		int member = s.readSint32BE();
+		d = Datum(CastMemberID(member, castLib));
+		break;
+	}
+	case kPSList:
+	case kPSPoint:
+	case kPSRect: {
+		uint16 count = s.readUint16BE();
+		d.type = (type == kPSList) ? ARRAY : (type == kPSPoint) ? POINT : RECT;
+		d.u.farr = new FArray;
+		for (uint i = 0; i < count && !s.eos(); i++)
+			d.u.farr->arr.push_back(readValue(s, depth + 1, syms));
+		break;
+	}
+	case kPSPropList: {
+		uint16 count = s.readUint16BE();
+		d.type = PARRAY;
+		d.u.parr = new PArray;
+		for (uint i = 0; i < count && !s.eos(); i++) {
+			Datum p = readValue(s, depth + 1, syms);
+			Datum v = readValue(s, depth + 1, syms);
+			d.u.parr->arr.push_back(PCell(p, v));
+		}
+		break;
+	}
+	default:
+		warning("PropSaveXtra: unknown value type %d at offset %d", type, (int)s.pos() - 4);
+		s.seek(0, SEEK_END);
+		break;
+	}
+	return d;
+}
+
+static void writeString(Common::WriteStream &s, uint32 type, const Common::String &utf8) {
+	Common::String str = Common::U32String(utf8, Common::kUtf8).encode(Common::kMacRoman);
+	s.writeUint32BE(type);
+	s.writeUint32BE(str.size() + 1);
+	s.write(str.c_str(), str.size() + 1);
+}
+
+static void writeValue(Common::WriteStream &s, const Datum &d, int depth) {
+	if (depth > 64) {
+		s.writeUint32BE(kPSVoid);
+		return;
+	}
+	switch (d.type) {
+	case INT:
+		s.writeUint32BE(kPSInt32);
+		s.writeSint32BE(d.u.i);
+		break;
+	case FLOAT: {
+		uint64 bits;
+		memcpy(&bits, &d.u.f, sizeof(bits));
+		s.writeUint32BE(kPSFloat);
+		s.writeUint64BE(bits);
+		break;
+	}
+	case STRING:
+		writeString(s, kPSString, d.asString());
+		break;
+	case SYMBOL:
+		writeString(s, kPSSymbol, d.asString());
+		break;
+	case ARRAY:
+	case POINT:
+	case RECT:
+		s.writeUint32BE(d.type == ARRAY ? kPSList : d.type == POINT ? kPSPoint : kPSRect);
+		s.writeUint16BE(d.u.farr->arr.size());
+		for (auto &v : d.u.farr->arr)
+			writeValue(s, v, depth + 1);
+		break;
+	case PARRAY:
+		s.writeUint32BE(kPSPropList);
+		s.writeUint16BE(d.u.parr->arr.size());
+		for (auto &c : d.u.parr->arr) {
+			writeValue(s, c.p, depth + 1);
+			writeValue(s, c.v, depth + 1);
+		}
+		break;
+	case SPRITEREF:
+		s.writeUint32BE(kPSSprite);
+		s.writeSint32BE(d.u.i);
+		break;
+	case CASTREF:
+		s.writeUint32BE(kPSMember);
+		s.writeSint32BE(d.u.cast->castLib);
+		s.writeSint32BE(d.u.cast->member);
+		break;
+	default:
+		if (d.type != VOID)
+			warning("PropSaveXtra: cannot save value of type %s", d.type2str());
+		s.writeUint32BE(kPSVoid);
+		break;
+	}
+}
+
+void PropSaveXtra::m_savePropsToDisk(int nargs) {
+	Datum value = g_lingo->pop();
+	Common::String path = g_lingo->pop().asString();
+	Common::String name = saveName(path);
+
+	Common::MemoryWriteStreamDynamic body(DisposeAfterUse::YES);
+	writeValue(body, value, 0);
+
+	Common::OutSaveFile *out = g_system->getSavefileManager()->openForSaving(name, false);
+	if (!out) {
+		warning("PropSaveXtra: cannot save '%s'", name.c_str());
+		return;
+	}
+	out->writeUint16BE(1);
+	out->writeUint16BE(4);
+	out->writeUint32BE(body.size() + 12);
+	out->writeUint32BE(0);
+	out->write(body.getData(), body.size());
+	out->finalize();
+	delete out;
+	debugC(2, kDebugXObj, "PropSaveXtra: saved '%s' as '%s'", path.c_str(), name.c_str());
+}
+
+void PropSaveXtra::m_loadPropsFromDisk(int nargs) {
+	Common::String path = g_lingo->pop().asString();
+	Common::String name = saveName(path);
+
+	Common::SeekableReadStream *in = g_system->getSavefileManager()->openForLoading(name);
+	if (!in) {
+		Common::Path location = findPath(path);
+		if (!location.empty())
+			in = Common::MacResManager::openFileOrDataFork(location);
+	}
+	if (!in) {
+		debugC(2, kDebugXObj, "PropSaveXtra: '%s' not found", path.c_str());
+		g_lingo->push(Datum());
+		return;
+	}
+	in->skip(8);
+	uint32 symCount = in->readUint32BE();
+	int32 start = in->pos();
+	// First pass only to find where the symbol table starts
+	Common::Array<Common::String> syms;
+	readValue(*in, 0, syms);
+	for (uint32 i = 0; i < symCount && !in->eos(); i++) {
+		uint16 len = in->readUint16BE();
+		Common::String name;
+		for (uint16 j = 0; j < len; j++) {
+			char c = (char)in->readByte();
+			if (c)
+				name += c;
+		}
+		syms.push_back(name);
+	}
+	in->seek(start);
+	Datum result = readValue(*in, 0, syms);
+	delete in;
+	g_lingo->push(result);
+}
+
+}
