+Datum Lingo::findSpriteBehavior(int spriteId, const Common::String &name, bool isMethod) {
+	Movie *movie = _vm->getCurrentMovie();
+	Score *score = movie ? movie->getScore() : nullptr;
+	Channel *channel = score ? score->getChannelById(spriteId) : nullptr;
+	if (!channel)
+		return Datum();
+	// a behavior just attached by Lingo (sprite.scriptInstanceList.add) must be found at once (Oncle Ernest 5:
+	// the bathyscaphe porthole button is added then called in the same handler)
+	channel->syncInstanceList();
+	for (auto &it : channel->_scriptInstanceList) {
+		if (it.type != OBJECT)
+			continue;
+		if (isMethod ? it.u.obj->getMethod(name).type != VOIDSYM : it.u.obj->hasProp(name))
+			return it;
+	}
+	return Datum();
+}
