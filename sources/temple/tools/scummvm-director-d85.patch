+	bool fromSave = PropSaveXtra::isGameSavePath(from);
+	Common::String toLower = to;
+	toLower.toLowercase();
+	bool toPhotoCast = !toLower.contains("save") && toLower.hasSuffix("c_photo.cst");
+	int result = 0;	// 0 = success
+	if (toPhotoCast) {
+		// The game swaps the photo cast file: fresh album (c_photobak) at new game, the saved one at load.
+		// Director keeps an open external cast across movies, so the copy done at every movie start
+		// only matters when no movie holds the album (save screen): mimic that.
+		if (!LingoImage::photoCastIsOpen()) {
