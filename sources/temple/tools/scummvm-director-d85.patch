+// Paige packed numbers (Hermes-Paige PGREAD.C, pgUnpackNum): a code byte (low nibble
+// 1 = short, 2 = long, 0 = bytes "<hex len>,<bytes>"), flag 0x80 = repeat the last
+// value, 0x40 = repeat it n times (n in the next byte); else hex digits follow.
+class PaigeWalker {
+public:
+	PaigeWalker(const byte *data, uint32 size) : _d(data), _size(size) {}
+	bool atEnd() const { return _repeat == 0 && _pos >= _size; }
+	int32 num() {
+		if (_repeat) {
+			_repeat--;
+			return _last;
+		}
+		if (_pos >= _size)
+			return 0;
+		byte c = _d[_pos];
+		byte code = c & 0x0f;
+		if (code == 1 || code == 2) {
+			_pos++;
+			if (c & 0x80) {
+				if ((c & 0x40) && _pos < _size)
+					_repeat = MAX<int>(_d[_pos++] - 1, 0);
+				return _last;
+			}
+			bool neg = false;
+			if (_pos < _size && _d[_pos] == '-') {
+				neg = true;
+				_pos++;
+			}
+			uint32 v = 0;
+			while (_pos < _size && isHexDigit(_d[_pos]))
+				v = v * 16 + hexValue(_d[_pos++]);
+			_last = neg ? -(int32)v : (int32)v;
+			return _last;
+		}
+		if (code == 0) {
+			bytes();
+			return 0;
+		}
+		_pos = _size;	// unknown code: stop
+		return 0;
+	}
+	Common::Array<byte> bytes() {
+		Common::Array<byte> out;
+		if (_pos >= _size || _d[_pos] != 0)
+			return out;
+		uint32 j = _pos + 1, len = 0;
+		while (j < _size && isHexDigit(_d[j]))
+			len = len * 16 + hexValue(_d[j++]);
+		if (j < _size && _d[j] == ',')
+			j++;
+		for (uint32 k = 0; k < len && j + k < _size; k++)
+			out.push_back(_d[j + k]);
+		_pos = MIN(_size, j + len);
+		return out;
+	}
+private:
+	const byte *_d;
+	uint32 _size, _pos = 0;
+	int32 _last = 0;
+	int _repeat = 0;
+};
+
+// Sections are introduced by 0x03 + 4 hex digits (Paige key) + 8 (length) + 8 (element count)
+static bool findSection(const Common::Array<byte> &data, int key, uint32 &start, uint32 &end) {
+	uint32 size = data.size();
+	int found = -1;
+	for (uint32 i = 0; i + 21 <= size; i++) {
+		if (data[i] != 0x03)
+			continue;
+		bool ok = true;
+		for (int k = 1; k <= 20 && ok; k++)
+			ok = isHexDigit(data[i + k]) && !(data[i + k] >= 'a' && data[i + k] <= 'f');
+		if (!ok)
+			continue;
+		if (found >= 0) {
+			end = i;
+			return true;
+		}
+		int num = 0;
+		for (int k = 1; k <= 4; k++)
+			num = num * 16 + hexValue(data[i + k]);
+		if (num == key) {
+			found = i;
+			start = i + 21;
+		}
+		i += 20;
+	}
+	if (found >= 0) {
+		end = size;
+		return true;
+	}
+	return false;
+}
+
+// Index used at text offset 0 by a run section (pairs of offset, index)
+static int firstRunIndex(const Common::Array<byte> &data, int key) {
+	uint32 s, e;
+	if (!findSection(data, key, s, e))
+		return 0;
+	PaigeWalker w(data.data() + s, e - s);
+	w.num();
+	return w.num();
+}
+
+bool decodeXMEDStyle(const Common::Array<byte> &data, PaigeStyle &style) {
+	// Field counts for the document revision used by Director 8.5 (style_info / par_info)
+	const int kStyleFields = 77, kParFields = 54, kFontNums = 17;
+	uint32 s, e;
+	if (!findSection(data, 6, s, e))
+		return false;
+
+	int styleIndex = firstRunIndex(data, 4);
+	PaigeWalker w(data.data() + s, e - s);
+	w.num();	// leading value
+	Common::Array<int32> rec;
+	for (int r = 0; r <= styleIndex && !w.atEnd(); r++) {
+		rec.clear();
+		for (int f = 0; f < kStyleFields; f++)
+			rec.push_back(w.num());
+	}
+	if (rec.size() != kStyleFields)
+		return false;
+
+	int fontIndex = rec[0];
+	style.r = (rec[9] >> 8) & 0xff;
+	style.g = (rec[10] >> 8) & 0xff;
+	style.b = (rec[11] >> 8) & 0xff;
+	if (rec[18] > 0)
+		style.pointSize = MAX(1, (int)((rec[18] + 0x8000) >> 16));
+	style.bold = rec[42] != 0;
+	style.italic = rec[43] != 0;
+	style.underline = rec[44] != 0;
+
+	if (findSection(data, 8, s, e)) {
+		PaigeWalker fw(data.data() + s, e - s);
+		for (int i = 0; i <= fontIndex && !fw.atEnd(); i++) {
+			Common::Array<byte> name = fw.bytes();
+			fw.bytes();	// alternate name
+			for (int k = 0; k < kFontNums; k++)
+				fw.num();
+			if (i == fontIndex && !name.empty()) {
+				uint len = MIN<uint>(name[0], name.size() - 1);
+				style.fontName = Common::String((const char *)name.data() + 1, len);
+			}
+		}
+	}
+
+	int parIndex = firstRunIndex(data, 5);
+	if (findSection(data, 7, s, e)) {
+		PaigeWalker pw(data.data() + s, e - s);
+		for (int r = 0; r <= parIndex && !pw.atEnd(); r++) {
+			int just = pw.num();
+			for (int f = 1; f < kParFields; f++)
+				pw.num();
+			if (r == parIndex)
+				style.justification = just;
+		}
+	}
+	style.valid = true;
+	return true;
+}
