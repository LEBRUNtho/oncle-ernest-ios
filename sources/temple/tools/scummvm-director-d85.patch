+
+static MethodProto imageMethods[] = {
+	{ "duplicate",	ImageObject::m_duplicate,	0, 0,	800 },
+	{ "crop",		ImageObject::m_crop,		1, 1,	800 },
+	{ "copyPixels",	ImageObject::m_copyPixels,	3, 4,	800 },
