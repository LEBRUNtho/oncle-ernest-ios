+	syncInstanceList();
+	debugC(3, kDebugLingoExec, "Channel::getLiveInstanceList(%p): %d instance(s)", (void *)this, _scriptInstanceList.size());
+	return _liveInstances;
+}
+
+void Channel::setInstanceList(const Datum &list) {
