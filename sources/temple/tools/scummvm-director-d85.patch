+bool DirectorEngine::sondeTouchFilter(Common::Event &event) {
+	uint32 now = g_system->getMillis();
+	if (event.type == Common::EVENT_MOUSEMOVE && event.customType == kSondeTouchBegan) {
+		_sondePendingUpAfter = false;	// un tab en attente est remplacé par le doigt
+		if (_sondeHasPendingUp) {	// relâché précédent pas encore livré : garder l'ordre
+			_sondeHasPendingUp = false;
