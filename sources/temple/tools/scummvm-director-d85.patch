+	{ nullptr, nullptr, 0, 0, 0 }
+};
+
+const Graphics::PixelFormat &ImageObject::pixelFormat() {
+	static const Graphics::PixelFormat fmt(4, 8, 8, 8, 8, 24, 16, 8, 0);
+	return fmt;
+}
+
+ImageObject::ImageObject(int w, int h, int depth) : Object<ImageObject>("image"), _depth(depth) {
+	_objType = kXtraObj;
+	_surface.create(MAX(w, 1), MAX(h, 1), pixelFormat());
+	_surface.fillRect(Common::Rect(_surface.w, _surface.h), pixelFormat().ARGBToColor(255, 255, 255, 255));
+}
+
+ImageObject::ImageObject(const ImageObject &other) : Object<ImageObject>(other), _depth(other._depth) {
+	_surface.copyFrom(other._surface);
+	if (other._indexed) {
+		_indexed = new Graphics::ManagedSurface();
+		_indexed->copyFrom(*other._indexed);
+	}
+}
+
+ImageObject::~ImageObject() {
+	delete _indexed;
+}
+
+void ImageObject::initMethods() {
+	Object<ImageObject>::initMethods(imageMethods);
+}
+
+bool ImageObject::hasProp(const Common::String &propName) {
+	return propName.equalsIgnoreCase("width") || propName.equalsIgnoreCase("height") ||
+		propName.equalsIgnoreCase("rect") || propName.equalsIgnoreCase("depth");
+}
+
+Datum ImageObject::getProp(const Common::String &propName) {
+	if (propName.equalsIgnoreCase("width"))
+		return Datum(_surface.w);
+	if (propName.equalsIgnoreCase("height"))
+		return Datum(_surface.h);
+	if (propName.equalsIgnoreCase("rect"))
+		return Datum(Common::Rect(_surface.w, _surface.h));
+	if (propName.equalsIgnoreCase("depth"))
+		return Datum(_depth);
+	return Datum();
+}
+
+Common::String ImageObject::asString() {
+	return Common::String::format("<image:%p %dx%d>", (void *)this, _surface.w, _surface.h);
+}
+
+Datum ImageObject::fromSurface(const Graphics::Surface &src, const byte *palette, int paletteColors) {
+	ImageObject *img = new ImageObject(src.w, src.h, src.format.bytesPerPixel == 1 ? 8 : 32);
+	const Graphics::PixelFormat &fmt = pixelFormat();
+	if (src.format.bytesPerPixel == 1) {
+		img->_indexed = new Graphics::ManagedSurface();
+		img->_indexed->copyFrom(src);
+		for (int y = 0; y < src.h; y++) {
+			const byte *in = (const byte *)src.getBasePtr(0, y);
+			uint32 *out = (uint32 *)img->_surface.getBasePtr(0, y);
+			for (int x = 0; x < src.w; x++) {
+				byte i = in[x];
+				byte r = 0, g = 0, b = 0;
+				if (palette && i < paletteColors) {
+					r = palette[i * 3];
+					g = palette[i * 3 + 1];
+					b = palette[i * 3 + 2];
+				}
+				out[x] = fmt.ARGBToColor(255, r, g, b);
+			}
+		}
+	} else {
+		for (int y = 0; y < src.h; y++) {
+			uint32 *out = (uint32 *)img->_surface.getBasePtr(0, y);
+			for (int x = 0; x < src.w; x++) {
+				uint8 a, r, g, b;
+				src.format.colorToARGB(src.getPixel(x, y), a, r, g, b);
+				out[x] = fmt.ARGBToColor(255, r, g, b);
+			}
+		}
+	}
+	return Datum(img);
+}
+
+static ImageObject *meImage() {
+	return static_cast<ImageObject *>(g_lingo->_state->me.u.obj);
+}
+
+static Common::Rect datumToRect(const Datum &d) {
+	if (d.type == RECT && d.u.farr->arr.size() >= 4)
+		return Common::Rect(d.u.farr->arr[0].asInt(), d.u.farr->arr[1].asInt(), d.u.farr->arr[2].asInt(), d.u.farr->arr[3].asInt());
+	return Common::Rect();
+}
+
+void ImageObject::m_duplicate(int nargs) {
+	g_lingo->dropStack(nargs);
+	g_lingo->push(Datum(new ImageObject(*meImage())));
+}
+
+// image.extractAlpha(): the alpha channel as an 8-bit grayscale image; Director's grayscale palette goes from white
+// (index 0, transparent) to black (255, opaque), so trimWhiteSpace() then gives the opaque area
+void ImageObject::m_extractAlpha(int nargs) {
+	ImageObject *me = meImage();
+	ImageObject *img = new ImageObject(me->_surface.w, me->_surface.h, 8);
+	const Graphics::PixelFormat &f = me->_surface.format;
+	for (int y = 0; y < me->_surface.h; y++)
+		for (int x = 0; x < me->_surface.w; x++) {
+			uint8 a, r, g, b;
+			f.colorToARGB(me->_surface.getPixel(x, y), a, r, g, b);
+			img->_surface.setPixel(x, y, img->_surface.format.ARGBToColor(255, 255 - a, 255 - a, 255 - a));
+		}
+	g_lingo->push(Datum(img));
+}
+
+// image.trimWhiteSpace(): the image cropped to its non-white area
+void ImageObject::m_trimWhiteSpace(int nargs) {
+	ImageObject *me = meImage();
+	const Graphics::PixelFormat &f = me->_surface.format;
+	int l = me->_surface.w, t = me->_surface.h, r = -1, b = -1;
+	for (int y = 0; y < me->_surface.h; y++)
+		for (int x = 0; x < me->_surface.w; x++) {
+			uint8 a, cr, cg, cb;
+			f.colorToARGB(me->_surface.getPixel(x, y), a, cr, cg, cb);
+			if (cr == 255 && cg == 255 && cb == 255)
+				continue;
+			l = MIN(l, x);
+			t = MIN(t, y);
+			r = MAX(r, x);
+			b = MAX(b, y);
+		}
+	if (r < 0) {
+		g_lingo->push(Datum(new ImageObject(0, 0, me->_depth)));
+		return;
+	}
+	Common::Rect rect(l, t, r + 1, b + 1);
+	ImageObject *img = new ImageObject(rect.width(), rect.height(), me->_depth);
+	img->_surface.blitFrom(me->_surface, rect, Common::Point(0, 0));
+	g_lingo->push(Datum(img));
+}
+
+void ImageObject::m_crop(int nargs) {
+	Common::Rect r = datumToRect(g_lingo->pop());
+	ImageObject *me = meImage();
+	r.clip(Common::Rect(me->_surface.w, me->_surface.h));
+	ImageObject *img = new ImageObject(MAX<int>(r.width(), 1), MAX<int>(r.height(), 1), me->_depth);
+	if (!r.isEmpty())
+		img->_surface.blitFrom(me->_surface, r, Common::Point(0, 0));
+	g_lingo->push(Datum(img));
+}
+
+// D8: "member.image" is the member's own image: copyPixels/fill on it change the member (Oncle Ernest 5:
+// the flame of Angkor prints its halo into member("cache mask").image)
+static void syncOwner(ImageObject *img) {
+	if (!img || img->_owner.member <= 0)
+		return;
+	Movie *movie = g_director->getCurrentMovie();
+	CastMember *member = movie ? movie->getCastMember(img->_owner) : nullptr;
+	if (!member || member->_type != kCastBitmap)
+		return;
+	BitmapCastMember *b = (BitmapCastMember *)member;
+	int regX = b->_regX, regY = b->_regY;
+	ImageObject *copy = new ImageObject(*img);
+	LingoImage::setMemberImage(member, Datum(copy));
+	b->_regX = regX;
+	b->_regY = regY;
+	// redraw the sprites showing this member, or using it as their mask (ink "mask" = member + 1)
+	Score *score = movie->getScore();
+	for (uint i = 0; score && i < score->_channels.size(); i++) {
+		Channel *ch = score->_channels[i];
+		if (!ch || !ch->_sprite)
+			continue;
+		const CastMemberID &c = ch->_sprite->_castId;
+		if (c == img->_owner || (ch->_sprite->_ink == kInkTypeMask && c.castLib == img->_owner.castLib && c.member + 1 == img->_owner.member))
+			ch->setDirty();
+	}
+}
+
+void ImageObject::m_copyPixels(int nargs) {
+	Datum params;
+	if (nargs == 4)
+		params = g_lingo->pop();
+	Common::Rect srcRect = datumToRect(g_lingo->pop());
+	Datum destD = g_lingo->pop();
+	Datum srcD = g_lingo->pop();
+	ImageObject *me = meImage();
+	if (!LingoImage::isImage(srcD)) {
+		warning("ImageObject::copyPixels: source is not an image: %s", srcD.asString(true).c_str());
+		return;
+	}
+	ImageObject *src = static_cast<ImageObject *>(srcD.u.obj);
+	Common::Rect destRect = datumToRect(destD);
+	if (destD.type == ARRAY && destD.u.farr->arr.size() == 4) {
+		// quad: use its bounding box
+		int l = 32767, t = 32767, r = -32768, b = -32768;
+		for (auto &p : destD.u.farr->arr) {
+			if (p.type != POINT)
+				continue;
+			int x = p.u.farr->arr[0].asInt(), y = p.u.farr->arr[1].asInt();
+			l = MIN(l, x); t = MIN(t, y); r = MAX(r, x); b = MAX(b, y);
+		}
+		destRect = Common::Rect(l, t, r, b);
+	}
+	if (srcRect.isEmpty() || destRect.isEmpty())
+		return;
+
+	int blend = 255;
+	int ink = 0;
+	if (params.type == PARRAY) {
+		for (auto &c : params.u.parr->arr) {
+			Common::String k = c.p.asString();
+			if (k.equalsIgnoreCase("blendLevel"))
+				blend = CLIP(c.v.asInt(), 0, 255);
+			else if (k.equalsIgnoreCase("blend"))
+				blend = CLIP(c.v.asInt() * 255 / 100, 0, 255);
+			else if (k.equalsIgnoreCase("ink"))
+				ink = c.v.asInt();
+		}
+	}
+
+	const Graphics::PixelFormat &fmt = pixelFormat();
+	for (int y = destRect.top; y < destRect.bottom; y++) {
+		if (y < 0 || y >= me->_surface.h)
+			continue;
+		int sy = srcRect.top + (y - destRect.top) * srcRect.height() / destRect.height();
+		if (sy < 0 || sy >= src->_surface.h)
+			continue;
+		uint32 *out = (uint32 *)me->_surface.getBasePtr(0, y);
+		const uint32 *in = (const uint32 *)src->_surface.getBasePtr(0, sy);
+		for (int x = destRect.left; x < destRect.right; x++) {
+			if (x < 0 || x >= me->_surface.w)
+				continue;
+			int sx = srcRect.left + (x - destRect.left) * srcRect.width() / destRect.width();
+			if (sx < 0 || sx >= src->_surface.w)
+				continue;
+			uint8 a, r, g, b;
+			fmt.colorToARGB(in[sx], a, r, g, b);
+			if ((ink == 36 || ink == 8) && r == 255 && g == 255 && b == 255)
+				continue;	// background transparent / matte
+			if (blend < 255) {
+				uint8 da, dr, dg, db;
+				fmt.colorToARGB(out[x], da, dr, dg, db);
+				r = (r * blend + dr * (255 - blend)) / 255;
+				g = (g * blend + dg * (255 - blend)) / 255;
+				b = (b * blend + db * (255 - blend)) / 255;
+			}
+			out[x] = fmt.ARGBToColor(255, r, g, b);
+		}
+	}
+	if (me->_indexed) {
+		delete me->_indexed;
+		me->_indexed = nullptr;
+		me->_depth = 32;
+	}
+	syncOwner(me);
+}
+
+void ImageObject::m_getPixel(int nargs) {
+	int x = 0, y = 0;
+	bool asInteger = false;
+	Common::Array<Datum> args;
+	for (int i = 0; i < nargs; i++)
+		args.insert_at(0, g_lingo->pop());
+	if (!args.empty() && args[0].type == POINT) {
+		x = args[0].u.farr->arr[0].asInt();
+		y = args[0].u.farr->arr[1].asInt();
+		asInteger = args.size() > 1;
+	} else if (args.size() >= 2) {
+		x = args[0].asInt();
+		y = args[1].asInt();
+		asInteger = args.size() > 2;
+	}
+	ImageObject *me = meImage();
+	if (x < 0 || y < 0 || x >= me->_surface.w || y >= me->_surface.h) {
+		g_lingo->push(Datum());
+		return;
+	}
+	if (me->_indexed) {
+		byte index = *(const byte *)me->_indexed->getBasePtr(x, y);
+		g_lingo->push(asInteger ? Datum((int)index) : LingoImage::makePaletteIndex(index));
+		return;
+	}
+	uint8 a, r, g, b;
+	pixelFormat().colorToARGB(me->_surface.getPixel(x, y), a, r, g, b);
+	g_lingo->push(asInteger ? Datum((int)((r << 16) | (g << 8) | b)) : LingoImage::makeColor(r, g, b));
+}
+
+void ImageObject::m_setPixel(int nargs) {
+	Datum color = g_lingo->pop();
+	int x = 0, y = 0;
+	if (nargs == 2) {
+		Datum p = g_lingo->pop();
+		if (p.type == POINT) {
+			x = p.u.farr->arr[0].asInt();
+			y = p.u.farr->arr[1].asInt();
+		}
+	} else {
+		y = g_lingo->pop().asInt();
+		x = g_lingo->pop().asInt();
+	}
+	ImageObject *me = meImage();
+	if (x < 0 || y < 0 || x >= me->_surface.w || y >= me->_surface.h) {
+		g_lingo->push(Datum(0));
+		return;
+	}
+	byte r, g, b;
+	LingoImage::colorToRGB(color, r, g, b);
+	me->_surface.setPixel(x, y, pixelFormat().ARGBToColor(255, r, g, b));
+	if (me->_indexed && LingoImage::isColor(color) && static_cast<ColorObject *>(color.u.obj)->_index >= 0)
+		*(byte *)me->_indexed->getBasePtr(x, y) = static_cast<ColorObject *>(color.u.obj)->_index;
+	g_lingo->push(Datum(1));
+}
+
+void ImageObject::m_fill(int nargs) {
+	Datum color = g_lingo->pop();
+	Common::Rect r = datumToRect(g_lingo->pop());
+	if (nargs == 3)	// fill(left, top, right, bottom...) not used: drop
+		g_lingo->pop();
+	ImageObject *me = meImage();
+	byte cr, cg, cb;
+	LingoImage::colorToRGB(color, cr, cg, cb);
+	r.clip(Common::Rect(me->_surface.w, me->_surface.h));
+	me->_surface.fillRect(r, pixelFormat().ARGBToColor(255, cr, cg, cb));
+	syncOwner(me);
+}
