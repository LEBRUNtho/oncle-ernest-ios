+	Common::Array<Datum> &live = _liveInstances.u.farr->arr;
+	if (!sameInstances(live, _liveSnapshot))
+	{
+		_scriptInstanceList = live;	// changed by Lingo (add, deleteAt...)
+		debugC(3, kDebugLingoExec, "Channel::syncInstanceList(%p): %d instance(s) from Lingo", (void *)this, _scriptInstanceList.size());
+	}
+	else if (!sameInstances(live, _scriptInstanceList))
+		live = _scriptInstanceList;	// changed by the engine (beginSprite, endSprite)
+	_liveSnapshot = _scriptInstanceList;
+}
+
+Datum Channel::getLiveInstanceList() {
+	if (_liveInstances.type != ARRAY) {
