+				e.mouse = Common::Point((r.left + r.right) / 2, (r.top + r.bottom) / 2);
+				e.customType = kSondeSynthetic;
+				e.type = Common::EVENT_MOUSEMOVE;
+				_injectedEvents.push_back(e);
+				// press + release a little later: the tab first has to see the hover (game 5 rollclick cursor)
+				e.type = Common::EVENT_LBUTTONDOWN;
+				_sondePendingDown = e;
+				_sondePendingDownAt = now + 100;
+				_sondeHasPendingDown = true;
+				_sondePendingUpAfter = true;
+			}
+		}
+		return true;
+	}
+	if ((event.type == Common::EVENT_LBUTTONDOWN || event.type == Common::EVENT_LBUTTONUP) &&
+			event.customType != kSondeSynthetic && (_sondeTouchHeld || now < _sondeSwallowUntil))
+		return true;
+	return false;
 }
 
