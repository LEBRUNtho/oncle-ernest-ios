+// Sonde : image du membre d'une piste en PNG (alpha du bitmap conservé)
+static bool sondeDumpChannel(Channel *ch, const Common::String &path) {
+	if (!ch || !ch->_sprite || !ch->_sprite->_cast)
+		return false;
+	Datum img = LingoImage::getMemberImage(ch->_sprite->_cast);
+	if (!LingoImage::isImage(img))
+		return false;
+	Common::DumpFile f;
+	if (!f.open(Common::Path(path)))
+		return false;
+	ImageObject *io = static_cast<ImageObject *>(img.u.obj);
+	Graphics::ManagedSurface out;
+	out.copyFrom(io->_surface);
+	if (ch->_sprite->_cast->_type == kCastBitmap && ((BitmapCastMember *)ch->_sprite->_cast)->_hasAlpha) {
+		const Graphics::Surface &src = ((BitmapCastMember *)ch->_sprite->_cast)->_picture->_surface;
+		for (int y = 0; y < out.h && y < src.h; y++)
+			for (int x = 0; x < out.w && x < src.w; x++) {
+				uint8 a, r, g, b, a2, r2, g2, b2;
+				src.format.colorToARGB(src.getPixel(x, y), a, r, g, b);
+				out.format.colorToARGB(out.getPixel(x, y), a2, r2, g2, b2);
+				out.setPixel(x, y, out.format.ARGBToColor(a, r2, g2, b2));
+			}
+	}
+	// mask ink: the next cast member is the mask (dark = opaque)
+	if (ch->_sprite->_ink == kInkTypeMask) {
+		CastMemberID maskId(ch->_sprite->_castId.member + 1, ch->_sprite->_castId.castLib);
+		CastMember *m = g_director->getCurrentMovie()->getCastMember(maskId);
+		Datum mimg = m ? LingoImage::getMemberImage(m) : Datum();
+		if (LingoImage::isImage(mimg)) {
+			const Graphics::ManagedSurface &ms = static_cast<ImageObject *>(mimg.u.obj)->_surface;
+			for (int y = 0; y < out.h; y++)
+				for (int x = 0; x < out.w; x++) {
+					uint8 a, r, g, b, a2, r2, g2, b2;
+					out.format.colorToARGB(out.getPixel(x, y), a2, r2, g2, b2);
+					uint8 na = 0;
+					if (x < ms.w && y < ms.h) {
+						ms.format.colorToARGB(ms.getPixel(x, y), a, r, g, b);
+						na = (r * 30 + g * 59 + b * 11) < 12800 ? a2 : 0;
+					}
+					out.setPixel(x, y, out.format.ARGBToColor(na, r2, g2, b2));
+				}
+		}
+	}
+	Image::writePNG(f, out.rawSurface());
+	return true;
+}
