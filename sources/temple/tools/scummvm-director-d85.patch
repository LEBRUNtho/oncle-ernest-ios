+static const Common::CustomEventType kSondeTouchEnded = 0x414C5445;	// 'ALTE'
+static const Common::CustomEventType kSondeTabMark = 0x414C5047;	// 'ALPG'
+static const Common::CustomEventType kSondeSynthetic = 0x414C5359;	// 'ALSY'
