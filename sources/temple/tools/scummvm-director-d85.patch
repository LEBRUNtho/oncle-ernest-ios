+// stage point <-> member point for an unrotated sprite (stretch handled)
+static bool spriteMapping(const Datum &spriteD, Common::Rect &bbox, Common::Point &reg, int &memW, int &memH) {
+	Score *score = g_director->getCurrentMovie()->getScore();
+	Channel *ch = score ? score->getChannelById(spriteD.asInt()) : nullptr;
+	if (!ch || !ch->_sprite || !ch->_sprite->_cast)
+		return false;
+	bbox = ch->getBbox();
+	Common::Rect mr = ch->_sprite->_cast->_initialRect;
+	memW = MAX<int>(mr.width(), 1);
+	memH = MAX<int>(mr.height(), 1);
+	reg = ch->_sprite->_cast->getRegistrationOffset();
+	return !bbox.isEmpty();
+}
+
+void b_mapStageToMember(int nargs) {
+	Datum p = g_lingo->pop();
+	Datum spr = g_lingo->pop();
+	Common::Rect bbox;
+	Common::Point reg;
+	int w, h;
+	if (p.type != POINT || !spriteMapping(spr, bbox, reg, w, h)) {
+		g_lingo->push(Datum());
+		return;
+	}
+	int x = p.u.farr->arr[0].asInt(), y = p.u.farr->arr[1].asInt();
+	if (!bbox.contains(x, y)) {
+		g_lingo->push(Datum());	// VOID outside the sprite
+		return;
+	}
+	int mx = (x - bbox.left) * w / bbox.width();
+	int my = (y - bbox.top) * h / bbox.height();
+	g_lingo->push(Datum(Common::Point(mx, my)));
+}
+
+void b_mapMemberToStage(int nargs) {
+	Datum p = g_lingo->pop();
+	Datum spr = g_lingo->pop();
+	Common::Rect bbox;
+	Common::Point reg;
+	int w, h;
+	if (p.type != POINT || !spriteMapping(spr, bbox, reg, w, h)) {
+		g_lingo->push(Datum());
+		return;
+	}
+	int x = p.u.farr->arr[0].asInt(), y = p.u.farr->arr[1].asInt();
+	g_lingo->push(Datum(Common::Point(bbox.left + x * bbox.width() / w, bbox.top + y * bbox.height() / h)));
+}
