+bool isImage(const Datum &d) {
+	return d.type == OBJECT && d.u.obj->getName() == "image" && (d.u.obj->getObjType() & kXtraObj);
+}
+
+bool isColor(const Datum &d) {
+	return d.type == OBJECT && d.u.obj->getName() == "color" && (d.u.obj->getObjType() & kXtraObj);
+}
+
+void colorToRGB(const Datum &d, byte &r, byte &g, byte &b) {
+	if (isColor(d)) {
+		ColorObject *c = static_cast<ColorObject *>(d.u.obj);
+		r = c->_r;
+		g = c->_g;
+		b = c->_b;
+		return;
+	}
+	int v = d.asInt();
+	if (v > 255 || v < 0) {
+		r = (v >> 16) & 0xff;
+		g = (v >> 8) & 0xff;
+		b = v & 0xff;
+	} else {
+		const byte *pal = g_director->getPalette();
+		r = pal[v * 3];
+		g = pal[v * 3 + 1];
+		b = pal[v * 3 + 2];
+	}
+}
+
+bool colorsEqual(const Datum &a, const Datum &b) {
+	ColorObject *ca = static_cast<ColorObject *>(a.u.obj);
+	ColorObject *cb = static_cast<ColorObject *>(b.u.obj);
+	if (ca->_index >= 0 && cb->_index >= 0)
+		return ca->_index == cb->_index;
+	return ca->_r == cb->_r && ca->_g == cb->_g && ca->_b == cb->_b;
+}
+
+void b_rgb(int nargs) {
+	if (nargs == 3) {
+		int b = g_lingo->pop().asInt();
+		int g = g_lingo->pop().asInt();
+		int r = g_lingo->pop().asInt();
+		g_lingo->push(makeColor(CLIP(r, 0, 255), CLIP(g, 0, 255), CLIP(b, 0, 255)));
+		return;
+	}
+	g_lingo->dropStack(nargs - 1);
+	Datum d = g_lingo->pop();
+	Common::String s = d.asString();
+	if (s.hasPrefix("#"))
+		s = s.substr(1);
+	uint v = 0;
+	for (uint i = 0; i < s.size(); i++) {
+		char c = s[i];
+		v <<= 4;
+		if (c >= '0' && c <= '9') v |= c - '0';
+		else if (c >= 'a' && c <= 'f') v |= c - 'a' + 10;
+		else if (c >= 'A' && c <= 'F') v |= c - 'A' + 10;
+	}
+	g_lingo->push(makeColor((v >> 16) & 0xff, (v >> 8) & 0xff, v & 0xff));
+}
