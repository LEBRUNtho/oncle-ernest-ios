+			}
+		}
+		_sondeTouchHeld = false;
+		_sondeSwallowUntil = now + 600;
+		event.customType = 0;
+		return false;
+	}
+	if (event.type == Common::EVENT_MOUSEMOVE && event.customType == kSondeTabMark) {
+		int idx = event.relMouse.x;
+		Score *score = getCurrentMovie() ? getCurrentMovie()->getScore() : nullptr;
+		if (score && idx >= 0 && idx < (int)_sondeTabChannels.size()) {
