+#include "common/macresman.h"
+#include "common/system.h"
+
+#include "director/director.h"
+#include "director/util.h"
+#include "director/lingo/lingo.h"
+#include "director/lingo/lingo-object.h"
+#include "director/lingo/lingo-utils.h"
+#include "director/lingo/xtras/v/v12dbe.h"
+
+/**************************************************
+ *
+ * USED IN:
+ * Le Temple perdu de l'oncle Ernest, La Statuette maudite de l'oncle Ernest
+ *
+ **************************************************/
+
+/*
+ * V12-DBE database Xtra, read-only subset: the game opens a database,
+ * selects every record of one table and reads them as property lists.
+ *
+ * The V12 file is made of 1024-byte pages. Page header (big endian): byte 1 = page type (3 = records),
+ * uint16 at 2 = sub type (0 = records), uint32 at 4 = next page, uint32 at 8 = previous page (page number n
+ * lives at file offset (n + 1) * 1024, 0xFFFFFFFF = none), uint16 at 12 = number of cells (0 = freed page,
+ * full of stale copies), uint32 at 14 = bytes used; cells start at 26.
+ * Cell: flag byte (0x01 = record start, 0x02 = continued at the start of the next page, 0x80 = 32-bit
+ * size), uint16 length including these 3 bytes. A record: uint32 id, size (16 or 32 bit), then "size"
+ * bytes: uint32 stamp, 00 00, kind byte, ... A data row has kind = its field count, followed by that many
+ * 0x10 + NUL-terminated Windows-1252 strings. A field definition has kind 5: table name, field name,
+ * 0x10, ..., uint16 field index in its last 2 bytes.
+ */
+
+namespace Director {
+
+const char *V12DbeXtra::xlibName = "v12dbe";
+const XlibFileDesc V12DbeXtra::fileNames[] = {
+	{ "V12-DBE for Director",	nullptr },
+	{ "v12dbe",					nullptr },
+	{ nullptr,					nullptr },
+};
+
+static MethodProto xlibMethods[] = {
+	{ "new",			V12DbeXtra::m_new,			0, 4,	500 },
+	{ "mGetRef",		V12DbeXtra::m_mGetRef,		0, 0,	500 },
+	{ "mSelectAll",		V12DbeXtra::m_mSelectAll,	0, 0,	500 },
+	{ "mGetSelection",	V12DbeXtra::m_mGetSelection, 0, 3,	500 },
+	{ nullptr, nullptr, 0, 0, 0 }
+};
+
+static const char *const kFieldNames[] = {
+	"OBJECTID", "REALNAME", "PAGE01", "PAGE02", "PAGE03",
+	"PAGE04", "PAGE05", "PAGE06", "PAGE07", "PAGE08"
+};
+
+static Common::String s_dbPath;
+static Common::String s_tableName;
+
+V12DbeXtraObject::V12DbeXtraObject(ObjectType ObjectType, const char *name) : Object<V12DbeXtraObject>(name) {
+	_objType = ObjectType;
+}
+
+bool V12DbeXtraObject::hasProp(const Common::String &propName) {
+	return (propName == "name");
+}
+
+Datum V12DbeXtraObject::getProp(const Common::String &propName) {
+	if (propName == "name")
+		return Datum(_name);
+	return Datum();
+}
+
+void V12DbeXtra::open(ObjectType type, const Common::Path &path) {
+	V12DbeXtraObject::initMethods(xlibMethods);
+	// One Xtra file provides both the database and the table classes
+	static const char *names[] = { "v12dbe", "v12table" };
+	for (const char *name : names) {
+		V12DbeXtraObject *xobj = new V12DbeXtraObject(type, name);
+		if (type == kXtraObj) {
+			g_lingo->_openXtras.push_back(name);
+			g_lingo->_openXtraObjects.push_back(xobj);
+		}
+		g_lingo->exposeXObject(name, xobj);
+	}
+}
+
+void V12DbeXtra::close(ObjectType type) {
+	V12DbeXtraObject::cleanupMethods();
+	g_lingo->_globalvars["v12dbe"] = Datum();
+	g_lingo->_globalvars["v12table"] = Datum();
+}
+
+void V12DbeXtra::m_new(int nargs) {
+	// new(xtra "v12dbe", path, mode, password) or new(xtra "v12table", dbRef, tableName)
+	Common::Array<Datum> args;
+	for (int i = 0; i < nargs; i++)
+		args.insert_at(0, g_lingo->pop());
+	if (g_lingo->_state->me.u.obj->getName().equalsIgnoreCase("v12dbe") && !args.empty())
+		s_dbPath = args[0].asString();
+	else if (g_lingo->_state->me.u.obj->getName().equalsIgnoreCase("v12table") && args.size() >= 2)
+		s_tableName = args[1].asString();
+	g_lingo->push(g_lingo->_state->me);
+}
+
+void V12DbeXtra::m_mGetRef(int nargs) {
+	g_lingo->dropStack(nargs);
+	g_lingo->push(g_lingo->_state->me);
+}
+
+void V12DbeXtra::m_mSelectAll(int nargs) {
+	g_lingo->dropStack(nargs);
+}
+
+void V12DbeXtra::m_mGetSelection(int nargs) {
+	g_lingo->dropStack(nargs);
+
+	Datum result;
+	result.type = ARRAY;
+	result.u.farr = new FArray;
+
+	Common::Path location = findPath(s_dbPath);
+	Common::SeekableReadStream *in = location.empty() ? nullptr : Common::MacResManager::openFileOrDataFork(location);
+	if (!in) {
+		warning("V12DbeXtra: cannot open database '%s'", s_dbPath.c_str());
+		g_lingo->push(result);
+		return;
+	}
+	uint32 size = in->size();
+	byte *d = (byte *)malloc(size);
+	in->read(d, size);
+	delete in;
+
+	const uint32 kPage = 1024, kHdr = 26;
+	uint32 numPages = size / kPage;
+	auto be = [&](uint32 off, int n) {
+		uint32 v = 0;
+		for (int k = 0; k < n; k++)
+			v = (v << 8) | (off + k < size ? d[off + k] : 0);
+		return v;
+	};
+	auto livePage = [&](uint32 p) {
+		return p >= 1 && p < numPages && d[p * kPage + 1] == 3 && be(p * kPage + 2, 2) == 0 && be(p * kPage + 12, 2) != 0;
+	};
+	struct Cell {
+		byte flag;
+		uint32 off, len;	// payload (after the 3-byte cell header)
+	};
+	auto pageCells = [&](uint32 p) {
+		Common::Array<Cell> cells;
+		uint32 used = be(p * kPage + 14, 4);
+		uint32 o = kHdr;
+		while (o + 3 <= kHdr + used && o + 3 <= kPage) {
+			uint32 at = p * kPage + o;
+			uint32 l = be(at + 1, 2);
+			if (l < 3 || o + l > kPage)
+				break;
+			cells.push_back(Cell{d[at], at + 3, l - 3});
+			o += l;
+		}
+		return cells;
+	};
+	struct Rec {
+		uint32 id;
+		Common::Array<Common::String> fields;
+	};
+	Common::HashMap<Common::String, Rec> best;
+	Common::Array<Common::String> keys;
+	Common::Array<Common::String> fieldNames;
+	for (uint32 p = 1; p < numPages; p++) {
+		if (!livePage(p))
+			continue;
+		Common::Array<Cell> cells = pageCells(p);
+		for (auto &c : cells) {
+			if (!(c.flag & 1) || c.len < 6)
+				continue;
+			bool wide = c.flag & 0x80;
+			uint32 id = be(c.off, 4);
+			uint32 recSize = wide ? be(c.off + 4, 4) : be(c.off + 4, 2);
+			uint32 skip = wide ? 8 : 6;
+			Common::Array<byte> body;
+			for (uint32 k = skip; k < c.len; k++)
+				body.push_back(d[c.off + k]);
+			// a record cut at the end of a page goes on at the start of the next page of the chain
+			uint32 q = p;
+			while (body.size() < recSize) {
+				uint32 nx = be(q * kPage + 4, 4);
+				if (nx == 0xFFFFFFFF || nx + 1 >= numPages || nx + 1 == q)
+					break;
+				q = nx + 1;
+				Common::Array<Cell> next = pageCells(q);
+				if (next.empty() || (next[0].flag & 1))
+					break;
+				for (uint32 k = 0; k < next[0].len; k++)
+					body.push_back(d[next[0].off + k]);
+			}
+			if (body.size() < recSize || recSize < 7)
+				continue;
+			body.resize(recSize);
+			byte kind = body[6];
+			Common::Array<Common::String> strs;
+			uint32 pos = 7;
+			if (pos < recSize && body[pos] == 0x10) {
+				while (strs.size() < kind && pos < recSize && body[pos] == 0x10) {
+					uint32 e = pos + 1;
+					while (e < recSize && body[e] != 0)
+						e++;
+					if (e >= recSize)
+						break;
+					Common::String str((const char *)&body[pos + 1], e - pos - 1);
+					strs.push_back(str.decode(Common::kWindows1252).encode(Common::kUtf8));
+					pos = e + 1;
+				}
+				if (strs.size() != kind || strs.empty() || strs[0].empty())
+					continue;
+				const Common::String &key = strs[0];
+				if (!best.contains(key)) {
+					keys.push_back(key);
+					best[key] = Rec{id, strs};
+				} else if (id > best[key].id) {
+					best[key] = Rec{id, strs};
+				}
+			} else if (kind == 5) {
+				// field definition: table\0 field\0 ... uint16 index
+				uint32 e1 = pos;
+				while (e1 < recSize && body[e1] != 0)
+					e1++;
+				uint32 e2 = e1 + 1;
+				while (e2 < recSize && body[e2] != 0)
+					e2++;
+				if (e2 >= recSize || recSize < 2)
+					continue;
+				Common::String table((const char *)&body[pos], e1 - pos);
+				Common::String field((const char *)&body[e1 + 1], e2 - e1 - 1);
+				uint32 idx = (body[recSize - 2] << 8) | body[recSize - 1];
+				if (!s_tableName.empty() && !table.equalsIgnoreCase(s_tableName))
+					continue;
+				if (idx < 64) {
+					if (fieldNames.size() <= idx)
+						fieldNames.resize(idx + 1);
+					fieldNames[idx] = field;
+				}
+			}
+		}
+	}
+	free(d);
+	if (fieldNames.empty())
+		for (uint f = 0; f < ARRAYSIZE(kFieldNames); f++)
+			fieldNames.push_back(kFieldNames[f]);
+	Common::sort(keys.begin(), keys.end());
+	for (auto &key : keys) {
+		Datum rec;
+		rec.type = PARRAY;
+		rec.u.parr = new PArray;
+		for (uint f = 0; f < fieldNames.size(); f++) {
+			Datum p(fieldNames[f]);
+			p.type = SYMBOL;
+			rec.u.parr->arr.push_back(PCell(p, Datum(f < best[key].fields.size() ? best[key].fields[f] : Common::String())));
+		}
+		result.u.farr->arr.push_back(rec);
+	}
+	debugC(2, kDebugXObj, "V12DbeXtra: %d records read from '%s'", (int)keys.size(), s_dbPath.c_str());
+	g_lingo->push(result);
+}
