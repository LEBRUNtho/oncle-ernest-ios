+// ============================================================================================================
+// Sonde Album : dossier de sauvegarde choisi par le joueur (survit aux réinstallations Feather, qui changent
+// l'identifiant de l'app et donc son dossier Documents). ScummVM iOS ne peut écrire que dans son propre dossier
+// (Documents/Savegames, système de fichiers « chroot ») : on tient donc un MIROIR. Au lancement, avant le jeu, le dossier
+// choisi → Savegames ; puis toutes les 5 s et au passage en arrière-plan, Savegames → dossier choisi (fichier plus récent
+// seulement, date recopiée pour éviter les allers-retours). Le choix est mémorisé par un signet de sécurité (perdu à la
+// réinstallation : le sélecteur réapparaît alors une fois). Simulateur : variable ALBUM_SAVE_DIR = dossier à utiliser.
+// ============================================================================================================
+static NSURL *g_albumSaveURL = nil;	// retenu (pas d'ARC dans ce backend)
+static NSString *const kAlbumSaveBookmarkKey = @"album_save_bookmark";
+
+static NSString *albumLocalSaveDir() {
+	return [[NSString stringWithUTF8String:iOS7_getDocumentsDir().c_str()] stringByAppendingPathComponent:@"Savegames"];
+}
+
+// Copie les fichiers de from vers to quand ils sont absents ou plus récents (d'au moins 1 s) ; renvoie le nombre copié
+static int albumMirror(NSString *from, NSString *to) {
+	NSFileManager *fm = [NSFileManager defaultManager];
+	NSArray<NSString *> *names = [fm contentsOfDirectoryAtPath:from error:nil];
+	int copied = 0;
+	for (NSString *name in names) {
+		if ([name hasPrefix:@"."])
+			continue;
+		NSString *src = [from stringByAppendingPathComponent:name];
+		NSString *dst = [to stringByAppendingPathComponent:name];
+		NSDictionary *sa = [fm attributesOfItemAtPath:src error:nil];
+		if (![[sa fileType] isEqualToString:NSFileTypeRegular])
+			continue;
+		NSDate *sd = [sa fileModificationDate];
+		NSDictionary *da = [fm attributesOfItemAtPath:dst error:nil];
+		if (da && [[da fileModificationDate] timeIntervalSinceDate:sd] > -1.0)
+			continue;
+		[fm removeItemAtPath:dst error:nil];
+		if ([fm copyItemAtPath:src toPath:dst error:nil]) {
+			[fm setAttributes:@{NSFileModificationDate: sd} ofItemAtPath:dst error:nil];
+			copied++;
+		}
+	}
+	return copied;
+}
+
+static void albumSyncOut() {
+	if (!g_albumSaveURL)
+		return;
+	const int n = albumMirror(albumLocalSaveDir(), [g_albumSaveURL path]);
+	if (n)
+		NSLog(@"Sonde Album: %d sauvegarde(s) copiée(s) vers %@", n, [g_albumSaveURL path]);
+}
+
+static void albumUseSaveURL(NSURL *url) {
+	[g_albumSaveURL release];
+	g_albumSaveURL = [url retain];
+	NSString *local = albumLocalSaveDir();
+	const int in = albumMirror([url path], local);
+	const int out = albumMirror(local, [url path]);
+	NSLog(@"Sonde Album: dossier de sauvegarde %@ (%d entrée(s), %d sortie(s))", [url path], in, out);
+	static NSTimer *timer = nil;
+	if (!timer) {
+		timer = [[NSTimer scheduledTimerWithTimeInterval:5.0 repeats:YES block:^(NSTimer *t) { albumSyncOut(); }] retain];
+		[[NSNotificationCenter defaultCenter] addObserverForName:UIApplicationDidEnterBackgroundNotification object:nil queue:nil usingBlock:^(NSNotification *n) { albumSyncOut(); }];
+		[[NSNotificationCenter defaultCenter] addObserverForName:UIApplicationWillTerminateNotification object:nil queue:nil usingBlock:^(NSNotification *n) { albumSyncOut(); }];
+	}
+}
+
+@interface AlbumSaveFolderPicker : NSObject <UIDocumentPickerDelegate>
+@property (nonatomic, copy) void (^done)(void);
+@end
+
+@implementation AlbumSaveFolderPicker
+- (void)finish {
+	void (^d)(void) = [self.done retain];
+	self.done = nil;
+	if (d)
+		d();
+	[d release];
+	[self release];	// retenu à la présentation
+}
+- (void)documentPicker:(UIDocumentPickerViewController *)controller didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls {
+	NSURL *url = urls.firstObject;
+	if (url && [url startAccessingSecurityScopedResource]) {
+		NSData *bm = [url bookmarkDataWithOptions:0 includingResourceValuesForKeys:nil relativeToURL:nil error:nil];
+		if (bm)
+			[[NSUserDefaults standardUserDefaults] setObject:bm forKey:kAlbumSaveBookmarkKey];
+		albumUseSaveURL(url);
+	}
+	[self finish];
+}
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller {
+	NSLog(@"Sonde Album: choix du dossier de sauvegarde annulé (sauvegardes dans l'app seulement)");
+	[self finish];
+}
+@end
+
+// Dossier déjà choisi (signet) → miroir immédiat et YES ; sinon NO (il faudra présenter le sélecteur)
+static BOOL albumRestoreSaveFolder() {
+	const char *simDir = getenv("ALBUM_SAVE_DIR");
+	if (simDir && *simDir) {
+		[[NSFileManager defaultManager] createDirectoryAtPath:[NSString stringWithUTF8String:simDir] withIntermediateDirectories:YES attributes:nil error:nil];
+		albumUseSaveURL([NSURL fileURLWithPath:[NSString stringWithUTF8String:simDir]]);
+		return YES;
+	}
+	NSData *bm = [[NSUserDefaults standardUserDefaults] objectForKey:kAlbumSaveBookmarkKey];
+	if (!bm)
+		return NO;
+	BOOL stale = NO;
+	NSURL *url = [NSURL URLByResolvingBookmarkData:bm options:0 relativeToURL:nil bookmarkDataIsStale:&stale error:nil];
+	if (!url || ![url startAccessingSecurityScopedResource])
+		return NO;
+	if (stale) {
+		NSData *nbm = [url bookmarkDataWithOptions:0 includingResourceValuesForKeys:nil relativeToURL:nil error:nil];
+		if (nbm)
+			[[NSUserDefaults standardUserDefaults] setObject:nbm forKey:kAlbumSaveBookmarkKey];
+	}
+	albumUseSaveURL(url);
+	return YES;
+}
+
+static void albumPresentSaveFolderPicker(UIViewController *host, void (^done)(void)) {
+#if TARGET_OS_IOS
+	AlbumSaveFolderPicker *delegate = [[AlbumSaveFolderPicker alloc] init];	// libéré par finish
+	delegate.done = done;
+	UIDocumentPickerViewController *picker = [[[UIDocumentPickerViewController alloc] initWithDocumentTypes:@[@"public.folder"] inMode:UIDocumentPickerModeOpen] autorelease];
+	picker.delegate = delegate;
+	picker.allowsMultipleSelection = NO;
+	picker.modalPresentationStyle = UIModalPresentationFormSheet;
+	picker.title = @"Dossier des sauvegardes";
+	if (host.view.window) {
+		[host presentViewController:picker animated:YES completion:nil];
+	} else {
+		[delegate finish];
+	}
+#else
+	done();
+#endif
+}
