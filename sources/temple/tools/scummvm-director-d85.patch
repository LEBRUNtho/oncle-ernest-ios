+// Files of the game's SAVE folder are emulated with ScummVM save files (see PropSaveXtra::gameSaveName);
+// a folder "SAVE\\X" exists when a file "<prefix>SAVE-X-..." exists (an empty "-.folder" marks created ones).
+static Common::SaveFileManager *saves() {
+	return g_system->getSavefileManager();
+}
+
+static Common::StringArray listSaveFolder(const Common::String &folderName) {
+	return saves()->listSavefiles(folderName + "-*");
+}
+
+static bool copySaveFile(const Common::String &from, const Common::String &to) {
+	Common::InSaveFile *in = saves()->openForLoading(from);
+	if (!in)
+		return false;
+	Common::OutSaveFile *out = saves()->openForSaving(to, false);
+	if (!out) {
+		delete in;
+		return false;
+	}
+	byte buf[4096];
+	while (!in->eos()) {
+		uint32 n = in->read(buf, sizeof(buf));
+		if (n)
+			out->write(buf, n);
+	}
+	out->finalize();
+	delete out;
+	delete in;
+	return true;
+}
+
+static bool matchSpec(const Common::String &file, const Common::String &spec) {
+	if (spec.empty() || spec == "*.*" || spec == "*")
+		return true;
+	return Common::matchString(file.c_str(), spec.c_str(), true);
+}
