+// Sonde Ernest 4 (iOS) : écran du nom (s00_save) = clavier virtuel ouvert, image remontée juste sous le nom ;
+// un tap sur le parchemin le rouvre s'il a été rangé ; pas de curseur souris (le doigt montre où l'on agit)
+static Common::String sondeScreenName() {
+	Datum gL = g_lingo->_globalvars.getValOrDefault("gL");
