+		_albumTabButtons = [[NSMutableArray alloc] init];
+	}
+	if (_albumTabsString && [_albumTabsString isEqualToString:tabs])
+		return;
+	[_albumTabsString release];
+	_albumTabsString = [tabs copy];
+	NSMutableArray<NSDictionary *> *list = [NSMutableArray array];
+	_albumTabCurrent = -1;
+	for (NSString *entry in [tabs componentsSeparatedByString:@";"]) {
+		NSArray<NSString *> *f = [entry componentsSeparatedByString:@"|"];
+		if (f.count < 5)
+			continue;
+		if ([f[3] isEqualToString:@"1"])
+			_albumTabCurrent = (NSInteger)list.count;
+		[list addObject:@{@"name": f[0], @"vis": @([f[1] isEqualToString:@"1"]), @"title": f[2], @"bottom": @([f[4] isEqualToString:@"1"])}];
+	}
+	[_albumTabs release];
+	_albumTabs = [list retain];
+	// autant de boutons que de marque-pages
