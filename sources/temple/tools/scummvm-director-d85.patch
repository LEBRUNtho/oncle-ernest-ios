+// Sonde Ernest 4 (étude de faisabilité, jeu « Le Temple perdu ») : SONDE_SHOT_DIR = dossier où déposer une capture
+// toutes les 2 s (shot_NNNN.png) ; /tmp/ernest4_cmd = lignes « click X Y » ou « key CODE » jouées dans l'ordre.
+// Sonde Ernest 4 : the page tabs of the album (BEH_POSTIT / BEH_POSTIT_BIS behaviours) for the iOS bookmark menu.
+// album_tabs = "name|visible|title|current|bottom;..." (name -> album_icons/tabs/<name>.png)
+void DirectorEngine::sondePublishTabs() {
+	Movie *movie = getCurrentMovie();
+	Score *score = movie ? movie->getScore() : nullptr;
+	if (!score)
+		return;
+	Datum gL = g_lingo->_globalvars.getValOrDefault("gL");
+	Datum texts;
+	if (gL.type == PARRAY) {
+		for (auto &c : gL.u.parr->arr)
+			if (c.p.asString().equalsIgnoreCase("LSPTEXTPOSTIT") || c.p.asString().equalsIgnoreCase("LSPTEXTMARKTAPAGE"))
+				texts = c.v;
+	}
+	Common::String screen;
+	if (gL.type == PARRAY)
+		for (auto &c : gL.u.parr->arr)
+			if (c.p.asString().equalsIgnoreCase("SCREEN"))
+				screen = c.v.asString();
+
+	Common::String out;
+	Common::Array<int> channels;
+	for (uint i = 1; i < score->_channels.size(); i++) {
+		Channel *ch = score->_channels[i];
+		if (!ch || !ch->_sprite)
+			continue;
+		for (auto &inst : ch->_scriptInstanceList) {
+			if (inst.type != OBJECT)
+				continue;
+			Common::String name = inst.u.obj->getName();
+			if (!name.equalsIgnoreCase("BEH_POSTIT_BIS") && !name.equalsIgnoreCase("BEH_POSTIT") && !name.equalsIgnoreCase("BEH_MARKTAPAGE"))
+				continue;
+			if (!inst.u.obj->hasProp("pTargetName"))
+				continue;
+			Common::String target = inst.u.obj->getProp("pTargetName").asString();
+			if (target.empty())
+				continue;
+			Common::String title = target;
+			if (texts.type == PARRAY)
+				for (auto &c : texts.u.parr->arr)
+					if (c.p.asString().equalsIgnoreCase(target))
+						title = c.v.asString();
+			title.replace('|', ' ');
+			title.replace(';', ' ');
+			bool vis = ch->_visible;
+			bool cur = target.equalsIgnoreCase(screen);
+			// jeu 5 : current page = pCurrentMarkTaPage
+			if (inst.u.obj->hasProp("pCurrentMarkTaPage"))
+				cur = inst.u.obj->getProp("pCurrentMarkTaPage").asInt() != 0;
+			bool bottom = ch->getBbox().top > 240;
+			out += Common::String::format("%s%s|%d|%s|%d|%d", out.empty() ? "" : ";", ("tab_" + target).c_str(), vis ? 1 : 0, title.c_str(), cur ? 1 : 0, bottom ? 1 : 0);
+			channels.push_back(i);
+			break;
+		}
+	}
+	_sondeTabChannels = channels;
+	Common::String old = ConfMan.hasKey("album_tabs", Common::ConfigManager::kTransientDomain) ? ConfMan.get("album_tabs", Common::ConfigManager::kTransientDomain) : Common::String();
+	if (old != out)
+		ConfMan.set("album_tabs", out, Common::ConfigManager::kTransientDomain);
+}
