+	NSString *b = [NSString stringWithUTF8String:tabs.c_str()] ?: @"";
+	dispatch_async(dispatch_get_main_queue(), ^{
+		[[iOS7AppDelegate iPhoneView] albumSetTools:t legend:l tabs:b gameRect:CGRectMake(x, y, w, h)];
+	});
+}
+#else
