+void Window::drawQuad(Channel *channel, Common::Rect destRect, Graphics::ManagedSurface *blitTo) {
+	Graphics::ManagedSurface *src = channel->sondeSurface();
+	if (!src || src->w <= 0 || src->h <= 0 || src->format.bytesPerPixel < 2 || blitTo->format.bytesPerPixel < 2)
+		return;
+	Sprite *sp = channel->_sprite;
+	double q[8];
+	channel->transformCorners(q);
+	destRect.clip(channel->getBbox());
+	destRect.clip(blitTo->getBounds());
+	const InkType ink = sp->_ink;
+	const uint32 white = g_director->_wm->_colorWhite;
+	const Graphics::Surface *mask = (ink == kInkTypeMask || ink == kInkTypeMatte) ? channel->getMask() : nullptr;
+	const bool srcAlpha = sp->_cast && sp->_cast->_type == kCastBitmap && ((BitmapCastMember *)sp->_cast)->_hasAlpha && src->format.aBits() > 0;
+	int opacity = 255;
+	if ((sp->_thickness & kTHasBlend) || ink == kInkTypeBlend)
+		opacity = 255 - sp->_blendAmount;
+	if (opacity <= 0)
+		return;
+	const Graphics::PixelFormat &fmt = blitTo->format;
+	for (int y = destRect.top; y < destRect.bottom; y++)
+		for (int x = destRect.left; x < destRect.right; x++) {
+			double u, v;
+			if (!quadInverse(q, x + 0.5, y + 0.5, u, v))
+				continue;
+			const int sx = CLIP<int>((int)(u * src->w), 0, src->w - 1), sy = CLIP<int>((int)(v * src->h), 0, src->h - 1);
+			if (mask) {
+				if (sx >= mask->w || sy >= mask->h || !*(const byte *)mask->getBasePtr(sx, sy))
+					continue;
+			}
+			const uint32 c = src->getPixel(sx, sy);
+			if (ink == kInkTypeBackgndTrans && c == white)
+				continue;
+			uint8 a, r, g, b;
+			src->format.colorToARGB(c, a, r, g, b);
+			if (sp->_hsbHue >= 0 || sp->_hsbSat >= 0 || sp->_hsbBright >= 0)
+				applyHsb(sp, r, g, b);
+			int alpha = srcAlpha ? a * opacity / 255 : opacity;
+			if (alpha <= 0)
+				continue;
+			if (ink == kInkTypeAddPin || ink == kInkTypeAdd || ink == kInkTypeLight) {
+				// additive inks (lights): dest + src
+				uint8 da, dr, dg, db;
+				fmt.colorToARGB(blitTo->getPixel(x, y), da, dr, dg, db);
+				blitTo->setPixel(x, y, fmt.RGBToColor(MIN(255, dr + r * alpha / 255), MIN(255, dg + g * alpha / 255), MIN(255, db + b * alpha / 255)));
+				continue;
+			}
+			if (alpha >= 255) {
+				blitTo->setPixel(x, y, fmt.RGBToColor(r, g, b));
+				continue;
+			}
+			if (!srcAlpha && src->format.aBits() == 0)
+				a = 255;
+			uint8 da, dr, dg, db;
+			fmt.colorToARGB(blitTo->getPixel(x, y), da, dr, dg, db);
+			blitTo->setPixel(x, y, fmt.RGBToColor((r * alpha + dr * (255 - alpha)) / 255, (g * alpha + dg * (255 - alpha)) / 255, (b * alpha + db * (255 - alpha)) / 255));
+		}
+}
