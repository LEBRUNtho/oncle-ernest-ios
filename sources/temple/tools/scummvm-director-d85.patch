+				"  repeat with vObj in the pLISTObjects of the pObjectFactory of getaProp(gSp, #Main)\n"
+				"   if mAskTypeOf(vObj, #Dynamite) then set vBusy to 1\n"
+				"  end repeat\n"
+				"  if the pState of getaProp(gSp, #Main) = #wait and not vBusy then\n"
+				// aSaveGame() du jeu SANS gSp.GAME.mClear()/mRestore() : ces deux-là préparent une sortie de page
+				// (la mine détruit ses dynamites, la Cité du soleil oublie les pièces de l'aérocondor posées)
+				"   set vFolderName to the moviePath & \"SAVE\\\" & getaProp(gL, #SAVESLOT)\n"
+				"   if not baFolderExists(vFolderName) then baCreateFolder(vFolderName)\n"
+				"   save(castLib(\"c_photo\"), the moviePath & \"CST\\c_photo.cst\")\n"
+				"   baCopyFile(the moviePath & \"CST\\c_photo.cst\", vFolderName & \"\\c_photo.cst\", \"Always\")\n"
+				"   set the pState of getaProp(gSp, #Main) to #wait\n"
+				"   aSaveTheScreen()\n"
+				"   setaProp(gL, #INVENTORY, [:])\n"
+				"   repeat with vObj in the pLISTObjects of the pObjectFactory of getaProp(gSp, #Main)\n"
+				"    if (mGetState(vObj) = #cardass) or (mGetType(vObj) = #TOOL) then\n"
+				"     set vPropList to [:]\n"
+				"     mSave(vObj, vPropList)\n"
+				"     addProp(getaProp(gL, #INVENTORY), aExtractScriptName(vObj), [mGetType(vObj), vPropList])\n"
+				"    end if\n"
+				"   end repeat\n"
+				"   baCopyXFiles(the moviePath & \"SAVE\\TEMP\", vFolderName, \"*.lex\", \"Always\")\n"
+				"   savePropsToDisk(vFolderName & \"\\Save.lex\", gL)\n"
+				"   set the pState of getaProp(gSp, #Main) to #wait\n"
+				"   set gSondeAutoOK to 1\n"
+				"  end if\n"
+				" end if\n"
+				"end if");
+			bool ok = g_lingo->_globalvars.getValOrDefault("gSondeAutoOK").asInt() == 1;
+			autoNext = now + (ok ? 180000 : 5000);
+			if (ok)
+				debug("sonde : sauvegarde automatique (%s)", mname.c_str());
+		}
+	}
+	// Ernest 4, vallée sacrée : au retour de Punas gagné, le passage vers le sorcier s'ouvre dans l'état #Init du jeu
+	// de la page ; la restauration de la page remet cet état à #wait et le passage restait fermé. On l'ouvre ici,
+	// une fois, quand toutes les conditions du jeu sont réunies.
+	if (gameIsAlbert4()) {
+		static uint32 lastPassageCheck = 0;
+		Movie *pm = getCurrentMovie();
+		if (pm && now - lastPassageCheck > 1000 && pm->getMacName().hasPrefixIgnoreCase("s03a_vall")) {
+			lastPassageCheck = now;
+			g_debugger->lingoEval("global gL, gSp, gTurningPage\n"
+				"if listP(gSp) and listP(gL) and not gTurningPage then\n"
+				" if getaProp(gSp, #PASSAGE) <> VOID and getaProp(gSp, #GAME) <> VOID then\n"
+				"  set vS to getaProp(getaProp(gL, #SC), #s03b_cano)\n"
+				"  if listP(vS) then\n"
+				"   if getaProp(vS, #win) = 1 and getaProp(getaProp(getaProp(gL, #SC), #s03a_vall), #MESSAGE_OPEN) = VOID then\n"
+				"    if the pState of getaProp(gSp, #PASSAGE) = #close then mOpenPassage(getaProp(gSp, #PASSAGE))\n"
+				"   end if\n"
+				"  end if\n"
+				" end if\n"
+				"end if");
+		}
+	}
+	if (_sondeSkipCinematic) {
+		_sondeSkipCinematic = false;
+		// same as the game's own skip (right click): the film leaves the stage, next frame
+		g_debugger->lingoEval("set the locH of sprite 2 to the locH of sprite 2 + 1000\nupdateStage\ngo(the frame + 1)");
+	}
+	if (_sondeSkipIntro) {
+		_sondeSkipIntro = false;
+		g_debugger->lingoEval("go(1, \"s05a_map\")");
+	}
+	static Common::String snapName;
+	static int shotEvery = getenv("SONDE_SHOT_EVERY") ? atoi(getenv("SONDE_SHOT_EVERY")) : 2000;
+	if (dir && ((shotEvery > 0 && now - lastShot >= (uint32)shotEvery) || !snapName.empty())) {
+		lastShot = now;
+		Graphics::Surface *scr = g_system->lockScreen();
+		if (scr) {
+			Common::DumpFile f;
+			Common::String fname = snapName.empty() ? Common::String::format("%s/shot_%04u.png", dir, shotNo++) : Common::String::format("%s/%s.png", dir, snapName.c_str());
+			snapName.clear();
+			if (f.open(Common::Path(fname))) {
+				byte pal[768];
+				if (scr->format.bytesPerPixel == 1)
+					g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+				Image::writePNG(f, *scr, scr->format.bytesPerPixel == 1 ? pal : nullptr);
+			}
+			g_system->unlockScreen();
+		}
+	}
+	// one key per tick so that "the key" is right for each keyDown
+	static Common::Array<Common::KeyState> pendingKeys;
+	static uint32 lastKey = 0;
+	if (!pendingKeys.empty() && now - lastKey >= 120) {
+		lastKey = now;
+		Common::Event e;
+		e.kbd = pendingKeys.remove_at(0);
+		e.type = Common::EVENT_KEYDOWN;
+		g_system->getEventManager()->pushEvent(e);
+		e.type = Common::EVENT_KEYUP;
+		g_system->getEventManager()->pushEvent(e);
+	}
+	// Mac : /tmp/ernest4_cmd ; iOS : seulement si album_remote (simulateur), fichier à part pour ne pas
+	// rejouer les commandes destinées à la version Mac
+#ifdef IPHONE
+	static const bool remoteOn = ConfMan.getBool("album_remote");
+	static const char *cmdFile = "/tmp/ernest4_sim_cmd";
+#else
+	static const bool remoteOn = true;
+	static const char *cmdFile = "/tmp/ernest4_cmd";
+#endif
+	static bool cmdStarted = false;
+	Common::File c;
+	if (remoteOn && !cmdStarted) {
+		// ignore what is already in the file at startup
+		cmdStarted = true;
+		Common::FSNode n{Common::Path(cmdFile)};
+		if (n.exists() && c.open(n))
+			cmdPos = c.size();
+		c.close();
+	}
+	static uint32 lastCmdCheck = 0;
+	bool cmdReady = false;
+	if (remoteOn && now - lastCmdCheck >= 25) {
+		lastCmdCheck = now;
+		Common::FSNode n{Common::Path(cmdFile)};
+		cmdReady = n.exists() && c.open(n);
+	}
+	if (cmdReady) {
+		c.seek(cmdPos);
+		while (!c.eos()) {
+			Common::String l = c.readLine();
+			if (c.eos() && l.empty())
+				break;
+			int x, y;
+			if (sscanf(l.c_str(), "down %d %d", &x, &y) == 2 || sscanf(l.c_str(), "move %d %d", &x, &y) == 2 || sscanf(l.c_str(), "up %d %d", &x, &y) == 2) {
+				// Sonde : glisser en plusieurs temps (down X Y / move X Y / up X Y)
+				Common::Event e;
+				e.mouse = Common::Point(x, y);
+				e.type = Common::EVENT_MOUSEMOVE;
+				g_system->getEventManager()->pushEvent(e);
+				if (l.hasPrefix("down")) {
+					e.type = Common::EVENT_LBUTTONDOWN;
+					g_system->getEventManager()->pushEvent(e);
+				} else if (l.hasPrefix("up")) {
+					e.type = Common::EVENT_LBUTTONUP;
+					g_system->getEventManager()->pushEvent(e);
+				}
+				debug("sonde : %s", l.c_str());
+			} else if (sscanf(l.c_str(), "tbegin %d %d", &x, &y) == 2 || sscanf(l.c_str(), "tend %d %d", &x, &y) == 2) {
+				// Sonde : contact du doigt exactement comme la couche iOS (début / fin marqués)
+				Common::Event e;
+				e.mouse = Common::Point(x, y);
+				e.type = Common::EVENT_MOUSEMOVE;
+				e.customType = l.hasPrefix("tbegin") ? 0x414C5442 : 0x414C5445;
+				g_system->getEventManager()->pushEvent(e);
+				debug("sonde : %s", l.c_str());
+			} else if (l.hasPrefix("tabname ")) {
+				// Sonde : marque-page désigné par sa page cible, même chemin que le menu iPhone
+				Common::String want = l.substr(8);
+				Score *score = getCurrentMovie() ? getCurrentMovie()->getScore() : nullptr;
+				for (uint k = 0; score && k < _sondeTabChannels.size(); k++) {
+					Channel *ch = score->getChannelById(_sondeTabChannels[k]);
+					if (!ch)
+						continue;
+					bool hit = false;
+					for (auto &inst : ch->_scriptInstanceList)
+						if (inst.type == OBJECT && inst.u.obj->hasProp("pTargetName") && inst.u.obj->getProp("pTargetName").asString().equalsIgnoreCase(want))
+							hit = true;
+					if (!hit)
+						continue;
+					Common::Event e;
+					e.type = Common::EVENT_MOUSEMOVE;
+					e.customType = 0x414C5047;
+					e.relMouse = Common::Point(k, 0);
+					g_system->getEventManager()->pushEvent(e);
+					debug("sonde : tabname %s -> %d", want.c_str(), k);
+					break;
+				}
+			} else if (sscanf(l.c_str(), "tab %d", &x) == 1) {
+				// Sonde : bouton n du menu iPhone des marque-pages (même chemin que la couche iOS)
+				Common::Event e;
+				e.type = Common::EVENT_MOUSEMOVE;
+				e.customType = 0x414C5047;
+				e.relMouse = Common::Point(x, 0);
+				g_system->getEventManager()->pushEvent(e);
+				debug("sonde : %s", l.c_str());
+			} else if (sscanf(l.c_str(), "click %d %d", &x, &y) == 2) {
+				Common::Event e;
+				e.mouse = Common::Point(x, y);
+				e.type = Common::EVENT_MOUSEMOVE;
+				g_system->getEventManager()->pushEvent(e);
+				e.type = Common::EVENT_LBUTTONDOWN;
+				g_system->getEventManager()->pushEvent(e);
+				e.type = Common::EVENT_LBUTTONUP;
+				g_system->getEventManager()->pushEvent(e);
+				debug("sonde : click %d %d", x, y);
+			} else if (l.hasPrefix("lingo ")) {
+				// Sonde : exécute du Lingo (ex. « lingo put gL », « lingo go(1, "s05a_map") »)
+				debug("sonde : %s", l.c_str());
+				// the game's globals, then the command (« ; » separates lines)
+				Common::String code = "global gL, gSp, g, gTurningPage, gNewWindow, gTurnPageParams, gDebug, gPostCheats\n" + l.substr(6);
+				for (uint k = 0; k < code.size(); k++)
+					if (code[k] == ';')
+						code.setChar('\n', k);
+				g_debugger->lingoEval(code.c_str());
+			} else if (sscanf(l.c_str(), "hit %d %d", &x, &y) == 2) {
+				// Sonde : sprite qui recevrait un clic à cet endroit
+				Score *score = getCurrentMovie() ? getCurrentMovie()->getScore() : nullptr;
+				if (score) {
+					debug("sonde : hit %d %d -> sprite %d (actif %d, survol %d)", x, y, score->getMouseSpriteIDFromPos(Common::Point(x, y)), score->getActiveSpriteIDFromPos(Common::Point(x, y)), score->getRolloverSpriteIDFromPos(Common::Point(x, y)));
+					for (uint k = 1; k < score->_channels.size(); k++) {
+						Channel *ch = score->_channels[k];
+						if (k >= 14 && k <= 17) {
+							Common::Rect bb = ch->getBbox();
+							debug("sonde :   hook #%d bbox %d,%d,%d,%d visible %d", k, bb.left, bb.top, bb.right, bb.bottom, (int)ch->_visible);
+						}
+						if (k >= 200 && ch->_sprite && ch->_sprite->_castId.member != 0) {
+							Common::Rect bb = ch->getBbox();
+							if (ABS(bb.left - x) < 200 && ABS(bb.top - y) < 200)
+								debug("sonde :   haut #%d bbox %d,%d,%d,%d vis %d test %d souris %d inst %d", k, bb.left, bb.top, bb.right, bb.bottom, (int)ch->_visible, (int)ch->isMouseIn(Common::Point(x, y)), (int)ch->_sprite->respondsToMouse(), ch->_scriptInstanceList.size());
+						}
+						if (ch->_sprite && ch->getBbox().contains(x, y))
+							debug("sonde :   #%d dedans=%d souris=%d comportements=%d", k, (int)ch->isMouseIn(Common::Point(x, y)), (int)ch->_sprite->respondsToMouse(), ch->_sprite->_behaviors.size());
+					}
+				}
+			} else if (l.hasPrefix("dumpwidget ")) {
+				// Sonde : surface réellement dessinée par une piste (après conversion de palette / mise à l'échelle)
+				int chan = 0;
+				char path[512] = {0};
+				if (sscanf(l.c_str(), "dumpwidget %d %511s", &chan, path) == 2) {
+					Score *score = getCurrentMovie() ? getCurrentMovie()->getScore() : nullptr;
+					Channel *ch = score ? score->getChannelById(chan) : nullptr;
+					Graphics::ManagedSurface *ws = ch ? ch->sondeSurface() : nullptr;
+					Common::DumpFile f;
+					if (ws && f.open(Common::Path(path))) {
+						byte pal[768];
+						if (ws->format.bytesPerPixel == 1)
+							g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+						Image::writePNG(f, ws->rawSurface(), ws->format.bytesPerPixel == 1 ? pal : nullptr);
+						debug("sonde : dumpwidget %d %dx%d bpp %d", chan, ws->w, ws->h, ws->format.bytesPerPixel);
+					}
+				}
+			} else if (l.hasPrefix("dumpsprite ")) {
+				// Sonde : image du membre d'une piste en PNG (« dumpsprite 23 /chemin/fichier.png »)
+				int chan = 0;
+				char path[512] = {0};
+				if (sscanf(l.c_str(), "dumpsprite %d %511s", &chan, path) == 2) {
+					Score *score = getCurrentMovie() ? getCurrentMovie()->getScore() : nullptr;
+					Channel *ch = score ? score->getChannelById(chan) : nullptr;
+					if (sondeDumpChannel(ch, path))
+						debug("sonde : dumpsprite %d -> %s", chan, path);
+				}
+			} else if (l.hasPrefix("dumptabs ")) {
+				// Sonde : images des marque-pages publiés (dumptabs DOSSIER → DOSSIER/tab_<page>.png)
+				Common::String dir = l.substr(9);
+				Score *score = getCurrentMovie() ? getCurrentMovie()->getScore() : nullptr;
+				for (uint k = 0; score && k < _sondeTabChannels.size(); k++) {
+					Channel *ch = score->getChannelById(_sondeTabChannels[k]);
+					if (!ch)
+						continue;
+					for (auto &inst : ch->_scriptInstanceList) {
+						if (inst.type != OBJECT || !inst.u.obj->hasProp("pTargetName"))
+							continue;
+						Common::String path = Common::String::format("%s/tab_%s.png", dir.c_str(), inst.u.obj->getProp("pTargetName").asString().c_str());
+						if (sondeDumpChannel(ch, path))
+							debug("sonde : dumptabs %s", path.c_str());
+						break;
+					}
+				}
+			} else if (l.hasPrefix("snap ")) {
+				snapName = l.substr(5);
+			} else if (l.hasPrefix("type ") || l.hasPrefix("key ")) {
+				// Sonde : frappe au clavier (« type Ernest », « key return|backspace|up|down|left|right|escape »)
+				Common::Array<Common::KeyState> keys;
+				if (l.hasPrefix("type ")) {
+					Common::String t = l.substr(5);
+					for (uint k = 0; k < t.size(); k++)
+						keys.push_back(Common::KeyState((Common::KeyCode)(byte)tolower(t[k]), (byte)t[k]));
+				} else {
+					Common::String n = l.substr(4);
+					Common::KeyCode kc = Common::KEYCODE_INVALID;
+					uint16 ascii = 0;
+					if (n == "return") { kc = Common::KEYCODE_RETURN; ascii = 13; }
+					else if (n == "backspace") { kc = Common::KEYCODE_BACKSPACE; ascii = 8; }
+					else if (n == "escape") { kc = Common::KEYCODE_ESCAPE; ascii = 27; }
+					else if (n == "up") kc = Common::KEYCODE_UP;
+					else if (n == "down") kc = Common::KEYCODE_DOWN;
+					else if (n == "left") kc = Common::KEYCODE_LEFT;
+					else if (n == "right") kc = Common::KEYCODE_RIGHT;
+					else if (n == "space") { kc = Common::KEYCODE_SPACE; ascii = 32; }
+					if (kc != Common::KEYCODE_INVALID)
+						keys.push_back(Common::KeyState(kc, ascii));
+				}
+				for (auto &ks : keys)
+					pendingKeys.push_back(ks);
+				debug("sonde : %s", l.c_str());
+			} else if (l.hasPrefix("sprites")) {
+				// Sonde : liste des sprites visibles (piste, membre, type, encre, rectangle)
+				Score *score = getCurrentMovie() ? getCurrentMovie()->getScore() : nullptr;
+				if (score) {
+					debug("sonde : sprites de %s, image %d", getCurrentMovie()->getMacName().c_str(), score->getCurrentFrameNum());
+					for (uint i = 1; i < score->_channels.size(); i++) {
+						Channel *ch = score->_channels[i];
+						if (!ch || !ch->_sprite || ch->_sprite->_castId.member == 0)
+							continue;
+						Sprite *sp = ch->_sprite;
+						Common::Rect r = ch->getBbox();
+						CastMember *cm = sp->_cast;
+						Common::String beh;
+						for (auto &b : sp->_behaviors)
+							beh += " " + b.memberID.asString();
+						debug("sonde :  #%d %s type=%s ink=%d vis=%d [%d,%d,%d,%d] fr=%d-%d inst=%d beh:%s", i, sp->_castId.asString().c_str(),
+							cm ? castType2str(cm->_type) : "?", sp->_ink, ch->_visible, r.left, r.top, r.right, r.bottom,
+							ch->_startFrame, ch->_endFrame, ch->_scriptInstanceList.size(), beh.c_str());
+					}
+				}
+			}
+		}
+		cmdPos = c.pos();
+	}
+}
