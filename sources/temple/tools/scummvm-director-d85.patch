+namespace Director {
+
+AlphaManiaCastMember::AlphaManiaCastMember(Cast *cast, uint16 castId, XtraCastMember &source)
+		: BitmapCastMember(cast, castId) {
+	const Common::Array<byte> &data = source.getXtraData();
+	if (data.size() >= 20) {
+		_xtraRegX = READ_BE_INT32(&data[12]);
+		_xtraRegY = READ_BE_INT32(&data[16]);
+	}
+	_hasAlpha = true;
+	_loaded = false;
+}
+
+CastMember *AlphaManiaCastMember::createCastMember(Cast *cast, uint16 castId, XtraCastMember *xtra) {
+	return new AlphaManiaCastMember(cast, castId, *xtra);
+}
+
+void AlphaManiaCastMember::load() {
+	if (_loaded)
+		return;
+	_loaded = true;
+
+	for (auto &it : _children) {
+		if (it.tag != MKTAG('X', 'M', 'E', 'D') || !_cast->getArchive()->hasResource(it.tag, it.index))
+			continue;
+		Common::SeekableReadStreamEndian *r = _cast->getArchive()->getResource(it.tag, it.index);
+		Common::Array<byte> d(r->size());
+		r->read(d.data(), r->size());
+		delete r;
+		if (d.size() < 40 || READ_BE_UINT32(&d[0]) != 1)
+			break;
+
+		uint32 bpp = READ_BE_UINT32(&d[12]);
+		int w = READ_BE_UINT32(&d[32]);
+		int h = READ_BE_UINT32(&d[36]);
+		if (bpp < 1 || bpp > 4 || w <= 0 || h <= 0 || w > 4096 || h > 4096) {
+			warning("AlphaManiaCastMember::load(): unsupported image (bpp %d, %dx%d) for member %d", bpp, w, h, _castId);
+			break;
+		}
+
+		// bpp planes (R, G, B, A or a single one): uint32 byte length, then (uint16 count, uint8 value) runs
+		Common::Array<byte> planes[4];
+		uint32 pos = 40;
+		for (int p = 0; p < (int)bpp; p++) {
+			if (pos + 4 > d.size())
+				break;
+			uint32 len = READ_BE_UINT32(&d[pos]);
+			pos += 4;
+			uint32 end = MIN<uint32>(pos + len, d.size());
+			while (pos + 3 <= end && planes[p].size() < (uint)(w * h)) {
+				uint16 count = READ_BE_UINT16(&d[pos]);
+				byte value = d[pos + 2];
+				pos += 3;
+				for (uint16 k = 0; k < count && planes[p].size() < (uint)(w * h); k++)
+					planes[p].push_back(value);
+			}
+			pos = end;
+			while (planes[p].size() < (uint)(w * h))
+				planes[p].push_back(0);
+		}
+
+		delete _picture;
+		_picture = new Picture();
+		const Graphics::PixelFormat fmt(4, 8, 8, 8, 8, 24, 16, 8, 0);
+		_picture->_surface.create(w, h, fmt);
+		for (int y = 0; y < h; y++)
+			for (int x = 0; x < w; x++) {
+				int i = y * w + x;
+				if (bpp == 4)
+					_picture->_surface.setPixel(x, y, fmt.ARGBToColor(planes[3][i], planes[0][i], planes[1][i], planes[2][i]));
+				else if (bpp == 3)
+					_picture->_surface.setPixel(x, y, fmt.ARGBToColor(255, planes[0][i], planes[1][i], planes[2][i]));
+				else	// single plane (water surfaces of the ripple effect, s08c): only a height map, the sprite itself is see-through
+					_picture->_surface.setPixel(x, y, fmt.ARGBToColor(0, planes[0][i], planes[0][i], planes[0][i]));
+			}
+		_bitsPerPixel = 32;
+		_effectSurface = (bpp == 1);
+		_initialRect = Common::Rect(w, h);
+		_regX = (_xtraRegX >= 0 && _xtraRegX <= w) ? _xtraRegX : w / 2;
+		_regY = (_xtraRegY >= 0 && _xtraRegY <= h) ? _xtraRegY : h / 2;
+		debugC(3, kDebugLoading, "AlphaManiaCastMember::load(): member %d, %dx%d", _castId, w, h);
+		break;
+	}
+	if (!_picture) {
+		_picture = new Picture();
+		_picture->_surface.create(1, 1, Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0));
+		_picture->_surface.setPixel(0, 0, 0);
+	}
+}
+
+} // End of namespace Director
