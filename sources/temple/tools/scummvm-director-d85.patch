+// inverse bilinear mapping (corners A=(0,0), B=(1,0), C=(1,1), D=(0,1)) of point (px, py) → (u, v)
+bool Window::quadInverse(const double *q, double px, double py, double &u, double &v) {
+	const double ax = q[0], ay = q[1], bx = q[2], by = q[3], cx = q[4], cy = q[5], dx = q[6], dy = q[7];
+	const double ex = bx - ax, ey = by - ay, fx = dx - ax, fy = dy - ay;
+	const double gx = ax - bx + cx - dx, gy = ay - by + cy - dy;
+	const double hx = px - ax, hy = py - ay;
+	auto cross = [](double x1, double y1, double x2, double y2) { return x1 * y2 - y1 * x2; };
+	const double k2 = cross(gx, gy, fx, fy);
+	const double k1 = cross(ex, ey, fx, fy) + cross(hx, hy, gx, gy);
+	const double k0 = cross(hx, hy, ex, ey);
+	if (fabs(k2) < 1e-9) {
+		if (fabs(k1) < 1e-12)
+			return false;
+		v = -k0 / k1;
+	} else {
+		double w = k1 * k1 - 4.0 * k0 * k2;
+		if (w < 0)
+			return false;
+		w = sqrt(w);
+		v = (-k1 - w) / (2.0 * k2);
+		if (v < -1e-6 || v > 1 + 1e-6)
+			v = (-k1 + w) / (2.0 * k2);
+	}
+	if (v < -1e-6 || v > 1 + 1e-6)
+		return false;
+	const double denx = ex + gx * v, deny = ey + gy * v;
+	if (fabs(denx) > fabs(deny))
+		u = (hx - fx * v) / denx;
+	else if (fabs(deny) > 1e-12)
+		u = (hy - fy * v) / deny;
+	else
+		return false;
+	return u >= -1e-6 && u <= 1 + 1e-6;
+}
+
+// sprite.hsb(): forced hue (0-360), saturation and brightness (0-255), keeping the pixel's own lightness when the
+// brightness is not forced
+static void applyHsb(Sprite *sp, uint8 &r, uint8 &g, uint8 &b) {
+	double rf = r / 255.0, gf = g / 255.0, bf = b / 255.0;
+	double mx = MAX(rf, MAX(gf, bf)), mn = MIN(rf, MIN(gf, bf)), d = mx - mn;
+	double h = 0, s = mx > 0 ? d / mx : 0, v = mx;
+	if (d > 0) {
+		if (mx == rf)
+			h = 60 * fmod((gf - bf) / d, 6.0);
+		else if (mx == gf)
+			h = 60 * ((bf - rf) / d + 2);
+		else
+			h = 60 * ((rf - gf) / d + 4);
+		if (h < 0)
+			h += 360;
+	}
+	if (sp->_hsbHue >= 0)
+		h = fmod((double)sp->_hsbHue, 360.0);
+	if (sp->_hsbSat >= 0)
+		s = CLIP(sp->_hsbSat, 0, 255) / 255.0;
+	if (sp->_hsbBright >= 0)
+		v = v * CLIP(sp->_hsbBright, 0, 255) / 255.0;
+	double c = v * s, x = c * (1 - fabs(fmod(h / 60.0, 2) - 1)), m = v - c;
+	double r1 = 0, g1 = 0, b1 = 0;
+	if (h < 60) { r1 = c; g1 = x; } else if (h < 120) { r1 = x; g1 = c; } else if (h < 180) { g1 = c; b1 = x; }
+	else if (h < 240) { g1 = x; b1 = c; } else if (h < 300) { r1 = x; b1 = c; } else { r1 = c; b1 = x; }
+	r = (uint8)CLIP((r1 + m) * 255.0 + 0.5, 0.0, 255.0);
+	g = (uint8)CLIP((g1 + m) * 255.0 + 0.5, 0.0, 255.0);
+	b = (uint8)CLIP((b1 + m) * 255.0 + 0.5, 0.0, 255.0);
+}
